#!/bin/sh
# Route-doc drift guard (AGENTS.md route-doc convention v3) — SECOND-door enforcement. The PRIMARY
# defense is running tests/test_route_doc_ledger_status_consistency.py before 提交/审查; this hook just
# re-runs it at commit time so a drifted docs/CURRENT.md cannot be committed silently.
#
# Enable (per clone, once): git config core.hooksPath .githooks
# Emergency bypass requires explicit user approval (project policy): git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Codex commits must run the same dependency-complete host Python as formal
# project commands. Do not discover or fall back to PATH, bundled, or another
# user's interpreter: a missing pin blocks the commit rather than testing in a
# different environment.
PINNED_STOCK_PY="/c/Users/cnhea/AppData/Local/Programs/Python/Python313/python.exe"
if [ ! -x "$PINNED_STOCK_PY" ]; then
  echo "pre-commit BLOCKED: pinned Stock Python was not found: $PINNED_STOCK_PY" 1>&2
  exit 1
fi
PY="$PINNED_STOCK_PY"

"$PY" -m unittest tests.test_route_doc_ledger_status_consistency 1>&2
if [ "$?" -ne 0 ]; then
  echo "" 1>&2
  echo "pre-commit BLOCKED: route-doc drift guard FAILED." 1>&2
  echo "Move live review/commit-cycle gate state (待审查 / before commit / routed-to / 谁审 / 谁提交 / 谁执行 / next-command)" 1>&2
  echo "to docs/SESSION_LOG.md top; keep docs/CURRENT.md to SETTLED facts only. Fix, then re-commit." 1>&2
  exit 1
fi

"$PY" -m unittest tests.test_doc_governance_guard 1>&2
if [ "$?" -ne 0 ]; then
  echo "" 1>&2
  echo "pre-commit BLOCKED: doc-governance guard FAILED (likely the review-cycle minimal template)." 1>&2
  echo "Newest SESSION_LOG review entry above REVIEW-CYCLE-MINIMAL-TEMPLATE-MARKER must use ONLY labels" 1>&2
  echo "{Verdict/Action, Required, Verify, Next} (+Proof-of-use for 修复); each bullet <=500 chars; cite the" 1>&2
  echo "register (no double-write of finding detail). Move detail to system_risk_register.md, then re-commit." 1>&2
  exit 1
fi

# ── Verification-tiering reminder (advisory, NEVER blocks) — AGENTS.md §Verification tiering rule 3/4 ──
# If this commit changes the a-short PRODUCTION surface but no full-pack GREEN is recorded for this
# exact code state, print a reminder so the reviewer runs the pack ONCE at the PASS/merge gate and
# cites the ledger instead of re-running mid-review. It NEVER blocks: the ledger is per-worktree and
# advisory (fingerprint = diff-from-HEAD), so a real hard gate would need a tracked, commit-keyed
# ledger — a separate slice. This branch only warns to stderr; it never blocks the commit.
# Every staged non-document change must have a current bounded focused receipt.
# This is the small hard gate; the rule-3 full lane below remains conditional.
code_changed="$(git diff --cached --name-only | grep -vE '^(docs/|.*\\.md$)' || true)"
if [ -n "$code_changed" ]; then
  "$PY" .tools/verification_receipt.py 1>&2
  if [ "$?" -ne 0 ]; then
    echo "" 1>&2
    echo "pre-commit BLOCKED: no current bounded focused acceptance receipt for staged code." 1>&2
    echo "Run .tools\\run_unittest_with_repo_pythonpath.cmd with the focused acceptance pack, then retry." 1>&2
    exit 1
  fi
fi

if [ -n "$PY" ]; then
  prod_changed="$(git diff --cached --name-only | grep -E '^(A-EGS/|runners/a_short_|engine/a_short_|engine/egs_|schemas/a_short_|presets/a_short_|presets/egs_)' || true)"
  if [ -n "$prod_changed" ] && ! "$PY" .tools/full_pack_ledger.py check a_short >/dev/null 2>&1; then
    echo "" 1>&2
    echo "pre-commit REMINDER (advisory, does NOT block): this commit changes a-short production code but no" 1>&2
    echo "full-pack GREEN is recorded for this code state (AGENTS.md §Verification tiering rule 3/4)." 1>&2
    echo "At the PASS/merge gate run the a_short full pack ONCE with the atomic ledger command" 1>&2
    echo "(it prepares, bounds, verifies and records in one step; manual prepare/record is retired):" 1>&2
    echo "  C:\\Users\\cnhea\\AppData\\Local\\Programs\\Python\\Python313\\python.exe .tools\\full_pack_ledger.py run a_short \"<trigger>\" \"receipt:<receipt-id>\" 1200 -- <unittest args>" 1>&2
    echo "The focused receipt is produced by .tools\\run_unittest_with_repo_pythonpath.cmd and is bound to this exact code state." 1>&2
    echo "(If focused tests bound the impact per rule 6, ignore this.)" 1>&2
  fi
fi
exit 0
