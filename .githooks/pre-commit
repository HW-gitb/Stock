#!/bin/sh
# Route-doc drift guard (AGENTS.md route-doc convention v3) — SECOND-door enforcement. The PRIMARY
# defense is running tests/test_route_doc_ledger_status_consistency.py before 提交/审查; this hook just
# re-runs it at commit time so a drifted docs/CURRENT.md cannot be committed silently.
#
# Enable (per clone, once): git config core.hooksPath .githooks
# Emergency bypass requires explicit user approval (project policy): git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Git's hook shell on Windows runs with a MINIMAL PATH that usually lacks the user's Python, so PATH
# lookup alone is unreliable (it would block every commit). Discover a real interpreter: PATH first,
# then known Windows install locations resolved via LOCALAPPDATA / USERPROFILE (Git preserves these).
find_python() {
  for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1; then printf '%s' "$c"; return 0; fi
  done
  # Git's hook shell has a minimal PATH and its env vars may not point at the real profile, AND Claude
  # vs Codex run with DIFFERENT interpreters (Claude: AppData\Local\Programs\Python\Python*; Codex:
  # .cache\codex-runtimes\*\dependencies\python). Search BOTH, across all user profiles (single-user
  # local repo) plus env-var bases, so the guard actually runs in either environment.
  for exe in \
    /c/Users/*/.cache/codex-runtimes/*/dependencies/python/python.exe \
    /c/Users/*/AppData/Local/Programs/Python/Python*/python.exe \
    "$HOME"/.cache/codex-runtimes/*/dependencies/python/python.exe \
    "$HOME"/AppData/Local/Programs/Python/Python*/python.exe \
    "$LOCALAPPDATA"/Programs/Python/Python*/python.exe \
    "$USERPROFILE"/AppData/Local/Programs/Python/Python*/python.exe ; do
    [ -x "$exe" ] && { printf '%s' "$exe"; return 0; }
  done
  return 1
}

PY="$(find_python)"
if [ -z "$PY" ]; then
  # Fail OPEN (do not brick commits) but loudly — the tracked test is the primary defense.
  echo "pre-commit WARNING: no Python found on PATH or in known Windows locations; route-doc guard NOT run." 1>&2
  echo "Run 'python -m unittest tests.test_route_doc_ledger_status_consistency' manually before committing." 1>&2
  exit 0
fi

"$PY" -m unittest tests.test_route_doc_ledger_status_consistency 1>&2
if [ "$?" -ne 0 ]; then
  echo "" 1>&2
  echo "pre-commit BLOCKED: route-doc drift guard FAILED." 1>&2
  echo "Move live review/commit-cycle gate state (待审查 / before commit / routed-to / 谁审 / 谁提交 / 谁执行 / next-command)" 1>&2
  echo "to docs/SESSION_LOG.md top; keep docs/CURRENT.md to SETTLED facts only. Fix, then re-commit." 1>&2
  exit 1
fi

"$PY" -m unittest tests.test_doc_governance_guard 1>&2
if [ "$?" -ne 0 ]; then
  echo "" 1>&2
  echo "pre-commit BLOCKED: doc-governance guard FAILED (likely the review-cycle minimal template)." 1>&2
  echo "Newest SESSION_LOG review entry above REVIEW-CYCLE-MINIMAL-TEMPLATE-MARKER must use ONLY labels" 1>&2
  echo "{Verdict/Action, Required, Verify, Next} (+Proof-of-use for 修复); each bullet <=500 chars; cite the" 1>&2
  echo "register (no double-write of finding detail). Move detail to system_risk_register.md, then re-commit." 1>&2
  exit 1
fi
exit 0
