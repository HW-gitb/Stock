{
  "artifact_id": "us_short_seam_theme_binding_20260702",
  "schema_version": "1.0.0",
  "owner": "US-short batch5 Cut 6-b theme/industry scoring seam",
  "design_authority": "docs/us_short_system_design.md section 4.2 and 4.3",
  "producer_refs": [
    "engine/us_short_industry_heat.py::industry_heat_block",
    "engine/us_short_provisional_theme_heat.py::provisional_theme_heat_block"
  ],
  "consumer_ref": "batch4 score composer -> score_blocks['theme'] -> engine/us_short_core_score.py",
  "identity_policy": "engine/us_short_eligibility_gate.py::canonical_us_ticker; one canonical identity per stock; plain str only",
  "projection_basis_policy": "full_producer_membership_pool_then_target_projection",
  "input_contract": {
    "industry_result_required_keys": [
      "industry_heat_by_ticker",
      "sector_heat",
      "sector_metrics",
      "insufficient_sectors",
      "min_sector_members"
    ],
    "provisional_theme_result_required_keys": [
      "theme_heat",
      "confirm_flags",
      "theme_metrics",
      "insufficient_themes",
      "min_theme_members"
    ],
    "confirm_flag_keys": [
      "theme_breadth_up_frac",
      "theme_volume_confirm_frac",
      "theme_leader_rs",
      "theme_member_count"
    ],
    "theme_membership_policy": "one_primary_theme_per_ticker_fail_closed",
    "numeric_value_policy": "exact_builtin_int_or_float_only",
    "block_value_domain": [0.0, 100.0]
  },
  "output_contract": {
    "required_keys": [
      "theme_block_by_ticker",
      "neutral_fill_tickers",
      "coverage",
      "target_count",
      "scored_count"
    ],
    "coverage_dispositions": [
      "scored_theme_base",
      "scored_industry_base",
      "neutral_insufficient_theme_no_industry",
      "neutral_missing_theme_and_industry_base"
    ],
    "neutral_fill_note": "Targets with no usable theme or industry base are omitted from theme_block_by_ticker and listed in neutral_fill_tickers so the composer can apply the core_score neutral-block rule."
  },
  "authorization_boundary": {
    "provider_call": false,
    "live_data": false,
    "datahub_write": false,
    "production_runner": false,
    "broker_or_order_execution": false
  }
}
