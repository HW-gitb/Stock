# ============================================================
# .gitignore - private repo safety boundary
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.pytest_cache/
.mypy_cache/

# --- Sensitive (defensive: tokens should only live in env) ---
.env
.env.*
*.token
credentials*
*.key
*.pem
secrets*

# --- Generated screening outputs / spreadsheets ---
A-EGS/Result/
A-EGS/*.xlsx

# --- Generated analysis and backtest outputs ---
result/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
result/*/backtest/*.csv
result/*/backtest/*.json
result/*/backtest/*.xlsx
result/*/backtest/execution/
result/*/backtest/generated/
result/*/backtest/snapshot_seed/
result/*/backtest/variants/
result/*/backtest/**/_intermediate/

# --- Local live state ---
state/*/*.json
state/*/*.csv

# --- Large API caches (regenerable from Tushare) ---
# Tushare daily/financial/concept caches (~860MB)
A-EGS/Result/egs_cache/

# Forward daily price cache for backtest (~120MB)
result/*/backtest/cache/

# Local provider sample payloads (raw vendor/public API rows; summaries may be tracked separately)
provider_samples/

# --- L3 snapshots (regenerable, grows over time) ---
state/*/l3_snapshots/
state/l3_snapshots/

# --- Logs (regenerable + can grow large) ---
*.log
logs/

# --- Temp / backup ---
*.tmp
*.bak
*~
backup_*.zip

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code local state (per-project; private) ---
.claude/

# Human-written result notes and docs remain trackable.
