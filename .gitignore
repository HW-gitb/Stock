# ============================================================
# .gitignore - private repo safety boundary
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
# Exception: the vendored rpds native module completes the tracked .tools/python_libs
# jsonschema/rpds bundle so schema tests import in a FRESH `git worktree` (which does not
# copy gitignored files). Without these, every new worktree fails `import rpds.rpds`.
!.tools/python_libs/rpds/rpds.cp312-win_amd64.pyd
!.tools/python_libs/rpds/rpds.cp313-win_amd64.pyd
*$py.class
.pytest_cache/
.mypy_cache/

# --- Sensitive (defensive: tokens should only live in env) ---
.env
.env.*
*.token
credentials*
*.key
*.pem
secrets*

# --- Generated screening outputs / spreadsheets ---
A-EGS/Result/
A-EGS/*.xlsx

# --- Generated analysis and backtest outputs ---
result/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
result/*/backtest/*.csv
result/*/backtest/*.json
result/*/backtest/*.xlsx
result/*/backtest/execution/
result/*/backtest/generated/
result/*/backtest/snapshot_seed/
result/*/backtest/variants/
result/*/backtest/**/_intermediate/

# --- Local live state ---
state/*/*.json
state/*/*.csv
state/*/sec_sic_classification_snapshots/
# 4.3 manual position tables: the user's REAL holdings/trades — never commit (private financial data).
# Committed reference templates live under schemas/examples/a_short_account_state_csv/.
state/*/account_state_csv/
# 持仓恒列入隐私护栏(固化):带 --account 的周报含真实持仓(代码/成本/止损)。固化方案 = 账户周报落
# state/<系统类型>/weekly_private/<as_of>/(a_short/a_long/us_short/us_long 同一 scheme)→ 全部 gitignored,绝不入库。
state/*/weekly_private/
# S3b R4b 跨周持久收紧 ratchet sidecar:含真实持仓(ts_code/entry_date/ratcheted_stop/prices)→ 私密,绝不入库(同 weekly_private scheme,git check-ignore 守门)。
state/*/holding_ratchet/
# US-short 设计私密输出路径(docs-only landing 2026-06-20,设计见 docs/us_short_system_design.md §11.6/§18):
#   runs_private = 机器层(全字段/原始分/decision_trace/registry)、model_paper_private = 纸面账(orders/positions/performance)、
#   lifecycle = lifecycle_register.json(含票名/表现计数)、shadow_compare_private = 比较轨 shadow 选股明细、
#   capstone_checkpoints_private = 一键续跑的 ticker 级中间产物 + digest manifest。
#   含真实持仓/选股/表现 → 私密,绝不入库(同 weekly_private scheme,a_short/a_long/us_short/us_long 同一 scheme,git check-ignore 守门);
#   tracked 只放脱敏汇总(无票名/无 $)。实现期 fail-closed 护栏测试 = P0 Required(§18.0)。
state/*/runs_private/
state/*/model_paper_private/
state/*/lifecycle/
state/*/shadow_compare_private/
state/*/factor_comparison_private/
state/*/industry_weight_comparison_private/
state/*/overlay_adjudication_private/
# Formal M6.7 recommendation captures may contain real holdings, sizing, prices, and cash usage.
# They are append-only private evidence, never tracked output.
state/*/operation_evidence_private/
state/*/capstone_checkpoints_private/

# --- A-short M6.7 weekly validation 执行 byproducts (one-off, research lane, regenerable via 执行) ---
research/results/a_short/m67_validation_*/

# --- A-short candidate-effect per-run health receipt (transient run state, not evidence) ---
# Rewritten by every weekly regime run and consumed by the launcher in that same run; the
# tracked evidence artifact is the sibling regime_candidate_effect_summary.{json,md}.
research/results/a_short/candidate_effect_outcome.json

# --- A-long value-yield forward-PAPER capture accumulator (research-only paper evidence; holds selected_symbols 选股明细) → private ---
research/results/a_long/value_yield_forward_paper/

# --- Large API caches (regenerable from Tushare) ---
# Tushare daily/financial/concept caches (~860MB)
A-EGS/Result/egs_cache/

# Forward daily price cache for backtest (~120MB)
result/*/backtest/cache/

# Local provider sample payloads (raw vendor/public API rows; summaries may be tracked separately)
provider_samples/

# A-long raw provider data and audit caches (future reviewed route only; summaries stay tracked)
data/a_long/raw/
data/a_long/audit_cache/

# --- L3 snapshots (regenerable, grows over time) ---
state/*/l3_snapshots/
state/l3_snapshots/

# --- Logs (regenerable + can grow large) ---
*.log
logs/

# --- Temp / backup ---
*.tmp
*.bak
*~
backup_*.zip

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code local state (per-project; private) ---
.claude/

# --- Local reviewer scratch probes ---
reviewer_probes/

# Human-written result notes and docs remain trackable.

# Local full-pack run ledger (tiering rule 4 cache); machine-local run state, not shared.
.tools/state/
