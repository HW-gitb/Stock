{
  "protocol": "us_short_ship_gate",
  "version": "1.0",
  "status": "proposed",
  "active": false,
  "clock_started": false,
  "frozen_at": null,
  "frozen_sha256": null,
  "human_readable": "docs/us_short_ship_gate_protocol_v1.0.md",
  "instantiates": ["docs/evidence_capital_policy.md", "docs/us_short_system_design.md#12", "docs/us_short_system_design.md#13"],
  "lane": "us_short",
  "side": "long_only",
  "append_only": true,

  "activation_preconditions": {
    "user_approval": false,
    "strategy_version_locked": false,
    "strategy_version_lock_requires": "balanced engine+weights frozen (0c94 theme-lifecycle merged-or-excluded + A1 forward-policy settled)",
    "pre_freeze_validations_passed": false,
    "freeze_recorded": false
  },

  "user_risk_fields": {
    "_note": "risk-preference decisions; set before activation; dollar amounts kept in a gitignored/local file, never committed",
    "target_capital_usd": null,
    "max_drawdown_tolerance_frac": 0.15,
    "max_drawdown_tolerance_confirmed": true,
    "min_economic_alpha_annual_frac": 0.05,
    "min_economic_alpha_confirmed": true
  },

  "evidence_framework": {
    "graduation_evidence_level": "live_normalized",
    "paper_can_graduate": false,
    "ledgers": ["strategy_measurement", "operator"],
    "intention_to_treat": true,
    "scaling_mode_enum": ["linear", "capped", "not_valid", "not_assessed"],
    "not_assessed_is_pass": false
  },

  "graduation_ladder": [
    {"rung": "minimal_measurement", "capital_frac": 0.0, "trigger": "day_1", "alpha_point_min": null, "hac_t_min": null, "factor_adjusted_alpha_min": null, "extra": {"coverage_min": 0.98, "monthly_compliance_min": 0.95}},
    {"rung": "quarter", "capital_frac": 0.25, "trigger": "months_ge_12 AND n_eff_ge_52", "alpha_point_min": 0.0, "hac_t_min": 1.0, "factor_adjusted_alpha_min": 0.0, "extra": {"lifetime_dd_within_tolerance": true, "cost_within_frozen_model": true, "scaling_mode_not": "not_valid"}},
    {"rung": "half", "capital_frac": 0.50, "trigger": "prev_plus_weeks_ge_8", "alpha_point_min": 0.025, "hac_t_min": 1.5, "factor_adjusted_alpha_min": 0.0, "extra": {"adverse_regime_required_or_cap_here": true}},
    {"rung": "three_quarter", "capital_frac": 0.75, "trigger": "prev_plus_weeks_ge_8", "alpha_point_min": 0.0375, "hac_t_min": 2.0, "factor_adjusted_alpha_min": 0.0, "extra": {"capacity_stress_exit_pass": true}},
    {"rung": "full", "capital_frac": 1.0, "trigger": "prev_plus_weeks_ge_8 (typically months 24-36)", "alpha_point_min": "user_risk_fields.min_economic_alpha_annual_frac", "hac_t_min": 2.0, "factor_adjusted_alpha_min": 0.0, "extra": {"deflated_sharpe_prob_true_gt_0p5_min": 0.95, "both_halves_alpha_positive": true, "cumulative_net_gt_vti_plus_cash": true, "capacity_full_validated": true, "adverse_regime_confirmed": true, "independent_recompute_matches": true}}
  ],

  "gates": {
    "economic_alpha": {
      "primary_benchmark": "target_exposure_matched_VTI_total_plus_3M_Tbill_cash",
      "exposure_basis": "rule_implied_target_not_operator_actual",
      "net_alpha_annual_min_full": "user_risk_fields.min_economic_alpha_annual_frac",
      "factor_adjusted_alpha_min_full": 0.0
    },
    "statistical": {
      "method": "weekly_HAC_Newey_West_one_sided",
      "bootstrap": "weekly_block",
      "block_len": "max(4, max_holding_weeks_H)",
      "t_min_full": 2.0,
      "p_max_full": 0.025,
      "formal_checks_months": [24, 36],
      "multiple_testing_bonferroni_div": 2
    },
    "sharpe": {
      "annualized_net_min": 1.0,
      "deflated_sharpe_prob_true_gt_0p5_min": 0.95,
      "deflated_trial_count_source": "count_of_balanced_configs_compared_in_research (see trial_log)"
    },
    "drawdown_environment": {
      "lifetime_max_dd_frac_max": "user_risk_fields.max_drawdown_tolerance_frac",
      "lifetime_non_resettable": true,
      "adverse_regime_benchmark_dd_min": 0.10,
      "cap_at_frac_until_adverse_regime": 0.50,
      "any_risk_limit_breach_blocks": true
    },
    "capacity": {
      "c_cap_formula": "min_over_i_t( 0.02 * MDV20 / w_i )",
      "c_star_le_frac_of_c_cap": 0.80,
      "per_trade_pct_mdv20_max": 0.02,
      "stress_exit_sessions": 2,
      "stress_exit_daily_pct_of_p10_volume_max": 0.05,
      "full_cost_rule": "max(observed_implementation_shortfall, sqrt_impact_model_95pct_upper_bound)",
      "participation_over_validated_max_multiple_not_valid": 4,
      "scaling_mode_thresholds": {"linear_max_pct_mdv20": 0.0010, "capped_max_pct_mdv20": 0.0050, "capped_max_pct_window_vol": 0.05, "capped_max_mult_validated": 2}
    }
  },

  "sample_minimums": {
    "min_calendar_months_full": 24,
    "min_valid_weekly_batches": 96,
    "min_closed_position_cycles": 300,
    "min_n_eff_week_equivalents": 52,
    "n_eff_formula": "n / (1 + 2*sum_{k=1..H} rho_k)",
    "max_holding_weeks_H": null,
    "max_holding_weeks_H_note": "PIN FROM DESIGN before freeze; sets bootstrap block length and n_eff correction"
  },

  "compliance": {
    "notional_coverage_min": 0.98,
    "weekly_dollar_compliance_min": 0.95,
    "weekly_count_compliance_min": 0.95,
    "allowed_exception_events": ["halt", "no_valid_quote", "regulatory_restriction"],
    "subjective_skip_allowed": false
  },

  "version_binding": {
    "restart_clock_on_change_to": ["weights_40_35_25", "data_fields_or_pit_semantics_or_sources", "universe_or_ranking_or_entry_or_exit_or_stop_or_target", "sizing_or_risk_rules", "manual_exception_rules", "any_fix_altering_historical_recommendation_price_or_position"],
    "inherit_evidence_only_if": ["ui_wording_report_format", "fix_proven_bit_for_bit_output_identical_by_replay", "storage_or_performance_identical_output"],
    "shadow_variants_never_count": ["theme_plus", "theme_aggressive", "theme_off", "catalyst_off", "overextension_selection_off"]
  },

  "pre_freeze_validations": {
    "computability_audit": {"required": true, "status": "pending"},
    "zero_alpha_calibration": {"required": true, "status": "pending", "false_graduation_to_full_max": 0.05, "scope_cap": "SMALL offline throwaway research script (order 1k-10k simple runs), NOT a production evaluator; do NOT build weekly HAC/deflated-Sharpe/n_eff pipelines or a ship-gate runner without proven need + explicit user approval (evaluation at the 24/36mo checks is by hand/small script). Expanding this scope needs user sign-off.", "n13_rigor": "freeze DGP+params+seeds before seeing results; require one-sided 95% binomial upper bound <= 0.05 (not raw pass rate); drop no seeds; null covers multiple alpha<=0 regimes", "null_method_pass2_N16": "prefer real-history permutation/placebo (each week draw 15 from the real eligible universe with matched industry/mktcap/momentum exposure) over a self-tuned parametric DGP -> real correlation/skew/regime preserved, selection alpha structurally zeroed; report worst-case over a hypothesis grid; include a cheating-operator strategy (hindsight skips, version restarts, pick-the-favorable-check, timed rung upgrades) and publish P(graduate | cheating operator)", "harmonize_with": "A1 forward Cut D pre-registration/placebo infra (do not build a parallel system)", "deferred_until": "strategy_version_locked_and_approaching_real_money"},
    "power_analysis": {"required": true, "status": "pending", "true_alpha_scenarios": [0.03, 0.06, 0.09]},
    "red_team_and_independent_recompute": {"required": true, "status": "pending", "first_pass_self_done": true, "first_pass_record": "docs/us_short_ship_gate_redteam_v1.0.md", "first_pass_holes_closed": 8, "independent_pass_still_required": true, "note": "author self-red-team is a first pass only; a different LLM/person must red-team before freeze (author has blind spots)"}
  },

  "to_pin_before_freeze": {
    "_note": "surfaced by the v1.0 red-team; must carry exact values before status=active",
    "factor_model": {"set": "FamaFrench5_plus_momentum", "source": "Kenneth_French_Data_Library", "frequency": null, "construction": null, "_hole": "C"},
    "zero_pick_week_handling": {"counts_as": "valid_observation_cash_or_benchmark_not_skipped", "confirmed": false, "_hole": "I"},
    "max_holding_weeks_H": null,
    "rung_check_calendar": {"fixed_dates_all_rungs": null, "_hole": "N5"},
    "benchmark_selection": {"predominantly_small_cap_numeric_threshold": null, "require_both_vti_and_size_sector_matched": true, "selection_alpha_floor_vs_matched_benchmark": true, "_hole": "N8"},
    "n_eff_clamp": {"min": 1, "max": "n", "nonneg_longrun_variance_estimator": true, "_hole": "N11"},
    "stat_definitions": {"alpha_annualization": null, "hac_lag_rule": null, "bootstrap_type_and_seeds": null, "dsr_version_and_inputs": null, "both_halves_split": null, "rounding_uses_unrounded_for_decisions": true, "_hole": "N12-defs"},
    "frozen_rule_annex_s14": {"required": true, "covers": ["cancel_chase_rule", "noncompliant_week_return=actual_account_return_or_cash", "risk_limits", "cost_model_coefficients", "recompute_tolerance", "uniform_size_usd", "entry_execution_window_and_price", "corporate_actions_delist_bankruptcy_merger_tender", "deposit_withdrawal_twr"], "_hole": "pass2-N11"},
    "weekly_recommendation_precommit": {"commit_packet_to_git_before_us_open": true, "packet_includes": ["names", "prices", "weights", "code_sha", "input_data_hash"], "external_timestamp": "optional_opentimestamps", "unstamped_week": "non_compliant_not_absent", "_hole": "pass2-N3"},
    "execution_convention": {"window_et": null, "strategy_ledger_uses": "archived_tape_convention_price_not_operator_fill", "force_oco_bracket_orders": true, "_hole": "pass2-N12"},
    "sixth_gate_cumulative_net_ge_vti_total": {"required_for_full": true, "_hole": "pass2-N19"},
    "family_version_ledger": {"append_only": true, "lifetime_dd_and_trial_count_are_family_level": true, "nonsafety_restart_cap": 2, "restarts_outcome_blind_and_counted": true, "_hole": "pass2-N2"}
  },

  "outcomes": {"values": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE"], "insufficient_is_pass": false},

  "trial_log": {
    "_note": "every balanced config compared on any data during research, incl. failed ones; feeds Deflated-Sharpe trial count",
    "balanced_configs_compared": []
  }
}
