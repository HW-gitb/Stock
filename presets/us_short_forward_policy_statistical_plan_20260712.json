{
  "schema_name": "us_short_forward_policy_statistical_plan",
  "schema_version": "1.0.0",
  "as_of": "20260712",
  "status": "preregistered_before_first_authorized_live_capture",
  "policy_scope": {
    "primary_policy": "balanced",
    "selection_policies": [
      "balanced",
      "theme_plus",
      "theme_aggressive",
      "theme_off",
      "catalyst_off",
      "overextension_selection_off"
    ],
    "excluded_second_wave_policy": "overextension_execution_off",
    "sizing_neutral_in_scope": false
  },
  "weekly_manifest": {
    "recording_mode": "same_run_live_capture_only",
    "capture_binding_fields": [
      "decision_date",
      "price_basis_date",
      "source_context_sha256",
      "capture_sha256"
    ],
    "unit_of_independence": "decision_week",
    "dedupe_key": "decision_date_and_policy",
    "historical_replay_counts_as_forward": false,
    "backfill_allowed": false
  },
  "statistics": {
    "primary_metric": "net_benchmark_excess",
    "primary_delta": "policy_minus_balanced",
    "selection_divergence": {
      "selection_count": 15,
      "membership_symmetric_difference_at_least": 1,
      "rank_and_selection_bucket_diagnostics_are_secondary": true,
      "action_and_size_outcomes_available": false
    },
    "minimum_forward_weeks_before_promotion_review": 12,
    "comparison_win_margin": 0.001,
    "comparison_margin_unit": "net_return_fraction",
    "placebo": {
      "replicates": 1000,
      "seed_start": 0,
      "seed_end_inclusive": 999,
      "match_frequency": "data_bound_to_each_head_weekly_divergence_count",
      "method": "balanced_top15_same_pool_random_in_out_swaps"
    },
    "paired_basis": "same_decision_week_policy_minus_balanced",
    "elimination_rule": {
      "no_automatic_promotion": true,
      "early_action": "futility_or_harm_only",
      "outcome_blind_before_minimum": true,
      "futility": {
        "comparison": "lt",
        "minimum_divergence_weeks": 2,
        "within_first_decision_weeks": 8
      },
      "harm": {
        "combine": "or",
        "turnover": {
          "metric": "mean_weekly_top15_turnover",
          "comparison": "gt",
          "threshold_multiplier_vs_balanced": 2.0,
          "sustained_decision_weeks": 2
        },
        "fill": {
          "metric": "top15_fill_vs_balanced_seat_count",
          "comparison": "lt",
          "threshold_fraction": 0.5,
          "sustained_decision_weeks": 2
        }
      },
      "flag_effect": "surface_for_human_review_only",
      "promotion_gate": {
        "minimum_divergence_weeks": 12,
        "mean_paired_advantage_gte": 0.001,
        "paired_win_consistency_fraction": [
          2,
          3
        ],
        "placebo_percentile_exclusive_gt": 0.95
      }
    }
  },
  "boundary": {
    "shadow_only": true,
    "changes_primary_selection": false,
    "shadow_counts_ship_gate": false,
    "provider_calls_added": false,
    "broker_or_order_automation_allowed": false,
    "historical_replay_is_forward": false
  }
}
