{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock.local/schemas/us_short_seam_score_binding.schema.json",
  "title": "US-short Cut 6-d score composer seam binding",
  "type": "object",
  "required": [
    "artifact_id",
    "schema_version",
    "owner",
    "design_authority",
    "composer_ref",
    "component_projection_refs",
    "selection_inputs_consumer_ref",
    "analysis_consumer_ref",
    "identity_policy",
    "component_keys",
    "score_block_keys",
    "theme_momentum_policy",
    "theme_momentum_neutral_score",
    "input_contract",
    "output_contract",
    "authorization_boundary"
  ],
  "properties": {
    "artifact_id": { "const": "us_short_seam_score_binding_20260702" },
    "schema_version": { "const": "1.0.0" },
    "owner": { "const": "US-short batch5 Cut 6-d score composer seam" },
    "design_authority": { "const": "docs/us_short_system_design.md section 4.0, 4.2, and 4.5" },
    "composer_ref": { "const": "engine/us_short_seam_score.py::compose_score_inputs" },
    "component_projection_refs": {
      "const": [
        "engine/us_short_seam_momentum.py::project_momentum_block",
        "engine/us_short_seam_theme.py::project_theme_block",
        "engine/us_short_seam_catalyst.py::project_catalyst_block"
      ]
    },
    "selection_inputs_consumer_ref": { "const": "engine/us_short_weekend_pipeline.py::_select_top15" },
    "analysis_consumer_ref": { "const": "engine/us_short_weekend_analysis.py::analyze_rows" },
    "identity_policy": { "const": "engine/us_short_eligibility_gate.py::canonical_us_ticker; one canonical identity per stock; plain str only" },
    "component_keys": {
      "const": [
        "momentum",
        "theme",
        "catalyst"
      ]
    },
    "score_block_keys": {
      "const": [
        "momentum",
        "theme",
        "catalyst"
      ]
    },
    "theme_momentum_policy": {
      "const": "theme_momentum_score uses the scored theme block when present; neutral or missing theme evidence maps to 0.0 for theme seats while core_score still applies its neutral-block rule"
    },
    "theme_momentum_neutral_score": { "const": 0.0 },
    "input_contract": {
      "type": "object",
      "required": [
        "projection_required_keys",
        "component_value_maps",
        "projection_partition_policy",
        "risk_downgrade_policy",
        "numeric_value_policy",
        "block_value_domain"
      ],
      "properties": {
        "projection_required_keys": {
          "const": [
            "value_map",
            "neutral_fill_tickers",
            "coverage",
            "target_count",
            "scored_count"
          ]
        },
        "component_value_maps": {
          "const": {
            "momentum": "momentum_by_ticker",
            "theme": "theme_block_by_ticker",
            "catalyst": "catalyst_block_by_ticker"
          }
        },
        "projection_partition_policy": {
          "const": "For each component, scored value identities plus neutral_fill_tickers must exactly partition target_tickers; coverage must exactly cover target_tickers; target_count and scored_count must match."
        },
        "risk_downgrade_policy": {
          "const": "risk_downgrade_by_ticker must exactly cover target_tickers; every row must validate as engine.us_short_risk_downgrade.validate_risk_downgrade_input output; missing does not default to zero."
        },
        "numeric_value_policy": { "const": "exact_builtin_int_or_float_only" },
        "block_value_domain": { "const": [0.0, 100.0] }
      },
      "additionalProperties": false
    },
    "output_contract": {
      "type": "object",
      "required": [
        "required_keys",
        "selection_row_keys",
        "analysis_row_keys",
        "coverage_row_keys",
        "same_run_reconciliation"
      ],
      "properties": {
        "required_keys": {
          "const": [
            "selection_inputs",
            "analysis_by_ticker",
            "coverage_by_ticker",
            "target_tickers",
            "scoring_profile",
            "scored_component_counts"
          ]
        },
        "selection_row_keys": {
          "const": [
            "core_score",
            "theme_momentum_score"
          ]
        },
        "analysis_row_keys": {
          "const": [
            "score_blocks",
            "risk_downgrade",
            "scoring_profile"
          ]
        },
        "coverage_row_keys": {
          "const": [
            "momentum",
            "theme",
            "catalyst"
          ]
        },
        "same_run_reconciliation": {
          "const": "selection_inputs.per_ticker[ticker].core_score is composed from the same score_blocks, risk_downgrade, and scoring_profile carried to analysis_by_ticker[ticker]; a section 4.3 chasing_extreme ticker removes only that profile's theme contribution on both the selection and analysis side through its validated overextension record, so the one core_score per run invariant holds."
        }
      },
      "additionalProperties": false
    },
    "authorization_boundary": {
      "type": "object",
      "required": [
        "provider_call",
        "live_data",
        "datahub_write",
        "production_runner",
        "broker_or_order_execution"
      ],
      "properties": {
        "provider_call": { "const": false },
        "live_data": { "const": false },
        "datahub_write": { "const": false },
        "production_runner": { "const": false },
        "broker_or_order_execution": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
