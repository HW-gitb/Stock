{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cnhea.local/stock/schemas/data_health.schema.json",
  "title": "A-share short screening data health report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "trade_date",
    "preset",
    "market",
    "source",
    "overall_status",
    "errors",
    "warnings",
    "metrics",
    "outputs_checked",
    "limitations"
  ],
  "properties": {
    "schema_name": {
      "const": "data_health"
    },
    "schema_version": {
      "const": "1.10.0"
    },
    "generated_at": {
      "type": "string"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "preset": {
      "const": "a_short"
    },
    "market": {
      "const": "A"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_engine",
        "screening_engine_version",
        "data_provider",
        "api_families",
        "l3_mode",
        "l3_pit_strict",
        "l3_provider"
      ],
      "properties": {
        "screening_engine": {
          "const": "egs_main.py"
        },
        "screening_engine_version": {
          "type": "string"
        },
        "data_provider": {
          "enum": ["tushare", "mixed"]
        },
        "api_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "l3_mode": {
          "type": "string"
        },
        "l3_pit_strict": {
          "type": "boolean"
        },
        "l3_provider": {
          "type": ["string", "null"],
          "enum": ["hithink_finance", "legacy_tushare_snapshot", "neutralized", null],
          "description": "L3 concept-graph provenance; live/persisted HiThink membership makes the overall provider composition mixed."
        }
      }
    },
    "overall_status": {
      "enum": ["ok", "warn", "error"]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/issue"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_count",
        "watch_count",
        "final_count",
        "tier1_count",
        "close_missing_or_nonpositive_count",
        "pe_ttm_or_pe_missing_count",
        "pb_missing_count",
        "watch_l1_unknown_count",
        "watch_l2_unknown_count",
        "full_l2_unknown_count",
        "short_history_candidate_count",
        "watch_pool_reconciliation",
        "sw_industry_membership",
        "rank_universe_reconciliation",
        "suspend_daily_coverage",
        "margin_coverage",
        "moneyflow_coverage",
        "completeness_score_min",
        "completeness_score_below_95_count",
        "completeness_score_below_75_count"
      ],
      "properties": {
        "full_count": {
          "type": "integer",
          "minimum": 0
        },
        "watch_count": {
          "type": "integer",
          "minimum": 0
        },
        "final_count": {
          "type": "integer",
          "minimum": 0
        },
        "tier1_count": {
          "type": "integer",
          "minimum": 0
        },
        "close_missing_or_nonpositive_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "pe_ttm_or_pe_missing_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Missing count for valuation PE. Builder uses pe_ttm first; if pe_ttm is fully missing/absent it falls back to pe. The metric name reflects the union, not just one column."
        },
        "pb_missing_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "watch_l1_unknown_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "watch_l2_unknown_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "full_l2_unknown_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "short_history_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Main-board candidate-universe symbols with 1-60 usable closes; at least one governed 5/20/60-session return is unavailable."
        },
        "watch_pool_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "target_count",
            "eligible_count",
            "expected_count",
            "actual_count",
            "shortfall_count"
          ],
          "properties": {
            "status": {"enum": ["pass", "fail"]},
            "reason": {
              "enum": ["target_met", "eligible_pool_exhausted", "output_count_mismatch"]
            },
            "target_count": {"type": "integer", "minimum": 0},
            "eligible_count": {"type": "integer", "minimum": 0},
            "expected_count": {"type": "integer", "minimum": 0},
            "actual_count": {"type": "integer", "minimum": 0},
            "shortfall_count": {"type": "integer", "minimum": 0}
          }
        },
        "sw_industry_membership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "classification_standard",
            "observed_sources",
            "source",
            "as_of",
            "active_count",
            "min_active",
            "request_group_count",
            "fast_path_used",
            "fallback_used",
            "cache_hit",
            "message"
          ],
          "properties": {
            "status": {"enum": ["pass", "fail", "not_observed"]},
            "classification_standard": {"enum": [null, "SW2021"]},
            "observed_sources": {
              "type": ["array", "null"],
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "source": {
              "enum": [null, "cache", "index_member_all_l1_current", "index_member_l2_history"]
            },
            "as_of": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
            "active_count": {"type": ["integer", "null"], "minimum": 0},
            "min_active": {"type": "integer", "minimum": 0},
            "request_group_count": {"type": "integer", "minimum": 0},
            "fast_path_used": {"type": "boolean"},
            "fallback_used": {"type": "boolean"},
            "cache_hit": {"type": "boolean"},
            "message": {"type": ["string", "null"]}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"enum": ["pass", "fail"]}}},
              "then": {
                "properties": {
                  "classification_standard": {"const": "SW2021"}
                }
              }
            },
            {
              "if": {"properties": {"status": {"const": "not_observed"}}},
              "then": {
                "properties": {
                  "classification_standard": {"const": null},
                  "observed_sources": {"const": null}
                }
              }
            },
            {
              "if": {"properties": {"status": {"enum": ["pass", "fail"]}}},
              "then": {
                "properties": {
                  "observed_sources": {"type": "array"}
                }
              }
            },
            {
              "if": {"properties": {"status": {"const": "pass"}}},
              "then": {
                "properties": {
                  "source": {
                    "enum": ["cache", "index_member_all_l1_current", "index_member_l2_history"]
                  },
                  "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
                  "active_count": {"type": "integer", "minimum": 0}
                }
              }
            },
            {
              "if": {"properties": {"status": {"const": "not_observed"}}},
              "then": {
                "properties": {
                  "source": {"const": null},
                  "as_of": {"const": null},
                  "active_count": {"const": null},
                  "request_group_count": {"const": 0},
                  "fast_path_used": {"const": false},
                  "fallback_used": {"const": false},
                  "cache_hit": {"const": false},
                  "message": {"const": null}
                }
              }
            },
            {
              "if": {"properties": {"source": {"const": "cache"}}},
              "then": {
                "properties": {
                  "fast_path_used": {"const": false},
                  "fallback_used": {"const": false},
                  "cache_hit": {"const": true}
                }
              }
            },
            {
              "if": {"properties": {"source": {"const": "index_member_all_l1_current"}}},
              "then": {
                "properties": {
                  "fast_path_used": {"const": true},
                  "fallback_used": {"const": false},
                  "cache_hit": {"const": false}
                }
              }
            },
            {
              "if": {"properties": {"source": {"const": "index_member_l2_history"}}},
              "then": {
                "properties": {
                  "fast_path_used": {"const": false},
                  "fallback_used": {"const": true},
                  "cache_hit": {"const": false}
                }
              }
            }
          ]
        },
        "rank_universe_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "l0_count",
            "ranked_count",
            "expected_excluded_count",
            "unexpected_excluded_count",
            "unexpected_added_count",
            "unexpected_stage_change_count",
            "accounted_count",
            "unaccounted_count",
            "duplicate_code_count",
            "accounting_balanced",
            "detail_row_count",
            "source_coverage_failure_count",
            "stage_counts",
            "source_coverage"
          ],
          "properties": {
            "status": {
              "enum": ["pass", "fail", "not_observed"]
            },
            "l0_count": {"type": "integer", "minimum": 0},
            "ranked_count": {"type": "integer", "minimum": 0},
            "expected_excluded_count": {"type": "integer", "minimum": 0},
            "unexpected_excluded_count": {"type": "integer", "minimum": 0},
            "unexpected_added_count": {"type": "integer", "minimum": 0},
            "unexpected_stage_change_count": {"type": "integer", "minimum": 0},
            "accounted_count": {"type": "integer", "minimum": 0},
            "unaccounted_count": {"type": "integer", "minimum": 0},
            "duplicate_code_count": {"type": "integer", "minimum": 0},
            "accounting_balanced": {"type": "boolean"},
            "detail_row_count": {"type": "integer", "minimum": 0},
            "source_coverage_failure_count": {"type": "integer", "minimum": 0},
            "stage_counts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "input_count",
                  "output_count",
                  "excluded_count",
                  "added_count",
                  "expected_exclusion"
                ],
                "properties": {
                  "stage": {"type": "string"},
                  "input_count": {"type": "integer", "minimum": 0},
                  "output_count": {"type": "integer", "minimum": 0},
                  "excluded_count": {"type": "integer", "minimum": 0},
                  "added_count": {"type": "integer", "minimum": 0},
                  "expected_exclusion": {"type": "boolean"}
                }
              }
            },
            "source_coverage": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requested_count",
                  "covered_count",
                  "missing_count",
                  "coverage_ratio",
                  "min_coverage",
                  "status"
                ],
                "properties": {
                  "requested_count": {"type": "integer", "minimum": 0},
                  "covered_count": {"type": "integer", "minimum": 0},
                  "missing_count": {"type": "integer", "minimum": 0},
                  "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
                  "min_coverage": {"type": "number", "minimum": 0, "maximum": 1},
                  "status": {"enum": ["pass", "fail"]}
                }
              }
            }
          }
        },
        "suspend_daily_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_name",
            "schema_version",
            "status"
          ],
          "properties": {
            "schema_name": {
              "const": "suspend_daily_coverage_log"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "generated_at": {
              "type": "string"
            },
            "as_of": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{8}$"
            },
            "trade_date": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{8}$"
            },
            "status": {
              "enum": [
                "pass",
                "fail_low_coverage",
                "cache_hit_coverage_not_observed",
                "no_daily_payload_skip_filter",
                "not_observed"
              ]
            },
            "source": {
              "type": "string"
            },
            "stock_universe_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "daily_payload_row_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "traded_in_universe_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "suspended_count": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "coverage_ratio": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "min_coverage": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "attempted_trade_dates": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{8}$"
              }
            },
            "message": {
              "type": ["string", "null"]
            }
          }
        },
        "margin_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_date", "effective_ref_date", "row_count", "universe_size", "coverage_complete", "status"],
          "properties": {
            "reference_date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
            "effective_ref_date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
            "row_count": {"type": "integer", "minimum": 0},
            "universe_size": {"type": "integer", "minimum": 0},
            "invalid_numeric_row_count": {"type": "integer", "minimum": 0, "description": "Count of all rows with invalid required numeric margin fields, including rows on the reference date; only the reference-date subset can contribute to coverage_complete being false."},
            "coverage_complete": {"type": "boolean"},
            "status": {"enum": ["complete", "incomplete", "unavailable", "invalid"]}
          },
          "allOf": [
            {"if": {"properties": {"status": {"const": "complete"}}}, "then": {"properties": {"reference_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "coverage_complete": {"const": true}, "effective_ref_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "row_count": {"minimum": 1000}, "universe_size": {"minimum": 1000}}}},
            {"if": {"properties": {"status": {"enum": ["incomplete", "unavailable", "invalid"]}}}, "then": {"properties": {"coverage_complete": {"const": false}}}}
          ]
        },
        "moneyflow_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_date",
            "effective_ref_date",
            "lag_sessions",
            "fallback_applied",
            "fallback_reason",
            "requested_trade_dates",
            "observed_trade_dates",
            "row_count",
            "universe_size",
            "target_universe_size",
            "target_complete_count",
            "coverage_complete",
            "status"
          ],
          "properties": {
            "reference_date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
            "effective_ref_date": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{8}$",
              "description": "The session the window actually starts at: D0, or D1 when D0 had not been published yet. Null only when nothing was usable. Required here as well as in analysis_input so a delayed publication cannot look like a normal week on either surface."
            },
            "lag_sessions": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 1,
              "description": "Sessions between D0 and effective_ref_date; only 0 or 1."
            },
            "fallback_applied": {"type": "boolean"},
            "fallback_reason": {"type": ["string", "null"], "minLength": 1},
            "requested_trade_dates": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[0-9]{8}$"}
            },
            "observed_trade_dates": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[0-9]{8}$"}
            },
            "row_count": {"type": "integer", "minimum": 0},
            "universe_size": {"type": "integer", "minimum": 0},
            "target_universe_size": {"type": "integer", "minimum": 0},
            "target_complete_count": {"type": "integer", "minimum": 0},
            "coverage_complete": {"type": "boolean"},
            "status": {"enum": ["complete", "incomplete", "unavailable", "invalid"]}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "complete"}}},
              "then": {
                "properties": {
                  "reference_date": {"type": "string", "pattern": "^[0-9]{8}$"},
                  "requested_trade_dates": {"minItems": 5},
                  "observed_trade_dates": {"minItems": 5},
                  "row_count": {"minimum": 1},
                  "coverage_complete": {"const": true}
                }
              }
            },
            {
              "if": {"properties": {"status": {"enum": ["incomplete", "unavailable", "invalid"]}}},
              "then": {"properties": {"coverage_complete": {"const": false}}}
            }
          ]
        },
        "completeness_score_min": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "completeness_score_below_95_count": {
          "type": "integer",
          "minimum": 0
        },
        "completeness_score_below_75_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outputs_checked": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": ["check", "message"],
      "properties": {
        "check": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
