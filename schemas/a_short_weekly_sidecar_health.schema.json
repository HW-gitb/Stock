{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_weekly_sidecar_health",
  "description": "De-identified, post-run observability companion for the non-blocking A-short sidecars.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "m67_status": {"enum": ["complete", "skipped", "not_run"]}
        },
        "required": ["m67_status"]
      },
      "then": {
        "properties": {
          "sidecars": {"minItems": 1}
        }
      }
    }
  ],
  "required": [
    "schema_name", "schema_version", "as_of", "m67_status", "overall",
    "advanced_count", "stalled_count", "failed_count", "partial_count", "sidecars"
  ],
  "properties": {
    "schema_name": {"const": "a_short_weekly_sidecar_health"},
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "run_revision_id": {"type": ["string", "null"], "pattern": "^([0-9a-f]{32})?$"},
    "generated_at": {"type": "string"},
    "run_id": {"type": ["string", "null"], "pattern": "^(a-short-[0-9]{8}-[0-9a-f]{16})?$"},
    "candidate_digest": {"type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$"},
    "m67_status": {"enum": ["complete", "degraded_no_new_entries", "partial_holdings_only", "failed", "skipped", "not_run", "unavailable"]},
    "overall": {"enum": ["healthy", "degraded", "partial"]},
    "advanced_count": {"type": "integer", "minimum": 0},
    "stalled_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "partial_count": {"type": "integer", "minimum": 0},
    "source_receipt_sha256": {"type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$"},
    "sidecars": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "evidence_role", "expected", "attempted", "execution_status",
          "progress_status", "blocking"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "evidence_role": {"enum": ["advisory", "forward_evidence", "cache_support", "readiness"]},
          "expected": {"type": "boolean"},
          "attempted": {"type": "boolean"},
          "attempted_before_egs": {"type": "boolean"},
          "iv_feed_status": {"enum": ["not_requested", "build_failed", "digest_failed", "clock_mismatch", "ready"]},
          "feed_ref": {"type": "string", "minLength": 1},
          "feed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "execution_status": {"enum": ["succeeded", "failed", "skipped", "not_due", "not_configured", "missing_outcome"]},
          "progress_status": {"enum": ["advanced", "already_current", "stalled", "not_applicable", "unavailable"]},
          "expected_decision_as_of": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "expected_data_through": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "observed_decision_as_of": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "observed_data_through": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "error_code": {"type": ["string", "null"], "pattern": "^([a-z0-9_]+)?$"},
          "error_detail": {"type": ["string", "null"], "maxLength": 512, "pattern": "^[^\\r\\n]*$"},
          "skip_reason": {"type": ["string", "null"], "pattern": "^([a-z0-9_]+)?$"},
          "blocking": {"const": false}
        }
      }
    }
  }
}
