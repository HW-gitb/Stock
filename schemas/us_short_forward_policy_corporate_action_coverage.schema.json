{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_forward_policy_corporate_action_coverage/1.0.0/schema.json",
  "title": "US-short forward-policy corporate-action market-wide coverage",
  "description": "Private source-bound Massive split/dividend coverage for the comparison track zero-event certificate. Ticker-bearing rows remain private and never authorize event reconciliation, production, ship-gate evidence, or order execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "authorization_ref", "generated_at", "maturity_as_of", "maturity_ohlcv_sha256", "query_window", "capture_bindings", "families", "boundary"],
  "properties": {
    "schema_name": {"const": "us_short_forward_policy_corporate_action_coverage"},
    "schema_version": {"const": "1.0.0"},
    "authorization_ref": {"const": "user_chat_20260718_us_short_a1_zero_event_certificate"},
    "generated_at": {"type": "string", "minLength": 1},
    "maturity_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "maturity_ohlcv_sha256": {"$ref": "#/$defs/sha256"},
    "query_window": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/date"}, "to": {"$ref": "#/$defs/date"}}
    },
    "capture_bindings": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_date", "common_selection_pool_sha256", "window_start", "h20_session_date"],
        "properties": {
          "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
          "common_selection_pool_sha256": {"$ref": "#/$defs/sha256"},
          "window_start": {"$ref": "#/$defs/date"},
          "h20_session_date": {"$ref": "#/$defs/date"}
        }
      }
    },
    "families": {
      "type": "object", "additionalProperties": false, "required": ["splits", "dividends"],
      "properties": {
        "splits": {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"date_field": {"const": "execution_date"}}}]},
        "dividends": {"allOf": [{"$ref": "#/$defs/family"}, {"properties": {"date_field": {"const": "ex_dividend_date"}}}]}
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["track", "provider_id", "plan", "spend_usd", "market_wide_queries_only", "event_week_reconciliation_performed", "ship_gate_or_production_authorized", "broker_or_order_automation_allowed"],
      "properties": {
        "track": {"const": "comparison_non_production"},
        "provider_id": {"const": "massive"},
        "plan": {"const": "stocks_basic_free"},
        "spend_usd": {"const": 0},
        "market_wide_queries_only": {"const": true},
        "event_week_reconciliation_performed": {"const": false},
        "ship_gate_or_production_authorized": {"const": false},
        "broker_or_order_automation_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "ticker", "event_date"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
        "event_date": {"$ref": "#/$defs/date"}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "date_field", "pages_fetched", "pagination_exhausted", "result_count", "result_sha256", "raw_page_sha256", "events", "failure_reason"],
      "properties": {
        "status": {"enum": ["complete", "incomplete"]},
        "date_field": {"enum": ["execution_date", "ex_dividend_date"]},
        "pages_fetched": {"type": "integer", "minimum": 0, "maximum": 2},
        "pagination_exhausted": {"type": "boolean"},
        "result_count": {"type": "integer", "minimum": 0},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "raw_page_sha256": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/sha256"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "failure_reason": {"enum": [null, "http_error", "malformed_payload", "pagination_limit_exceeded", "unsafe_continuation"]}
      }
    }
  }
}
