{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "US-short Serenity quality-forward ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "quality_policy_version",
    "cross_cohort_aggregation_allowed",
    "cohorts",
    "pending_annotations",
    "closed_pending_annotations",
    "effects"
  ],
  "properties": {
    "schema_name": {"const": "us_short_serenity_quality_forward_ledger"},
    "schema_version": {"const": "1.0.0"},
    "quality_policy_version": {"const": "serenity_quality_policy_v0.1.0"},
    "cross_cohort_aggregation_allowed": {"const": false},
    "cohorts": {
      "type": "array",
      "items": {"$ref": "#/$defs/cohort"}
    },
    "pending_annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/pending_annotation"}
    },
    "closed_pending_annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/closed_pending_annotation"}
    },
    "effects": {"$ref": "#/$defs/effect_boundary"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "schema_version",
        "rubric_version",
        "upstream_decision_result_id",
        "upstream_policy_version",
        "upstream_decision_date",
        "annotation_author_kind",
        "annotation_prompt_version",
        "producer_model_identity"
      ],
      "properties": {
        "annotation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0.0"},
        "rubric_version": {"const": "serenity_annotation_rubric_v0.1.0"},
        "upstream_decision_result_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_policy_version": {"enum": ["soft_discovery_query_policy_v0.2.0", "soft_discovery_query_policy_v0.3.0"]},
        "upstream_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "annotation_author_kind": {"enum": ["human", "llm", "hybrid"]},
        "annotation_prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "producer_model_identity": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_schema_version", "rubric_version", "consumer_version", "upstream_policy_version", "producer_identity_version", "annotation_prompt_version", "reviewer_identity_version", "review_prompt_version"],
      "properties": {
        "annotation_schema_version": {"const": "1.0.0"},
        "rubric_version": {"const": "serenity_annotation_rubric_v0.1.0"},
        "consumer_version": {"const": "serenity_shadow_consumer_v0.1.0"},
        "upstream_policy_version": {"enum": ["soft_discovery_query_policy_v0.2.0", "soft_discovery_query_policy_v0.3.0"]},
        "producer_identity_version": {"const": "serenity_annotation_producer_v0.1.0"},
        "annotation_prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "reviewer_identity_version": {"const": "serenity_quality_reviewer_v0.1.0"},
        "review_prompt_version": {"const": "serenity_quality_reviewer_prompt_v0.1.0"}
      }
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "author_kind", "prompt_version", "model_identity"],
      "properties": {
        "identity_version": {"const": "serenity_annotation_producer_v0.1.0"},
        "author_kind": {"enum": ["human", "llm", "hybrid"]},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_identity": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]}
      }
    },
    "reviewer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "reviewer_id", "model_identity", "prompt_version"],
      "properties": {
        "identity_version": {"const": "serenity_quality_reviewer_v0.1.0"},
        "reviewer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"},
        "model_identity": {"type": "string", "minLength": 1, "maxLength": 200},
        "prompt_version": {"const": "serenity_quality_reviewer_prompt_v0.1.0"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "verdict", "rationale", "evidence_ref_ids"],
      "properties": {
        "metric_id": {"type": "string"},
        "verdict": {"enum": ["pass", "fail", "not_evaluable"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,255}$"}
        }
      }
    },
    "claim_binding_integrity": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "claim_binding_integrity"}}}]},
    "review_consistency": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "review_consistency"}}}]},
    "falsifier_observability": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "falsifier_observability"}}}]},
    "horizon_judgment": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "horizon_judgment"}}}]},
    "weak_or_contradicted_discrimination": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "weak_or_contradicted_discrimination"}}}]},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "decision_date",
        "annotation_identity",
        "consumer_version",
        "dimensions",
        "reviewer_kind",
        "reviewed_at",
        "metrics",
        "eligible",
        "producer_identity",
        "reviewer_identity",
        "formal_count_eligible"
      ],
      "properties": {
        "record_id": {"type": "string", "pattern": "^serenity_quality_record:[A-Za-z0-9_.:-]{3,500}$"},
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "annotation_identity": {"$ref": "#/$defs/identity"},
        "consumer_version": {"const": "serenity_shadow_consumer_v0.1.0"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "reviewer_kind": {"enum": ["human", "llm"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "producer_identity": {"$ref": "#/$defs/producer_identity"},
        "reviewer_identity": {"$ref": "#/$defs/reviewer_identity"},
        "metrics": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": [
            {"$ref": "#/$defs/claim_binding_integrity"},
            {"$ref": "#/$defs/review_consistency"},
            {"$ref": "#/$defs/falsifier_observability"},
            {"$ref": "#/$defs/horizon_judgment"},
            {"$ref": "#/$defs/weak_or_contradicted_discrimination"}
          ],
          "additionalItems": false
        },
        "eligible": {"const": true},
        "formal_count_eligible": {"type": "boolean"}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "dimensions", "records", "quality_gate_result_id"],
      "properties": {
        "cohort_id": {"type": "string", "pattern": "^serenity_quality_cohort:[A-Za-z0-9_.:-]{3,500}$"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "quality_gate_result_id": {
          "anyOf": [{"type": "string", "pattern": "^serenity_quality_gate:[A-Za-z0-9_.:-]{3,500}$"}, {"type": "null"}]
        }
      }
    },
    "pending_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_date", "annotation_file_name", "review_file_name", "annotation_identity", "producer_identity", "created_at", "status"],
      "properties": {
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "annotation_file_name": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,255}$"},
        "review_file_name": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,255}$"},
        "annotation_identity": {"$ref": "#/$defs/identity"},
        "producer_identity": {"$ref": "#/$defs/producer_identity"},
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"const": "awaiting_review"}
      }
    },
    "closed_pending_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_date", "annotation_identity", "producer_identity", "settlement_status", "settled_at", "reason_code", "reviewer_identity"],
      "properties": {
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "annotation_identity": {"$ref": "#/$defs/identity"},
        "producer_identity": {"$ref": "#/$defs/producer_identity"},
        "settlement_status": {"enum": ["eligible", "no_count"]},
        "settled_at": {"type": "string", "format": "date-time"},
        "reason_code": {"type": "string", "pattern": "^[A-Z0-9_:-]{2,120}$"},
        "reviewer_identity": {"anyOf": [{"$ref": "#/$defs/reviewer_identity"}, {"type": "null"}]}
      }
    },
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "provider_calls_performed", "network_access_performed", "main_task_should_abort"],
      "properties": {
        "scoring_eligible": {"const": false},
        "top15_effect_enabled": {"const": false},
        "operation_advice_effect_enabled": {"const": false},
        "provider_calls_performed": {"const": false},
        "network_access_performed": {"const": false},
        "main_task_should_abort": {"const": false}
      }
    }
  }
}
