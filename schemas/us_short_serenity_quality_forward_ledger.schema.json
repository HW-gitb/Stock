{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "US-short Serenity quality-forward ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "quality_policy_version",
    "cross_cohort_aggregation_allowed",
    "cohorts",
    "effects"
  ],
  "properties": {
    "schema_name": {"const": "us_short_serenity_quality_forward_ledger"},
    "schema_version": {"const": "1.0.0"},
    "quality_policy_version": {"const": "serenity_quality_policy_v0.1.0"},
    "cross_cohort_aggregation_allowed": {"const": false},
    "cohorts": {
      "type": "array",
      "items": {"$ref": "#/$defs/cohort"}
    },
    "effects": {"$ref": "#/$defs/effect_boundary"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "schema_version",
        "rubric_version",
        "upstream_decision_result_id",
        "upstream_policy_version",
        "upstream_decision_date"
      ],
      "properties": {
        "annotation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0.0"},
        "rubric_version": {"const": "serenity_annotation_rubric_v0.1.0"},
        "upstream_decision_result_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "upstream_policy_version": {"enum": ["soft_discovery_query_policy_v0.2.0", "soft_discovery_query_policy_v0.3.0"]},
        "upstream_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_schema_version", "rubric_version", "consumer_version", "upstream_policy_version"],
      "properties": {
        "annotation_schema_version": {"const": "1.0.0"},
        "rubric_version": {"const": "serenity_annotation_rubric_v0.1.0"},
        "consumer_version": {"const": "serenity_shadow_consumer_v0.1.0"},
        "upstream_policy_version": {"enum": ["soft_discovery_query_policy_v0.2.0", "soft_discovery_query_policy_v0.3.0"]}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "verdict", "rationale", "evidence_ref_ids"],
      "properties": {
        "metric_id": {"type": "string"},
        "verdict": {"enum": ["pass", "fail", "not_evaluable"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,255}$"}
        }
      }
    },
    "claim_binding_integrity": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "claim_binding_integrity"}}}]},
    "review_consistency": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "review_consistency"}}}]},
    "falsifier_observability": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "falsifier_observability"}}}]},
    "horizon_judgment": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "horizon_judgment"}}}]},
    "weak_or_contradicted_discrimination": {"allOf": [{"$ref": "#/$defs/metric"}, {"properties": {"metric_id": {"const": "weak_or_contradicted_discrimination"}}}]},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "decision_date",
        "annotation_identity",
        "consumer_version",
        "dimensions",
        "reviewer_kind",
        "reviewed_at",
        "metrics",
        "eligible"
      ],
      "properties": {
        "record_id": {"type": "string", "pattern": "^serenity_quality_record:[A-Za-z0-9_.:-]{3,500}$"},
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "annotation_identity": {"$ref": "#/$defs/identity"},
        "consumer_version": {"const": "serenity_shadow_consumer_v0.1.0"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "reviewer_kind": {"enum": ["human", "llm"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "metrics": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": [
            {"$ref": "#/$defs/claim_binding_integrity"},
            {"$ref": "#/$defs/review_consistency"},
            {"$ref": "#/$defs/falsifier_observability"},
            {"$ref": "#/$defs/horizon_judgment"},
            {"$ref": "#/$defs/weak_or_contradicted_discrimination"}
          ],
          "additionalItems": false
        },
        "eligible": {"const": true}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "dimensions", "records", "quality_gate_result_id"],
      "properties": {
        "cohort_id": {"type": "string", "pattern": "^serenity_quality_cohort:[A-Za-z0-9_.:-]{3,500}$"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
        "quality_gate_result_id": {
          "anyOf": [{"type": "string", "pattern": "^serenity_quality_gate:[A-Za-z0-9_.:-]{3,500}$"}, {"type": "null"}]
        }
      }
    },
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "provider_calls_performed", "network_access_performed", "main_task_should_abort"],
      "properties": {
        "scoring_eligible": {"const": false},
        "top15_effect_enabled": {"const": false},
        "operation_advice_effect_enabled": {"const": false},
        "provider_calls_performed": {"const": false},
        "network_access_performed": {"const": false},
        "main_task_should_abort": {"const": false}
      }
    }
  }
}
