        {"contains": {"type": "object", "properties": {"component_id": {"const": "pit_universe_survivorship"}}, "required": ["component_id"]}},
        {"contains": {"type": "object", "properties": {"component_id": {"const": "raw_pit_fundamentals"}}, "required": ["component_id"]}},
        {"contains": {"type": "object", "properties": {"component_id": {"const": "restatement_revision_lineage"}}, "required": ["component_id"]}},
        {"contains": {"type": "object", "properties": {"component_id": {"const": "industry_taxonomy_history"}}, "required": ["component_id"]}},
        {"contains": {"type": "object", "properties": {"component_id": {"const": "total_return_and_benchmark"}}, "required": ["component_id"]}},
        {"contains": {"type": "object", "properties": {"component_id": {"const": "terminal_delisting_return"}}, "required": ["component_id"]}}
