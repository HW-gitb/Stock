{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_weekly_report",
  "description": "A-short weekly pipeline output: top-N per-stock M6.7 reports for one weekend run. reports[] each ALSO validated against a_short_m67_report.schema.json by write_weekly_report (this schema only gates the envelope + per-item minimal shape). Non-production, edge UNVALIDATED — boundary all false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "as_of",
               "iv_feed_ref", "n_stocks", "reports", "run_lineage", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_weekly_report"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "iv_feed_ref": {"type": "string"},
    "n_stocks": {"type": "integer", "minimum": 0},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_name", "as_of", "ts_code", "m67", "machine", "boundary"],
        "properties": {
          "schema_name": {"const": "a_short_m67_report"},
          "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
          "ts_code": {"type": "string"}
        }
      }
    },
    "holdings_manual_review": {
      "type": "array",
      "description": "持仓恒列入 S1: 账户持仓中无价/停牌/价格陈旧(最新 bar != 决策价格日)的票,旁路候选价格门、不进 reports[]、不伪造'持有',单列人工管理。可选(缺省=空)。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts_code", "name", "reason"],
        "properties": {
          "ts_code": {"type": "string"},
          "name": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "cash_allocation": {
      "type": ["object", "null"],
      "description": "#3 全局现金分配摘要(带 --account 才有;价格提案 §4/§11.3):多只建仓按区间上沿 entry_high 统一消耗 available_cash,不足一手→转观察。可选/缺省 null(observation-only 无)。",
      "additionalProperties": false,
      "required": ["available_cash_start", "allocated_cash_total", "remaining_cash"],
      "properties": {
        "available_cash_start": {"type": "number"},
        "allocated_cash_total": {"type": "number"},
        "remaining_cash": {"type": "number"}
      }
    },
    "run_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_input", "selection_bucket", "iv_feed", "account_ref", "account_status", "sizing_mode", "price_freshness"],
      "properties": {
        "analysis_input": {"type": "string"},
        "selection_bucket": {"type": "string"},
        "iv_feed": {"type": "string"},
        "account_ref": {"type": "string"},
        "account_status": {"enum": ["provided", "absent"]},
        "sizing_mode": {"enum": ["sized", "observation_only_no_account"]},
        "price_freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "run_date", "accepted_prior_settled_date", "price_data_through"],
          "properties": {
            "mode": {"enum": ["strict_as_of", "intraday_prior_settled"]},
            "run_date": {"type": ["string", "null"], "pattern": "^\\d{8}$"},
            "accepted_prior_settled_date": {"type": ["string", "null"], "pattern": "^\\d{8}$"},
            "price_data_through": {"type": "string", "pattern": "^\\d{8}$"}
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "real_money", "is_validated_alpha", "satisfies_ship_gate"],
      "properties": {
        "production": {"const": false},
        "real_money": {"const": false},
        "is_validated_alpha": {"const": false},
        "satisfies_ship_gate": {"const": false}
      }
    }
  }
}
