{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_soft_boost_maturity_observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_date", "consumption_receipt_sha256", "shadow_receipt_sha256", "maturity_receipt_sha256", "market_risk_regime", "eligible", "non_overlap_h10_block", "on_net_return", "off_net_return", "on_max_drawdown", "off_max_drawdown", "on_bad_pick_rate", "off_bad_pick_rate", "on_tail_loss", "off_tail_loss", "on_turnover", "off_turnover", "on_fill_fraction", "off_fill_fraction"],
  "properties": {
    "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "consumption_receipt_sha256": {"$ref": "#/definitions/digest"},
    "shadow_receipt_sha256": {"$ref": "#/definitions/digest"},
    "maturity_receipt_sha256": {"$ref": "#/definitions/digest"},
    "market_risk_regime": {"type": "string", "minLength": 1},
    "eligible": {"type": "boolean"},
    "non_overlap_h10_block": {"type": "boolean"},
    "on_net_return": {"$ref": "#/definitions/fraction"}, "off_net_return": {"$ref": "#/definitions/fraction"},
    "on_max_drawdown": {"$ref": "#/definitions/fraction"}, "off_max_drawdown": {"$ref": "#/definitions/fraction"},
    "on_bad_pick_rate": {"$ref": "#/definitions/fraction"}, "off_bad_pick_rate": {"$ref": "#/definitions/fraction"},
    "on_tail_loss": {"$ref": "#/definitions/fraction"}, "off_tail_loss": {"$ref": "#/definitions/fraction"},
    "on_turnover": {"$ref": "#/definitions/fraction"}, "off_turnover": {"$ref": "#/definitions/fraction"},
    "on_fill_fraction": {"$ref": "#/definitions/fraction"}, "off_fill_fraction": {"$ref": "#/definitions/fraction"}
  },
  "definitions": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fraction": {"type": "number", "minimum": -1.0, "maximum": 1.0}
  }
}
