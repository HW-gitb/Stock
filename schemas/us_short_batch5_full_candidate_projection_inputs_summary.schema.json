{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_candidate_projection_inputs_summary.schema.json",
  "title": "US-short Batch5 full-candidate projection-input summary",
  "type": "object",
