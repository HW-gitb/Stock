        "momentum_scored_count": { "type": "integer", "minimum": 0 },
        "theme_scored_count": { "type": "integer", "minimum": 0 },
        "momentum_neutral_fill_count": { "type": "integer", "minimum": 0 },
        "theme_neutral_fill_count": { "type": "integer", "minimum": 0 },
        "coverage_exactly_matches_full_candidate_set": { "const": true },
        "neutral_fill_only_for_missing_source_inputs": { "const": true },
        "full_candidate_local_inputs_ready": { "const": true },
