        "theme_scored_count",
        "momentum_neutral_fill_count",
        "theme_neutral_fill_count",
        "coverage_exactly_matches_full_candidate_set",
        "neutral_fill_only_for_missing_source_inputs",
        "full_candidate_local_inputs_ready",
        "live_momentum_source_evidence_for_all_candidates",
