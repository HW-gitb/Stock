        "summary_contains_secrets"
      ],
      "properties": {
        "projection_paths_gitignored": { "const": true },
        "summary_contains_raw_rows": { "const": false },
        "summary_contains_raw_payload": { "const": false },
        "summary_contains_request_urls": { "const": false },
        "summary_contains_secrets": { "const": false }
      }
