{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_theme_source_packet_plan.schema.json",
  "title": "US-short Batch5 bounded full theme source packet plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "authorization_ref",
    "generated_at",
    "scope",
    "decision_clock",
    "selected_symbols",
    "industry_peer_symbols_by_selected",
    "provisional_themes_by_id",
    "source_contract",
    "prohibited_claims"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_theme_source_packet_plan" },
    "schema_version": { "const": "1.0.0" },
    "authorization_ref": { "const": "user_chat_20260705_us_short_theme_source_packet" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "lane",
        "batch",
        "purpose",
        "network_access_authorized",
        "full_market_download_allowed",
        "datahub_consumption_allowed",
        "production_storage_allowed",
        "ship_gate_evidence_claimed",
        "broker_or_order_automation_allowed",
        "a_share_crossing_allowed"
      ],
      "properties": {
        "market": { "const": "US" },
        "lane": { "const": "us_short" },
        "batch": { "const": "batch5_provider_live" },
        "purpose": { "const": "bounded_full_theme_source_packet_plan" },
        "network_access_authorized": { "const": true },
        "full_market_download_allowed": { "const": false },
        "datahub_consumption_allowed": { "const": false },
        "production_storage_allowed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "broker_or_order_automation_allowed": { "const": false },
        "a_share_crossing_allowed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" }
      }
    },
    "selected_symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
    },
    "industry_peer_symbols_by_selected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
      }
    },
    "provisional_themes_by_id": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 20,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
      }
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_source",
        "profile_provider_id",
        "price_provider_id",
        "benchmark_symbols",
        "session",
        "adjustment_mode",
        "min_points_per_series",
        "lookback_calendar_days",
        "max_selected_symbols",
        "max_industry_symbols",
        "max_total_endpoint_calls",
        "full_gics_peer_pool",
        "provisional_theme_membership_frozen"
      ],
      "properties": {
        "symbol_source": { "const": "reviewed_local_peer_theme_plan" },
        "profile_provider_id": { "const": "financial_modeling_prep" },
        "price_provider_id": { "const": "massive" },
        "benchmark_symbols": { "const": ["SPY", "QQQ"] },
        "session": { "const": "RTH" },
        "adjustment_mode": { "const": "split_adjusted" },
        "min_points_per_series": { "type": "integer", "minimum": 64, "maximum": 3000 },
        "lookback_calendar_days": { "type": "integer", "minimum": 90, "maximum": 730 },
        "max_selected_symbols": { "const": 3 },
        "max_industry_symbols": { "type": "integer", "minimum": 2, "maximum": 8 },
        "max_total_endpoint_calls": { "const": 18 },
        "full_gics_peer_pool": { "const": true },
        "provisional_theme_membership_frozen": { "const": true }
      }
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selection_complete",
        "full_market_download_performed",
        "yfinance_used",
        "live_normalized_evidence",
        "ship_gate_evidence",
        "production_ready",
        "datahub_consumed"
      ],
      "properties": {
        "provider_selection_complete": { "const": false },
        "full_market_download_performed": { "const": false },
        "yfinance_used": { "const": false },
        "live_normalized_evidence": { "const": false },
        "ship_gate_evidence": { "const": false },
        "production_ready": { "const": false },
        "datahub_consumed": { "const": false }
      }
    }
  }
}
