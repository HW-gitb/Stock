{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_llm_theme_discovery_fetch_x.schema.json",
  "title": "US-short bounded Grok native-X discovery receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "decision_clock", "fetch_contract", "queries", "source_refs", "discovery_artifact_sha256", "drop_ledger", "summary"],
  "properties": {
    "schema_name": {"const": "us_short_llm_theme_discovery_fetch_x"}, "schema_version": {"const": "1.0.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "decision_clock": {"type": "object", "additionalProperties": false, "required": ["expected_decision_date", "cutoff_policy", "pit_enforced"], "properties": {"expected_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "cutoff_policy": {"const": "before_decision_open_et"}, "pit_enforced": {"const": true}}},
    "fetch_contract": {"type": "object", "additionalProperties": false, "required": ["producer_kind", "execution_mode", "network_access_performed", "provider_calls_performed", "network_call_count", "provider_call_count", "scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "dynamic_seats_enabled", "theme_probe_enabled", "lifecycle_actions_enabled"], "properties": {"producer_kind": {"const": "grok_native_x_fetch"}, "execution_mode": {"enum": ["offline_fake_client", "live_authorized"]}, "network_access_performed": {"type": "boolean"}, "provider_calls_performed": {"type": "boolean"}, "network_call_count": {"type": "integer", "minimum": 0}, "provider_call_count": {"type": "integer", "minimum": 0}, "scoring_eligible": {"const": false}, "top15_effect_enabled": {"const": false}, "operation_advice_effect_enabled": {"const": false}, "dynamic_seats_enabled": {"const": false}, "theme_probe_enabled": {"const": false}, "lifecycle_actions_enabled": {"const": false}}, "allOf": [{"if": {"properties": {"execution_mode": {"const": "live_authorized"}}}, "then": {"properties": {"network_access_performed": {"const": true}, "provider_calls_performed": {"const": true}, "network_call_count": {"minimum": 1}, "provider_call_count": {"minimum": 1}}}}, {"if": {"properties": {"execution_mode": {"const": "offline_fake_client"}}}, "then": {"properties": {"network_access_performed": {"const": false}, "provider_calls_performed": {"const": false}, "network_call_count": {"const": 0}, "provider_call_count": {"const": 0}}}}]},
    "queries": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "source_refs": {"type": "array", "items": {"$ref": "#/definitions/source_ref"}}, "discovery_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drop_ledger": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage", "reason", "detail"], "properties": {"stage": {"enum": ["search_result", "llm"]}, "reason": {"type": "string"}, "detail": {"type": "string"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["query_count", "accepted_source_count", "validated_theme_count", "validated_member_count", "dropped_result_count"], "properties": {"query_count": {"type": "integer", "minimum": 0}, "accepted_source_count": {"type": "integer", "minimum": 0}, "validated_theme_count": {"type": "integer", "minimum": 0}, "validated_member_count": {"type": "integer", "minimum": 0}, "dropped_result_count": {"type": "integer", "minimum": 0}}}
  },
  "definitions": {"source_ref": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_type", "canonical_locator", "observed_at", "fetched_at", "content_sha256", "raw_receipt_ref", "raw_receipt_gitignored"], "properties": {"source_id": {"type": "string", "pattern": "^x:[0-9a-f]{64}$"}, "source_type": {"const": "x"}, "canonical_locator": {"type": "string", "pattern": "^https?://[^\\s]+$"}, "observed_at": {"type": "string", "format": "date-time"}, "fetched_at": {"type": "string", "format": "date-time"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "raw_receipt_ref": {"type": ["string", "null"], "pattern": "^provider_samples/[^\\s]+$"}, "raw_receipt_gitignored": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"raw_receipt_ref": {"type": "string"}}}, "then": {"properties": {"raw_receipt_gitignored": {"const": true}}}}]}}
}
