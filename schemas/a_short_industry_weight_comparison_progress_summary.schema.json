{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A-short industry-weight comparison de-identified P5a progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "summary_id", "as_of", "status", "questions", "p5b_build_due", "message", "production_unchanged"],
  "properties": {
    "schema_name": {"const": "a_short_industry_weight_comparison_progress_summary"},
    "schema_version": {"const": "1.0.0"},
    "summary_id": {"const": "a_short_industry_weight_comparison"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "status": {"enum": ["not_configured", "accumulating", "p5b_build_due", "evidence_unavailable_or_inconclusive"]},
    "questions": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["question_id", "eligible_policy_weeks", "difference_weeks", "mature_opportunities", "no_count_weeks", "p5b_build_due", "remaining_eligible_to_p5b", "remaining_difference_to_p5b", "p5b_checkpoint_notice"],
        "properties": {"question_id": {"enum": ["balanced_vs_legacy", "aggressive_vs_balanced", "theme_double_vs_balanced"]}, "eligible_policy_weeks": {"type": "integer", "minimum": 0}, "difference_weeks": {"type": "integer", "minimum": 0}, "mature_opportunities": {"type": "integer", "minimum": 0}, "no_count_weeks": {"type": "integer", "minimum": 0}, "p5b_build_due": {"type": "boolean"}, "remaining_eligible_to_p5b": {"type": "integer", "minimum": 0}, "remaining_difference_to_p5b": {"type": "integer", "minimum": 0}, "p5b_checkpoint_notice": {"enum": ["accumulating", "p5b_implementation_due_at_12", "p5b_formal_checkpoint_24_not_implemented", "p5b_terminal_checkpoint_36_not_implemented"]}}}},
    "p5b_build_due": {"type": "boolean"},
    "message": {"type": "string", "minLength": 1},
    "production_unchanged": {"const": true}
  }
}
