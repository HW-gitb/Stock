{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_corporate_action_manual_event_record/1.1.0/schema.json",
  "title": "US-short Manual Corporate-Action Event Record",
  "description": "Pure/offline transcription of manually reviewed SEC evidence into either a source-bound confirmed event consumable by the manual disposition planner or a single-ticker manual-review freeze. The EDGAR URL CIK must bind to the old security or an identity-bound successor. The SEC URL is never retained; only accession, evidence CIK, and canonical evidence digest are emitted. A confirmed event carries only a digest binding to a locally read validated private account_state; shares, cash, positions, and the ticket remain private. No provider call, raw-payload read, account mutation, broker action, selection change, or ship-gate claim is allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "record_status", "security_binding", "successor_security_binding", "source_binding", "account_state_binding", "confirmed_event", "manual_review", "boundary"],
  "properties": {
    "schema_name": {"const": "us_short_corporate_action_manual_event_record"},
    "schema_version": {"const": "1.1.0"},
    "record_status": {"enum": ["confirmed_event", "manual_review"]},
    "security_binding": {"$ref": "#/$defs/securityBinding"},
    "successor_security_binding": {"type": ["object", "null"]},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "account_state_binding": {"type": ["object", "null"]},
    "confirmed_event": {"type": ["object", "null"]},
    "manual_review": {"$ref": "#/$defs/manualReview"},
    "boundary": {"$ref": "#/$defs/boundary"}
  },
  "allOf": [
    {"if": {"properties": {"record_status": {"const": "confirmed_event"}}}, "then": {"properties": {"confirmed_event": {"$ref": "#/$defs/confirmedEvent"}, "manual_review": {"const": {"reason": null, "ticker_scoped_freeze": null}}, "source_binding": {"$ref": "#/$defs/completeSourceBinding"}, "account_state_binding": {"$ref": "#/$defs/accountStateBinding"}, "boundary": {"$ref": "#/$defs/accountReadBoundary"}}}},
    {"if": {"properties": {"record_status": {"const": "manual_review"}}}, "then": {"properties": {"account_state_binding": {"type": "null"}, "confirmed_event": {"type": "null"}, "successor_security_binding": {"type": "null"}, "manual_review": {"$ref": "#/$defs/manualReviewRequired"}}}},
    {"if": {"properties": {"record_status": {"const": "confirmed_event"}, "confirmed_event": {"properties": {"event_type": {"const": "stock_conversion"}}}}}, "then": {"properties": {"successor_security_binding": {"$ref": "#/$defs/securityBinding"}, "confirmed_event": {"properties": {"successor_ticker": {"$ref": "#/$defs/ticker"}, "stock_ratio_numerator": {"type": "integer", "minimum": 1}, "stock_ratio_denominator": {"type": "integer", "minimum": 1}, "cash_per_old_share_cents": {"type": "null"}}}}}},
    {"if": {"properties": {"record_status": {"const": "confirmed_event"}, "confirmed_event": {"properties": {"event_type": {"const": "cash_consideration"}}}}}, "then": {"properties": {"successor_security_binding": {"type": "null"}, "confirmed_event": {"properties": {"successor_ticker": {"type": "null"}, "stock_ratio_numerator": {"type": "null"}, "stock_ratio_denominator": {"type": "null"}, "cash_per_old_share_cents": {"type": "integer", "minimum": 1}}}}}},
    {"if": {"properties": {"record_status": {"const": "confirmed_event"}, "confirmed_event": {"properties": {"event_type": {"const": "stock_and_cash_consideration"}}}}}, "then": {"properties": {"successor_security_binding": {"$ref": "#/$defs/securityBinding"}, "confirmed_event": {"properties": {"successor_ticker": {"$ref": "#/$defs/ticker"}, "stock_ratio_numerator": {"type": "integer", "minimum": 1}, "stock_ratio_denominator": {"type": "integer", "minimum": 1}, "cash_per_old_share_cents": {"type": "integer", "minimum": 1}}}}}},
    {"if": {"properties": {"record_status": {"const": "confirmed_event"}, "confirmed_event": {"properties": {"event_type": {"const": "forced_exit"}}}}}, "then": {"properties": {"successor_security_binding": {"type": "null"}, "confirmed_event": {"properties": {"successor_ticker": {"type": "null"}, "stock_ratio_numerator": {"type": "null"}, "stock_ratio_denominator": {"type": "null"}, "cash_per_old_share_cents": {"type": "null"}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
    "securityId": {"type": "string", "pattern": "^US-CIK-[0-9]{10}-(COMMON|CLASS_[A-Z]{1,3}|ADR|PREFERRED)$"},
    "securityBinding": {"type": "object", "additionalProperties": false, "required": ["security_id", "issuer_cik", "current_ticker", "identity_ref_sha256"], "properties": {"security_id": {"$ref": "#/$defs/securityId"}, "issuer_cik": {"$ref": "#/$defs/cik"}, "current_ticker": {"$ref": "#/$defs/ticker"}, "identity_ref_sha256": {"$ref": "#/$defs/sha256"}}},
    "sourceBinding": {"type": "object", "additionalProperties": false, "required": ["source_kind", "sec_accession", "evidence_issuer_cik", "source_evidence_ref_sha256"], "properties": {"source_kind": {"const": "sec_manual_read"}, "sec_accession": {"type": ["string", "null"], "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "evidence_issuer_cik": {"type": ["string", "null"], "pattern": "^[0-9]{10}$"}, "source_evidence_ref_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "completeSourceBinding": {"type": "object", "additionalProperties": false, "required": ["source_kind", "sec_accession", "evidence_issuer_cik", "source_evidence_ref_sha256"], "properties": {"source_kind": {"const": "sec_manual_read"}, "sec_accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "evidence_issuer_cik": {"$ref": "#/$defs/cik"}, "source_evidence_ref_sha256": {"$ref": "#/$defs/sha256"}}},
    "accountStateBinding": {"type": "object", "additionalProperties": false, "required": ["schema_name", "schema_version", "as_of", "account_state_ref_sha256"], "properties": {"schema_name": {"const": "us_short_account_state"}, "schema_version": {"const": "1.0.0"}, "as_of": {"type": "string", "pattern": "^[0-9]{8}$"}, "account_state_ref_sha256": {"$ref": "#/$defs/sha256"}}},
    "confirmedEvent": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "old_ticker", "effective_date", "source_evidence_ref_sha256", "source_confirmation", "successor_ticker", "stock_ratio_numerator", "stock_ratio_denominator", "cash_per_old_share_cents"], "properties": {"event_id": {"type": "string", "pattern": "^manual-sec-[0-9a-f]{24}$"}, "event_type": {"enum": ["stock_conversion", "cash_consideration", "stock_and_cash_consideration", "forced_exit"]}, "old_ticker": {"$ref": "#/$defs/ticker"}, "effective_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "source_evidence_ref_sha256": {"$ref": "#/$defs/sha256"}, "source_confirmation": {"const": "manually_confirmed_source_bound"}, "successor_ticker": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"}, "stock_ratio_numerator": {"type": ["integer", "null"], "minimum": 1}, "stock_ratio_denominator": {"type": ["integer", "null"], "minimum": 1}, "cash_per_old_share_cents": {"type": ["integer", "null"], "minimum": 1}}},
    "freeze": {"type": "object", "additionalProperties": false, "required": ["schema_name", "schema_version", "frozen_security_id", "frozen_tickers", "source_id", "failure_class", "manual_review_required", "global_run_blocked", "boundary"], "properties": {"schema_name": {"const": "us_short_ticker_scoped_source_freeze"}, "schema_version": {"const": "1.0.0"}, "frozen_security_id": {"$ref": "#/$defs/securityId"}, "frozen_tickers": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/ticker"}}, "source_id": {"const": "sec_manual_entry"}, "failure_class": {"const": "source_contract_violation"}, "manual_review_required": {"const": true}, "global_run_blocked": {"const": false}, "boundary": {"$ref": "#/$defs/freezeBoundary"}}},
    "freezeBoundary": {"type": "object", "additionalProperties": false, "required": ["provider_retry_performed", "unrelated_symbols_frozen", "selection_or_ranking_changed", "account_state_read", "broker_or_order_automation_allowed"], "properties": {"provider_retry_performed": {"const": false}, "unrelated_symbols_frozen": {"const": false}, "selection_or_ranking_changed": {"const": false}, "account_state_read": {"const": false}, "broker_or_order_automation_allowed": {"const": false}}},
    "manualReview": {"type": "object", "additionalProperties": false, "required": ["reason", "ticker_scoped_freeze"], "properties": {"reason": {"type": ["string", "null"]}, "ticker_scoped_freeze": {"type": ["object", "null"]}}},
    "manualReviewRequired": {"type": "object", "additionalProperties": false, "required": ["reason", "ticker_scoped_freeze"], "properties": {"reason": {"enum": ["manual_confirmation_missing", "unsupported_consideration_cvr", "confirmed_event_input_invalid", "account_read_confirmation_missing", "account_state_invalid", "no_position_for_ticker"]}, "ticker_scoped_freeze": {"$ref": "#/$defs/freeze"}}},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["provider_call_performed", "raw_payload_read", "account_state_read", "account_state_mutated", "broker_order_placed", "selection_or_ranking_changed", "ship_gate_evidence_claimed"], "properties": {"provider_call_performed": {"const": false}, "raw_payload_read": {"const": false}, "account_state_read": {"type": "boolean"}, "account_state_mutated": {"const": false}, "broker_order_placed": {"const": false}, "selection_or_ranking_changed": {"const": false}, "ship_gate_evidence_claimed": {"const": false}}},
    "accountReadBoundary": {"type": "object", "additionalProperties": false, "required": ["provider_call_performed", "raw_payload_read", "account_state_read", "account_state_mutated", "broker_order_placed", "selection_or_ranking_changed", "ship_gate_evidence_claimed"], "properties": {"provider_call_performed": {"const": false}, "raw_payload_read": {"const": false}, "account_state_read": {"const": true}, "account_state_mutated": {"const": false}, "broker_order_placed": {"const": false}, "selection_or_ranking_changed": {"const": false}, "ship_gate_evidence_claimed": {"const": false}}}
  }
}
