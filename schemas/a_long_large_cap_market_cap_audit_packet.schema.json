        "monthly_as_of_dates": {
          "type": "array",
          "items": {"$ref": "#/$defs/date8"},
          "minItems": 96,
          "maxItems": 96,
          "uniqueItems": true
        },
        "same_as_materialization_dates": {"const": true},
        "prior_audited_universe_bridge_required": {"const": true},
        "size_bucket_count": {"const": 5},
        "minimum_size_bucket_count_for_primary_percentile": {"const": 50},
        "top500_symbols_written_to_tracked_report": {"const": false},
        "not_signal_search": {"const": true}
      }
    },
    "auditCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "hard_check", "description"],
      "properties": {
        "check_id": {
          "enum": [
            "materialization_summary_gate",
            "raw_payload_shape_and_refs",
            "top500_rederivation_consistency",
            "main_board_filter_integrity",
            "prior_full_main_board_universe_bridge",
            "size_quintile_coverage"
          ]
        },
        "hard_check": {"const": true},
        "description": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema_ref",
        "report_path",
        "monthly_coverage_path",
        "tracked_report_must_not_contain_raw_rows",
        "tracked_report_must_not_contain_top500_symbols",
        "tracked_report_must_not_contain_secret",
        "tracked_report_must_not_contain_request_url",
        "audit_report_authorizes_signal_search_by_itself",
        "audit_report_authorizes_alpha_or_production"
      ],
      "properties": {
        "report_schema_ref": {"const": "schemas/a_long_large_cap_market_cap_audit_report.schema.json"},
        "report_path": {"const": "research/results/a_long_large_cap_market_cap_audit_20260607/audit_report.json"},
        "monthly_coverage_path": {"const": "research/results/a_long_large_cap_market_cap_audit_20260607/monthly_coverage.csv"},
        "tracked_report_must_not_contain_raw_rows": {"const": true},
        "tracked_report_must_not_contain_top500_symbols": {"const": true},
        "tracked_report_must_not_contain_secret": {"const": true},
        "tracked_report_must_not_contain_request_url": {"const": true},
        "audit_report_authorizes_signal_search_by_itself": {"const": false},
        "audit_report_authorizes_alpha_or_production": {"const": false}
      }
    },
    "preExecutionGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_independent_review_pass",
        "requires_post_review_user_execute",
        "requires_passed_materialization_summary",
        "requires_market_cap_raw_root_gitignored",
        "requires_prior_full_main_board_audit_pass",
        "requires_unspent_singleton_ledger"
      ],
      "properties": {
        "requires_independent_review_pass": {"const": true},
        "requires_post_review_user_execute": {"const": true},
        "requires_passed_materialization_summary": {"const": true},
        "requires_market_cap_raw_root_gitignored": {"const": true},
        "requires_prior_full_main_board_audit_pass": {"const": true},
        "requires_unspent_singleton_ledger": {"const": true}
      }
    },
    "prohibitedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_call_executed",
        "signal_search_authorized",
        "signal_search_executed",
        "a_long_alpha_found",
        "production_ready",
        "ship_gate_evidence",
        "full_size_allowed",
        "datahub_authorized",
        "broker_or_order_automation_authorized"
      ],
      "properties": {
        "provider_call_executed": {"const": false},
        "signal_search_authorized": {"const": false},
        "signal_search_executed": {"const": false},
        "a_long_alpha_found": {"const": false},
        "production_ready": {"const": false},
        "ship_gate_evidence": {"const": false},
        "full_size_allowed": {"const": false},
        "datahub_authorized": {"const": false},
        "broker_or_order_automation_authorized": {"const": false}
      }
    }
  }
}
