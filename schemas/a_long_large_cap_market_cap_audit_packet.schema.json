    "date8": {"type": "string", "pattern": "^[0-9]{8}$"},
    "docRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/nonEmptyString"},
          "role": {"$ref": "#/$defs/nonEmptyString"}
        }
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "purpose",
        "lane_id",
        "market",
        "research_only",
        "ready_for_later_execution_after_independent_review",
        "actual_audit_requires_post_review_execute_command",
        "local_raw_audit_allowed_after_gates",
        "provider_calls_executed_by_this_artifact",
        "tushare_calls_executed_by_this_artifact",
        "data_fetch_executed_by_this_artifact",
        "raw_payloads_read_by_this_artifact",
        "signal_search_allowed",
        "alpha_backtest_allowed",
        "datahub_allowed",
        "production_use_allowed",
        "ship_gate_claim_allowed",
        "full_size_manual_use_allowed",
        "broker_or_order_automation_allowed",
        "manual_order_only"
      ],
      "properties": {
        "phase": {"const": "7a_alpha_validation"},
        "purpose": {"const": "a_long_large_cap_market_cap_audit_packet"},
        "lane_id": {"const": "a_long"},
        "market": {"const": "A-share"},
        "research_only": {"const": true},
        "ready_for_later_execution_after_independent_review": {"const": true},
        "actual_audit_requires_post_review_execute_command": {"const": true},
        "local_raw_audit_allowed_after_gates": {"const": true},
        "provider_calls_executed_by_this_artifact": {"const": false},
        "tushare_calls_executed_by_this_artifact": {"const": false},
        "data_fetch_executed_by_this_artifact": {"const": false},
        "raw_payloads_read_by_this_artifact": {"const": false},
        "signal_search_allowed": {"const": false},
        "alpha_backtest_allowed": {"const": false},
        "datahub_allowed": {"const": false},
        "production_use_allowed": {"const": false},
        "ship_gate_claim_allowed": {"const": false},
        "full_size_manual_use_allowed": {"const": false},
        "broker_or_order_automation_allowed": {"const": false},
        "manual_order_only": {"const": true}
      }
