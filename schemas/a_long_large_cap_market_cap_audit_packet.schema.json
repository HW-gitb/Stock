{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/a_long_large_cap_market_cap_audit_packet/1.0.0/schema.json",
  "title": "A-long Large-Cap Market-Cap Audit Packet",
  "description": "Review-only packet for the local-only audit of the already-materialized A-long large-cap monthly market-cap raw payloads. It authorizes no network calls, signal search, alpha claim, production use, ship-gate evidence, full-size use, DataHub work, or broker/order automation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "artifact_id",
    "scope",
    "source_doc_refs",
    "input_boundary",
    "audit_boundary",
    "audit_checks",
    "output_contract",
    "pre_execution_gates",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_large_cap_market_cap_audit_packet"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_large_cap_market_cap_audit_packet_20260607"},
    "scope": {"$ref": "#/$defs/scope"},
    "source_doc_refs": {"$ref": "#/$defs/docRefs"},
    "input_boundary": {"$ref": "#/$defs/inputBoundary"},
    "audit_boundary": {"$ref": "#/$defs/auditBoundary"},
    "audit_checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/auditCheck"}
    },
    "output_contract": {"$ref": "#/$defs/outputContract"},
    "pre_execution_gates": {"$ref": "#/$defs/preExecutionGates"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "limitations": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
