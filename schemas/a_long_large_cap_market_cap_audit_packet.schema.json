        "sw_repair_summary_ref": {"const": "docs/a_long_main_board_sw_coverage_repair_execution_summary_20260604.json"},
        "preregistration_ref": {"const": "research/preregistrations/a_long_large_cap_pure_quality_20260607.json"},
        "ledger_ref": {"const": "research/ledgers/a_long_large_cap_pure_quality_program_test_budget_ledger_20260607.json"}
      }
    },
    "auditBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialization_id",
        "selected_market_cap_field",
        "universe_size_n",
        "board_scope",
        "main_board_filter_source",
        "monthly_as_of_count",
        "monthly_as_of_dates",
        "same_as_materialization_dates",
        "prior_audited_universe_bridge_required",
        "size_bucket_count",
        "minimum_size_bucket_count_for_primary_percentile",
        "top500_symbols_written_to_tracked_report",
        "not_signal_search"
      ],
      "properties": {
        "materialization_id": {"const": "a_long_large_cap_market_cap_top500_monthly_2018_2025"},
        "selected_market_cap_field": {"const": "circ_mv"},
        "universe_size_n": {"const": 500},
        "board_scope": {"const": "main_board_only"},
        "main_board_filter_source": {"const": "engine.data.a_share_board_scope.is_main_board_ts_code"},
