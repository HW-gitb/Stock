        {"if": {"required": ["factor_id"], "properties": {"factor_id": {"const": "low_asset_growth"}}}, "then": {"required": ["family", "definition", "input_fields", "ttm_required", "canonical_label_disclaimer"], "properties": {"family": {"const": "investment"}, "definition": {"const": "negative_year_over_year_growth_in_pit_total_assets"}, "input_fields": {"const": ["balancesheet.total_assets"]}, "ttm_required": {"const": false}, "canonical_label_disclaimer": {"const": "ff5_cma_investment_low_is_good_sign_flipped_to_high_score"}}}},
        {"if": {"required": ["factor_id"], "properties": {"factor_id": {"const": "roa_ttm"}}}, "then": {"required": ["family", "definition", "input_fields", "ttm_required", "canonical_label_disclaimer"], "properties": {"family": {"const": "profitability"}, "definition": {"const": "ttm_net_income_attr_p_div_average_total_assets"}, "input_fields": {"const": ["income.n_income_attr_p", "balancesheet.total_assets"]}, "ttm_required": {"const": true}, "canonical_label_disclaimer": {"const": "roa_proxy_not_novy_marx_gross_or_ff5_operating_profitability_those_fields_not_materialized_lowest_novelty_overlaps_prior_roe_quality"}}}},
        {"if": {"required": ["factor_id"], "properties": {"factor_id": {"const": "low_beta"}}}, "then": {"required": ["family", "definition", "input_fields", "trailing_window_trading_days", "ttm_required", "canonical_label_disclaimer"], "properties": {"family": {"const": "low_risk"}, "definition": {"const": "negative_ols_beta_of_daily_total_return_on_csi300_total_return_over_trailing_252_trading_days"}, "input_fields": {"const": ["daily.close", "adj_factor.adj_factor", "csi300_index_close"]}, "trailing_window_trading_days": {"const": 252}, "ttm_required": {"const": false}, "canonical_label_disclaimer": {"const": "bab_direction_low_beta_high_score_distinct_from_falsified_total_vol_low_volatility_but_correlated"}}}},
