{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_provisional_theme_validation.schema.json",
  "title": "US-short provisional cross-industry theme validation artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "generated_at", "decision_clock",
    "validation_contract", "input_artifacts", "source_ref_types", "themes", "drop_ledger", "summary"
  ],
  "properties": {
    "schema_name": {"const": "us_short_provisional_theme_validation"},
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "decision_clock": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_decision_date", "candidate_price_basis_date", "universe_used_date", "classification_source_as_of", "cutoff_policy", "pit_enforced"],
      "properties": {
        "expected_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "candidate_price_basis_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "universe_used_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "classification_source_as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "cutoff_policy": {"const": "before_decision_open_et"},
        "pit_enforced": {"const": true}
      }
    },
    "validation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_kind", "input_mode", "membership_status", "market_confirmation_status", "scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "dynamic_seats_enabled", "theme_probe_enabled", "lifecycle_actions_enabled"],
      "properties": {
        "producer_kind": {"const": "provisional_theme_validate"},
        "input_mode": {"const": "offline_local_artifacts"},
        "membership_status": {"const": "provisional_validated"},
        "market_confirmation_status": {"const": "not_run"},
        "scoring_eligible": {"const": false},
        "top15_effect_enabled": {"const": false},
        "operation_advice_effect_enabled": {"const": false},
        "dynamic_seats_enabled": {"const": false},
        "theme_probe_enabled": {"const": false},
        "lifecycle_actions_enabled": {"const": false}
      }
    },
    "input_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery_artifact_sha256", "candidate_artifact_sha256", "classification_packet_sha256", "eligible_ticker_count", "classification_ticker_count"],
      "properties": {
        "discovery_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "classification_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "eligible_ticker_count": {"type": "integer", "minimum": 0},
        "classification_ticker_count": {"type": "integer", "minimum": 0}
      }
    },
    "source_ref_types": {
      "type": "object", "additionalProperties": false,
      "patternProperties": {"^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$": {"enum": ["web", "x", "llm"]}},
      "minProperties": 1
    },
    "themes": {"type": "array", "maxItems": 8, "items": {"$ref": "#/definitions/validated_theme"}},
    "drop_ledger": {"type": "array", "items": {"$ref": "#/definitions/drop"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["discovered_theme_count", "validated_theme_count", "validated_member_count", "rejected_theme_count", "dropped_member_count", "truncated_theme_count"],
      "properties": {
        "discovered_theme_count": {"type": "integer", "minimum": 0},
        "validated_theme_count": {"type": "integer", "minimum": 0},
        "validated_member_count": {"type": "integer", "minimum": 0},
        "rejected_theme_count": {"type": "integer", "minimum": 0},
        "dropped_member_count": {"type": "integer", "minimum": 0},
        "truncated_theme_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}},
      "then": {"properties": {"themes": {"items": {"required": ["semantic_validation"]}}}}
    }
  ],
  "definitions": {
    "validated_theme": {
      "type": "object", "additionalProperties": false,
      "required": ["theme_id", "display_name", "summary", "status", "observed_at", "source_ref_ids", "members", "cross_industry_validation_status", "market_confirmation_status", "validation"],
      "properties": {
        "theme_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "status": {"const": "provisional_validated"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_ref_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "cross_industry_validation_status": {"const": "validated_by_sec_sic_major_group"},
        "market_confirmation_status": {"const": "not_run"},
        "validation": {
          "type": "object", "additionalProperties": false,
          "required": ["selection_rank", "qualified_member_count", "industry_count", "industry_codes", "source_type_counts"],
          "properties": {
            "selection_rank": {"type": "integer", "minimum": 1, "maximum": 8},
            "qualified_member_count": {"type": "integer", "minimum": 3},
            "industry_count": {"type": "integer", "minimum": 2},
            "industry_codes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
            "source_type_counts": {
              "type": "object", "additionalProperties": false,
              "required": ["web", "x", "both"],
              "properties": {
                "web": {"type": "integer", "minimum": 0},
                "x": {"type": "integer", "minimum": 0},
                "both": {"type": "integer", "minimum": 0}
              }
            },
            "distinct_web_x_source_ref_count": {"type": "integer", "minimum": 0}
          }
        },
        "semantic_validation": {"$ref": "#/definitions/semantic_validation"},
        "members": {"type": "array", "minItems": 3, "items": {"$ref": "#/definitions/member"}}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "membership_status", "source_ref_ids", "source_types", "evidence_tier", "industry_code", "industry_source"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
        "membership_status": {"const": "provisional_validated"},
        "source_ref_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["web", "x"]}},
        "evidence_tier": {"enum": ["both", "single"]},
        "industry_code": {"type": "string", "pattern": "^[0-9]{2}$"},
        "industry_source": {"const": "sec_sic_major_group"}
      },
      "oneOf": [
        {"properties": {"source_types": {"const": ["web", "x"]}, "evidence_tier": {"const": "both"}}},
        {"properties": {"source_types": {"enum": [["web"], ["x"]]}, "evidence_tier": {"const": "single"}}}
      ]
    },
    "drop": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "theme_id", "reason"],
      "properties": {
        "stage": {"enum": ["member", "theme", "truncation"]},
        "theme_id": {"type": "string"},
        "ticker": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "candidate_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_source_type", "origin_scope_type", "origin_scope_index"],
      "properties": {
        "origin_source_type": {"enum": ["web", "x"]},
        "origin_scope_type": {"enum": ["web_chunk", "x_response"]},
        "origin_scope_index": {"type": "integer", "minimum": 0},
        "linked_tickers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"}}
      },
      "allOf": [
        {"if": {"properties": {"origin_source_type": {"const": "web"}}}, "then": {"properties": {"origin_scope_type": {"const": "web_chunk"}}}, "else": {"properties": {"origin_scope_type": {"const": "x_response"}}}}
      ]
    },
    "passing_origin": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_source_type", "origin_scope_type", "origin_scope_index", "linked_tickers"],
      "properties": {
        "origin_source_type": {"enum": ["web", "x"]},
        "origin_scope_type": {"enum": ["web_chunk", "x_response"]},
        "origin_scope_index": {"type": "integer", "minimum": 0},
        "linked_tickers": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"}}
      },
      "allOf": [
        {"if": {"properties": {"origin_source_type": {"const": "web"}}}, "then": {"properties": {"origin_scope_type": {"const": "web_chunk"}}}, "else": {"properties": {"origin_scope_type": {"const": "x_response"}}}}
      ]
    },
    "semantic_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "anchor_origin", "passing_origins", "semantically_linked_qualified_member_count", "semantically_linked_sec_sic_industry_count", "passing_source_ref_ids", "final_member_tickers"],
      "properties": {
        "status": {"const": "validated_shared_commercial_driver"},
        "anchor_origin": {"$ref": "#/definitions/origin"},
        "passing_origins": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/passing_origin"}},
        "semantically_linked_qualified_member_count": {"type": "integer", "minimum": 3},
        "semantically_linked_sec_sic_industry_count": {"type": "integer", "minimum": 2},
        "passing_source_ref_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "final_member_tickers": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"}}
      }
    }
  }
}
