{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_theme_source_summary.schema.json",
  "title": "US-short Batch5 theme/GICS source runner summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "schema_ref",
    "generated_at",
    "scope",
    "decision_clock",
    "sample_universe",
    "paths",
    "storage",
    "theme_source",
    "projection_contract",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_theme_source_summary" },
    "schema_version": { "const": "1.0.0" },
    "schema_ref": { "const": "schemas/us_short_batch5_theme_source_summary.schema.json" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "route",
        "batch",
        "purpose",
        "status",
        "network_access_performed_by_runner",
        "provider_calls_performed_by_runner",
        "raw_payload_storage_performed_by_runner",
        "source_packet_consumed",
        "theme_projection_written",
        "datahub_consumption_performed",
        "production_storage_performed",
        "full_market_call_performed",
        "yfinance_consumption_performed",
        "broker_or_order_execution_performed",
        "ship_gate_or_live_normalized_evidence_claimed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "market": { "const": "US" },
        "route": { "const": "US-short" },
        "batch": { "const": "batch5" },
        "purpose": { "const": "local_full_gics_and_theme_source_to_projection" },
        "status": { "const": "theme_projection_written" },
        "network_access_performed_by_runner": { "const": false },
        "provider_calls_performed_by_runner": { "const": false },
        "raw_payload_storage_performed_by_runner": { "const": false },
        "source_packet_consumed": { "const": true },
        "theme_projection_written": { "const": true },
        "datahub_consumption_performed": { "const": false },
        "production_storage_performed": { "const": false },
        "full_market_call_performed": { "const": false },
        "yfinance_consumption_performed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "ship_gate_or_live_normalized_evidence_claimed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "candidate_price_basis_date", "price_basis_date", "source_as_of"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "candidate_price_basis_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "price_basis_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "sample_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_source",
        "symbols",
        "max_symbols",
        "full_market_sample",
        "candidate_artifact_row_count",
        "candidate_artifact_eligible_count"
      ],
      "properties": {
        "symbol_source": { "const": "caller_selected_from_validated_candidate_artifact" },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
        },
        "max_symbols": { "const": 3 },
        "full_market_sample": { "const": false },
        "candidate_artifact_row_count": { "type": "integer", "minimum": 1 },
        "candidate_artifact_eligible_count": { "type": "integer", "minimum": 1 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_artifact_path", "source_packet_path", "output_projection_path", "summary_path"],
      "properties": {
        "candidate_artifact_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "source_packet_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "output_projection_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "summary_path": {
          "type": "string",
          "pattern": "^(docs/us_short_batch5_theme_source_summary_20260705\\.json|provider_samples/us_short_batch5_theme_source_20260705/.+\\.json)$",
          "not": { "pattern": "\\.\\." }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_packet_path_gitignored",
        "output_projection_path_gitignored",
        "summary_path_gitignored",
        "summary_contains_price_rows",
        "summary_contains_raw_payload",
        "summary_contains_request_urls",
        "summary_contains_secrets"
      ],
      "properties": {
        "source_packet_path_gitignored": { "const": true },
        "output_projection_path_gitignored": { "const": true },
        "summary_path_gitignored": { "type": "boolean" },
        "summary_contains_price_rows": { "const": false },
        "summary_contains_raw_payload": { "const": false },
        "summary_contains_request_urls": { "const": false },
        "summary_contains_secrets": { "const": false }
      }
    },
    "theme_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "industry_member_count",
        "selected_symbol_count",
        "theme_count",
        "theme_member_count",
        "benchmark_symbols",
        "session",
        "adjustment_mode",
        "min_points_per_series",
        "full_gics_peer_pool_consumed",
        "provisional_theme_membership_consumed",
        "selected_symbol_only_membership_rejected",
        "scored_sector_count",
        "insufficient_sector_count",
        "scored_theme_count",
        "insufficient_theme_count"
      ],
      "properties": {
        "industry_member_count": { "type": "integer", "minimum": 2, "maximum": 20000 },
        "selected_symbol_count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "theme_count": { "type": "integer", "minimum": 0, "maximum": 500 },
        "theme_member_count": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "benchmark_symbols": { "const": ["SPY", "QQQ"] },
        "session": { "const": "RTH" },
        "adjustment_mode": { "const": "split_div_adjusted" },
        "min_points_per_series": { "type": "integer", "minimum": 64, "maximum": 3000 },
        "full_gics_peer_pool_consumed": { "const": true },
        "provisional_theme_membership_consumed": { "const": true },
        "selected_symbol_only_membership_rejected": { "const": true },
        "scored_sector_count": { "type": "integer", "minimum": 0 },
        "insufficient_sector_count": { "type": "integer", "minimum": 0 },
        "scored_theme_count": { "type": "integer", "minimum": 0 },
        "insufficient_theme_count": { "type": "integer", "minimum": 0 }
      }
    },
    "projection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "theme_scored_count",
        "neutral_fill_count",
        "real_theme_or_gics_source_consumed",
        "full_gics_peer_pool_consumed",
        "selected_symbol_only_membership_rejected"
      ],
      "properties": {
        "target_count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "theme_scored_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "neutral_fill_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "real_theme_or_gics_source_consumed": { "const": true },
        "full_gics_peer_pool_consumed": { "const": true },
        "selected_symbol_only_membership_rejected": { "const": true }
      }
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selected",
        "full_market_download_performed",
        "yfinance_used",
        "paid_access_used",
        "datahub_consumed",
        "production_readiness_claimed",
        "ship_gate_evidence_claimed",
        "live_normalized_evidence_claimed",
        "broker_or_order_execution_performed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "provider_selected": { "const": false },
        "full_market_download_performed": { "const": false },
        "yfinance_used": { "const": false },
        "paid_access_used": { "const": false },
        "datahub_consumed": { "const": false },
        "production_readiness_claimed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "live_normalized_evidence_claimed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
