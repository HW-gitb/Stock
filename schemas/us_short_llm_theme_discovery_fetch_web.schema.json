{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_llm_theme_discovery_fetch_web.schema.json",
  "title": "US-short bounded Tavily web discovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "decision_clock", "fetch_contract", "queries", "source_refs", "discovery_artifact_sha256", "drop_ledger", "summary"],
  "properties": {
    "schema_name": {"const": "us_short_llm_theme_discovery_fetch_web"},
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "decision_clock": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_decision_date", "cutoff_policy", "pit_enforced"],
      "properties": {"expected_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "cutoff_policy": {"const": "before_decision_open_et"}, "pit_enforced": {"const": true}}
    },
    "fetch_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_kind", "execution_mode", "network_access_performed", "provider_calls_performed", "network_call_count", "provider_call_count", "transport_response_counts", "scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "dynamic_seats_enabled", "theme_probe_enabled", "lifecycle_actions_enabled", "regroup_model"],
      "properties": {
        "producer_kind": {"const": "tavily_deepseek_web_fetch"},
        "execution_mode": {"enum": ["offline_fake_client", "live_authorized"]},
        "network_access_performed": {"type": "boolean"}, "provider_calls_performed": {"type": "boolean"}, "network_call_count": {"type": "integer", "minimum": 0}, "provider_call_count": {"type": "integer", "minimum": 0},
        "transport_response_counts": {"type": "object", "additionalProperties": false, "required": ["tavily", "deepseek"], "properties": {"tavily": {"type": "integer", "minimum": 0}, "deepseek": {"type": "integer", "minimum": 0}}},
        "regroup_chunk_counts": {"type": "object", "additionalProperties": false, "required": ["attempted", "successful", "failed", "failed_indexes"], "properties": {"attempted": {"type": "integer", "minimum": 0}, "successful": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "failed_indexes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}},
        "scoring_eligible": {"const": false}, "top15_effect_enabled": {"const": false}, "operation_advice_effect_enabled": {"const": false}, "dynamic_seats_enabled": {"const": false}, "theme_probe_enabled": {"const": false}, "lifecycle_actions_enabled": {"const": false},
        "regroup_model": {"type": "object", "additionalProperties": false, "required": ["requested_model", "served_model", "system_fingerprints"], "properties": {"requested_model": {"const": "deepseek-chat"}, "served_model": {"type": ["string", "null"]}, "system_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}
      },
      "allOf": [
        {"if": {"properties": {"execution_mode": {"const": "live_authorized"}}}, "then": {"properties": {"network_access_performed": {"const": true}, "provider_calls_performed": {"const": true}, "network_call_count": {"minimum": 1}, "provider_call_count": {"minimum": 1}}}},
        {"if": {"properties": {"execution_mode": {"const": "offline_fake_client"}}}, "then": {"properties": {"network_access_performed": {"const": false}, "provider_calls_performed": {"const": false}, "network_call_count": {"const": 0}, "provider_call_count": {"const": 0}}}}
      ]
    },
    "queries": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "plan_binding": {"$ref": "#/definitions/plan_binding"},
    "source_refs": {"type": "array", "items": {"$ref": "#/definitions/source_ref"}},
    "provider_response_refs": {"type": "array", "items": {"$ref": "#/definitions/provider_response_ref"}},
    "member_binding_ledger": {"type": "array", "items": {"$ref": "#/definitions/member_binding_row"}},
    "member_binding_summary": {"$ref": "#/definitions/member_binding_summary"},
    "discovery_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "drop_ledger": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage", "reason", "detail"], "properties": {"stage": {"enum": ["search_result", "llm"]}, "reason": {"type": "string", "minLength": 1}, "detail": {"type": "string"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["query_count", "accepted_source_count", "validated_theme_count", "validated_member_count", "dropped_result_count", "prompt_source_count"], "properties": {"query_count": {"type": "integer", "minimum": 0}, "accepted_source_count": {"type": "integer", "minimum": 0}, "validated_theme_count": {"type": "integer", "minimum": 0}, "validated_member_count": {"type": "integer", "minimum": 0}, "dropped_result_count": {"type": "integer", "minimum": 0}, "prompt_source_count": {"type": "integer", "minimum": 0}}}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "1.1.0"}}}, "then": {"required": ["provider_response_refs"]}},
    {"if": {"properties": {"schema_version": {"const": "1.2.0"}}}, "then": {"required": ["provider_response_refs", "member_binding_ledger", "member_binding_summary"]}}
  ],
  "definitions": {
    "member_binding_row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "chunk_index", "theme_index_in_chunk", "member_index_in_theme", "theme_id",
        "raw_ticker", "canonical_ticker", "claimed_source_ref_ids", "malformed_source_ref_count",
        "known_source_ref_ids", "unknown_source_ref_ids", "outside_theme_source_ref_ids",
        "bound_source_ref_ids", "ticker_token_check_status", "ticker_token_source_ref_ids",
        "binding_status", "binding_reason", "parent_theme_status", "parent_theme_reason"
      ],
      "properties": {
        "chunk_index": {"type": "integer", "minimum": 0},
        "theme_index_in_chunk": {"type": "integer", "minimum": 0},
        "member_index_in_theme": {"type": "integer", "minimum": 0},
        "theme_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
        "raw_ticker": {"type": "string", "maxLength": 12},
        "canonical_ticker": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
        "claimed_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "malformed_source_ref_count": {"type": "integer", "minimum": 0},
        "known_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unknown_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "outside_theme_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "bound_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "ticker_token_check_status": {"enum": ["observed", "not_observed", "not_checkable"]},
        "ticker_token_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "binding_status": {"enum": ["accepted", "rejected"]},
        "binding_reason": {"enum": [
          "accepted_member_binding", "malformed_member", "invalid_canonical_us_ticker",
          "duplicate_member_ticker", "malformed_member_source_refs",
          "member_source_ref_not_in_chunk_sources", "member_source_ref_outside_theme_refs",
          "member_without_bound_source_refs", "member_source_after_theme_observation"
        ]},
        "parent_theme_status": {"enum": ["accepted", "rejected"]},
        "parent_theme_reason": {"type": ["string", "null"]}
      }
    },
    "member_binding_summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "parsed_chunk_indexes", "unparsed_chunk_indexes", "member_claim_count",
        "accepted_binding_count", "rejected_binding_count", "accepted_parent_theme_member_count",
        "rejected_parent_theme_member_count", "binding_reason_counts"
      ],
      "properties": {
        "parsed_chunk_indexes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "unparsed_chunk_indexes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "member_claim_count": {"type": "integer", "minimum": 0},
        "accepted_binding_count": {"type": "integer", "minimum": 0},
        "rejected_binding_count": {"type": "integer", "minimum": 0},
        "accepted_parent_theme_member_count": {"type": "integer", "minimum": 0},
        "rejected_parent_theme_member_count": {"type": "integer", "minimum": 0},
        "binding_reason_counts": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "accepted_member_binding": {"type": "integer", "minimum": 0},
            "malformed_member": {"type": "integer", "minimum": 0},
            "invalid_canonical_us_ticker": {"type": "integer", "minimum": 0},
            "duplicate_member_ticker": {"type": "integer", "minimum": 0},
            "malformed_member_source_refs": {"type": "integer", "minimum": 0},
            "member_source_ref_not_in_chunk_sources": {"type": "integer", "minimum": 0},
            "member_source_ref_outside_theme_refs": {"type": "integer", "minimum": 0},
            "member_without_bound_source_refs": {"type": "integer", "minimum": 0},
            "member_source_after_theme_observation": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "plan_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["parent_plan_identity", "provider", "stage", "parent_plan_artifact", "stage1_queries", "provider_envelope"],
      "properties": {
        "parent_plan_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider": {"const": "web"}, "stage": {"const": "stage1"},
        "parent_plan_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "stage1_queries": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"type": "object", "additionalProperties": false, "required": ["query_id", "stage", "query_text_sha256"], "properties": {"query_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"}, "stage": {"const": "stage1"}, "query_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        },
        "provider_envelope": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "stage1_max_dispatch_count", "stage2_max_dispatch_count", "retry_max_dispatch_count", "max_dispatch_count"],
          "properties": {
            "provider": {"const": "web"}, "stage1_max_dispatch_count": {"type": "integer", "minimum": 0}, "stage2_max_dispatch_count": {"type": "integer", "minimum": 0}, "retry_max_dispatch_count": {"type": "integer", "minimum": 0}, "max_dispatch_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_type", "canonical_locator", "observed_at", "fetched_at", "content_sha256", "raw_receipt_ref", "raw_receipt_gitignored"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^web:[0-9a-f]{64}$"}, "source_type": {"const": "web"},
        "canonical_locator": {"type": "string", "pattern": "^https?://[^\\s]+$"}, "observed_at": {"type": "string", "format": "date-time"}, "fetched_at": {"type": "string", "format": "date-time"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_receipt_ref": {"type": ["string", "null"], "pattern": "^provider_samples/[^\\s]+$"}, "raw_receipt_gitignored": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"raw_receipt_ref": {"type": "string"}}}, "then": {"properties": {"raw_receipt_gitignored": {"const": true}}} }]
    },
    "provider_response_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "chunk_index", "requested_model", "served_model", "finish_reason", "usage", "system_fingerprint", "max_tokens_requested", "response_format", "response_sha256", "fetched_at", "raw_receipt_ref", "raw_receipt_gitignored"],
      "properties": {
        "provider": {"const": "deepseek"},
        "chunk_index": {"type": "integer", "minimum": 0},
        "requested_model": {"const": "deepseek-chat"},
        "served_model": {"type": ["string", "null"]},
        "finish_reason": {"type": ["string", "null"]},
        "usage": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "prompt_tokens": {"type": "integer", "minimum": 0},
            "completion_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        },
        "system_fingerprint": {"type": ["string", "null"]},
        "max_tokens_requested": {"const": 16384},
        "response_format": {"const": "json_object"},
        "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "raw_receipt_ref": {"type": "string", "pattern": "^provider_samples/[^\\s]+$"},
        "raw_receipt_gitignored": {"const": true}
      }
    }
  }
}
