{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_sec_sic_classification_snapshot.schema.json",
  "title": "US-short immutable SEC SIC classification snapshot",
  "description": "Private immutable CIK-keyed SEC SIC major-group snapshot. It is reusable only when observed before the target decision open and within the runner's fixed freshness limit; it never authorizes future backfill into an earlier decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "snapshot_id", "classification_source", "parser_version", "observed_at", "source_as_of", "entries"],
  "properties": {
    "schema_name": {"const": "us_short_batch5_sec_sic_classification_snapshot"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification_source": {"const": "sec_sic_major_group"},
    "parser_version": {"const": "1.0.0"},
    "observed_at": {"type": "string", "minLength": 1},
    "source_as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cik", "tickers", "sector"],
        "properties": {
          "cik": {"type": "integer", "minimum": 1},
          "tickers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "sector": {"type": "string", "pattern": "^[0-9]{2}$"}
        }
      }
    }
  }
}
