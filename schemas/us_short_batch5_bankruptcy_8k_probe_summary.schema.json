        "production_ready_claimed",
        "broker_or_order_automation"
      ],
      "properties": {
        "provider_selected": {"const": false},
        "full_market_application_performed": {"const": false},
        "bankruptcy_8k_full_universe_scanned": {"const": false},
        "status_records_runner_consumable": {"const": false},
        "candidate_artifact_written": {"const": false},
        "datahub_or_adapter_implemented": {"const": false},
        "production_runner_consumption_authorized": {"const": false},
        "live_normalized_evidence_claimed": {"const": false},
