            "AAPL": {"$ref": "#/$defs/symbolShape"},
            "MSFT": {"$ref": "#/$defs/symbolShape"},
            "JPM": {"$ref": "#/$defs/symbolShape"}
          }
        }
      }
    },
    "symbolShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_shape_valid",
        "recent_fields_present",
        "recent_array_lengths_equal",
        "recent_row_count",
        "form_8k_count",
        "item_103_candidate_count",
        "parser_status",
        "bankruptcy_screen_status",
        "filing_accession_if_found"
      ],
      "properties": {
        "submission_shape_valid": {"type": "boolean"},
        "recent_fields_present": {"$ref": "#/$defs/recentFields"},
        "recent_array_lengths_equal": {"$ref": "#/$defs/boolOrNull"},
        "recent_row_count": {"$ref": "#/$defs/intOrNull"},
        "form_8k_count": {"$ref": "#/$defs/nonNegativeInt"},
        "item_103_candidate_count": {"$ref": "#/$defs/nonNegativeInt"},
        "parser_status": {"enum": ["ok", "error", "not_fetched"]},
        "bankruptcy_screen_status": {"enum": ["bankrupt_8k_found", "screened_no_filing", "parser_error", "not_fetched"]},
        "filing_accession_if_found": {"$ref": "#/$defs/secAccessionOrNull"}
      }
    },
    "aggregateShapeMetrics": {
      "type": "object",
      "additionalProperties": false,
