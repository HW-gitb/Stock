        "symbols": {"const": ["AAPL", "MSFT", "JPM"]},
        "cik_by_symbol": {"const": {"AAPL": 320193, "MSFT": 789019, "JPM": 19617}},
        "max_symbols": {"const": 3},
        "universe_role": {"const": "bounded_shape_validation_sample_not_runner_consumable"}
