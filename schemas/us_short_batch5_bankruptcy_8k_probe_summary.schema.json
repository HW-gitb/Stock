      "properties": {
        "endpoint_success_count": {"$ref": "#/$defs/nonNegativeInt"},
        "endpoint_error_count": {"$ref": "#/$defs/nonNegativeInt"},
        "shape_valid_symbol_count": {"$ref": "#/$defs/nonNegativeInt"},
        "parser_ok_symbol_count": {"$ref": "#/$defs/nonNegativeInt"},
        "bankruptcy_8k_positive_count": {"$ref": "#/$defs/nonNegativeInt"}
      }
    },
    "validationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "sr_provider_001_closed", "runner_consumption_allowed", "rationale"],
      "properties": {
        "decision": {
          "enum": [
            "bounded_bankruptcy_8k_shape_probe_completed_keep_sr_provider_001_open",
            "bounded_bankruptcy_8k_shape_probe_completed_with_errors_keep_sr_provider_001_open"
          ]
        },
        "sr_provider_001_closed": {"const": false},
        "runner_consumption_allowed": {"const": false},
        "rationale": {"type": "string", "minLength": 1}
      }
