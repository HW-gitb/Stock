      "properties": {
        "market": {"const": "US"},
        "lane": {"const": "us_short"},
        "batch": {"const": "batch5_provider_live"},
        "purpose": {"const": "small_sample_bankruptcy_8k_company_submissions_shape_probe"},
        "probe_status": {"enum": ["completed", "completed_with_endpoint_errors"]},
        "bankruptcy_8k_probe_performed": {"const": true},
        "status_source_calls_performed": {"const": true},
        "sec_company_submissions_calls_performed": {"const": true},
        "validation_only_parse_performed": {"const": true},
        "raw_storage_performed": {"const": true},
        "tracked_summary_written": {"const": true},
        "status_records_written": {"const": false},
        "run_fetch_bankruptcy_wiring_performed": {"const": false},
        "full_market_application_performed": {"const": false},
        "candidate_artifact_written": {"const": false},
        "candidate_artifact_schema_changed": {"const": false},
        "runner_consumption_allowed": {"const": false},
        "datahub_consumption_allowed": {"const": false},
        "production_storage_allowed": {"const": false},
        "provider_selection_allowed": {"const": false},
        "live_normalized_evidence_claimed": {"const": false},
        "ship_gate_evidence_claimed": {"const": false},
        "production_ready_claimed": {"const": false},
        "broker_or_order_automation": {"const": false}
      }
    },
    "preExecutionChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_packet_validated",
        "offline_preflight_reused",
        "user_authorization_confirmed",
        "post_preflight_execute_confirmed",
        "provider_samples_gitignore_confirmed",
        "raw_root_under_approved_provider_samples",
        "environment_precheck_passed",
        "sec_fair_access_user_agent_present",
        "exact_endpoint_confirmation_passed",
        "budget_precheck_passed",
        "parser_shape_validation_passed",
        "no_full_market_application_guard_passed",
        "no_run_fetch_wiring_guard_passed",
        "no_datahub_consumption_guard_passed",
        "no_ship_gate_claim_guard_passed"
      ],
      "properties": {
        "access_packet_validated": {"const": true},
        "offline_preflight_reused": {"const": true},
        "user_authorization_confirmed": {"const": true},
        "post_preflight_execute_confirmed": {"const": true},
        "provider_samples_gitignore_confirmed": {"const": true},
        "raw_root_under_approved_provider_samples": {"const": true},
        "environment_precheck_passed": {"const": true},
        "sec_fair_access_user_agent_present": {"const": true},
        "exact_endpoint_confirmation_passed": {"const": true},
        "budget_precheck_passed": {"const": true},
        "parser_shape_validation_passed": {"type": "boolean"},
        "no_full_market_application_guard_passed": {"const": true},
        "no_run_fetch_wiring_guard_passed": {"const": true},
        "no_datahub_consumption_guard_passed": {"const": true},
        "no_ship_gate_claim_guard_passed": {"const": true}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sec_fair_access_user_agent_present",
        "sec_fair_access_user_agent_source",
        "environment_values_logged",
