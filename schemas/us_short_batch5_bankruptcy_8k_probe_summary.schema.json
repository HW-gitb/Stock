        "status_records_written",
        "run_fetch_bankruptcy_wiring_performed",
        "full_market_application_performed",
        "candidate_artifact_written",
        "candidate_artifact_schema_changed",
        "runner_consumption_allowed",
        "datahub_consumption_allowed",
        "production_storage_allowed",
        "provider_selection_allowed",
        "live_normalized_evidence_claimed",
        "ship_gate_evidence_claimed",
        "production_ready_claimed",
        "broker_or_order_automation"
