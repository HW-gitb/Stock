      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "cik": {"$ref": "#/$defs/cik"},
        "source_id": {"const": "sec_8k_item_103"},
        "provider_id": {"const": "sec_edgar"},
        "endpoint_family": {"const": "company_submissions_recent_filings"},
        "status": {"enum": ["ok", "error"]},
        "http_status": {"$ref": "#/$defs/intOrNull"},
        "error_type": {"$ref": "#/$defs/stringOrNull"},
        "raw_sample_ref": {
          "type": "string",
          "pattern": "^provider_samples/us_short_batch5_bankruptcy_8k_20260703/raw/(.*/)?sec_edgar/(AAPL|MSFT|JPM)/company_submissions_recent_filings\\.json$",
          "not": {"pattern": "\\.\\."}
        },
        "raw_sample_ref_gitignored": {"const": true},
        "payload_shape": {"$ref": "#/$defs/payloadShape"},
        "shape_validation_status": {"enum": ["ok", "invalid_or_error"]}
      }
    },
    "payloadShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_type",
        "top_level_key_count",
        "recent_row_count",
        "recent_arrays_equal_length",
        "required_recent_fields_present"
      ],
      "properties": {
        "payload_type": {"enum": ["dict", "list", "str", "bytes", "NoneType"]},
        "top_level_key_count": {"$ref": "#/$defs/intOrNull"},
