{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_batch5_bankruptcy_8k_probe_summary/1.0.0/schema.json",
  "title": "US-short Batch5 Bankruptcy 8-K Probe Summary",
  "description": "Runtime-validated summary for the user-confirmed US-short batch5 bankruptcy 8-K small-sample SEC company-submissions shape probe. It permits exactly three SEC submissions observations, stores raw samples only under gitignored provider_samples, and authorizes no runner/DataHub/production/ship-gate consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "access_packet_ref",
    "authorization_ref",
    "schema_ref",
    "status_as_of",
    "source_observed_at",
    "source_parser_ref",
    "scope",
    "pre_execution_checks",
    "environment",
    "sample_universe",
    "endpoint_call_budget",
    "exact_endpoint_confirmation",
    "storage",
    "endpoint_results",
    "sample_shape_results",
    "aggregate_shape_metrics",
    "validation_decision",
    "prohibited_claims",
    "limitations",
    "next_steps"
  ],
  "properties": {
    "schema_name": {"const": "us_short_batch5_bankruptcy_8k_probe_summary"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "access_packet_ref": {"const": "docs/us_short_batch5_bankruptcy_8k_access_packet_20260703.json"},
    "authorization_ref": {"const": "user_chat_20260703_execute_after_claude_pass"},
    "schema_ref": {"const": "schemas/us_short_batch5_bankruptcy_8k_probe_summary.schema.json"},
    "status_as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_observed_at": {"type": "string", "minLength": 1},
    "source_parser_ref": {"const": "engine.us_short_status_source.build_bankruptcy_screen_from_sec_submissions"},
    "scope": {"$ref": "#/$defs/scope"},
    "pre_execution_checks": {"$ref": "#/$defs/preExecutionChecks"},
    "environment": {"$ref": "#/$defs/environment"},
    "sample_universe": {"$ref": "#/$defs/sampleUniverse"},
    "endpoint_call_budget": {"$ref": "#/$defs/endpointCallBudget"},
    "exact_endpoint_confirmation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/exactEndpoint"},
      "allOf": [
        {"contains": {"type": "object", "required": ["symbol", "cik"], "properties": {"symbol": {"const": "AAPL"}, "cik": {"const": 320193}}}},
        {"contains": {"type": "object", "required": ["symbol", "cik"], "properties": {"symbol": {"const": "MSFT"}, "cik": {"const": 789019}}}},
        {"contains": {"type": "object", "required": ["symbol", "cik"], "properties": {"symbol": {"const": "JPM"}, "cik": {"const": 19617}}}}
      ]
    },
    "storage": {"$ref": "#/$defs/storage"},
    "endpoint_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/endpointResult"},
      "allOf": [
        {"contains": {"type": "object", "required": ["symbol"], "properties": {"symbol": {"const": "AAPL"}}}},
        {"contains": {"type": "object", "required": ["symbol"], "properties": {"symbol": {"const": "MSFT"}}}},
        {"contains": {"type": "object", "required": ["symbol"], "properties": {"symbol": {"const": "JPM"}}}}
      ]
    },
    "sample_shape_results": {"$ref": "#/$defs/sampleShapeResults"},
    "aggregate_shape_metrics": {"$ref": "#/$defs/aggregateShapeMetrics"},
    "validation_decision": {"$ref": "#/$defs/validationDecision"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "next_steps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "$defs": {
    "nonNegativeInt": {"type": "integer", "minimum": 0},
    "intOrNull": {"type": ["integer", "null"], "minimum": 0},
    "boolOrNull": {"type": ["boolean", "null"]},
    "stringOrNull": {"type": ["string", "null"]},
    "secAccessionOrNull": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}
      ]
    },
    "symbol": {"enum": ["AAPL", "MSFT", "JPM"]},
    "cik": {"enum": [320193, 789019, 19617]},
    "recentFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "filingDate", "accessionNumber", "items"],
      "properties": {
        "form": {"type": "boolean"},
        "filingDate": {"type": "boolean"},
        "accessionNumber": {"type": "boolean"},
        "items": {"type": "boolean"}
      }
    },
    "scope": {
