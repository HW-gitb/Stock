{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_account_bundle",
  "description": "Atomic private A-short account snapshot binding the true facts date, account state and lineage in one JSON artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "decision_as_of", "facts_as_of", "snapshot_id", "snapshot_digest", "account", "lineage"],
  "properties": {
    "schema_name": {"const": "a_short_account_bundle"},
    "schema_version": {"const": "1.0.0"},
    "decision_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "facts_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "snapshot_id": {"type": "string", "pattern": "^a-short-account-[0-9]{8}-[0-9a-f]{16}$"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account": {"type": "object"},
    "lineage": {"type": "object"}
  }
}
