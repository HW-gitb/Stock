        "materialization_id": {"const": "a_long_tushare_full_period_panel_2018_2025"},
        "start_date": {"const": "20180101"},
        "end_date": {"const": "20251231"},
        "active_symbols": {
          "type": "array",
          "items": {"enum": ["000001.SZ", "600519.SH", "300750.SZ", "601318.SH", "600036.SH", "000651.SZ", "002415.SZ", "600276.SH"]},
          "minItems": 8,
          "maxItems": 8
        },
        "delisted_symbols": {
          "type": "array",
          "items": {"const": "000666.SZ"},
          "minItems": 1,
          "maxItems": 1
        },
        "benchmark_indices": {
          "type": "array",
          "items": {"enum": ["000300.SH", "000852.SH"]},
          "minItems": 2,
          "maxItems": 2
        },
        "not_full_market": {"const": true},
        "not_full_universe": {"const": true}
      }
    },
    "endpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "table_id",
        "api_family",
        "request_shape_without_token",
        "call_status",
        "row_count",
        "columns",
        "minimum_fields_present",
        "minimum_fields_missing",
        "raw_payload_ref",
        "checkpoint_status",
        "tracked_summary_excludes_raw_rows",
        "error_class",
        "error_message_redacted"
      ],
      "properties": {
        "call_id": {"$ref": "#/$defs/nonEmptyString"},
        "table_id": {"$ref": "#/$defs/nonEmptyString"},
        "api_family": {"$ref": "#/$defs/nonEmptyString"},
        "request_shape_without_token": {"type": "object"},
        "call_status": {"enum": ["success", "empty", "error"]},
        "row_count": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "columns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "minimum_fields_present": {
          "type": "array",
          "items": {"type": "string"}
        },
        "minimum_fields_missing": {
          "type": "array",
          "items": {"type": "string"}
        },
        "raw_payload_ref": {"$ref": "#/$defs/nonEmptyString"},
        "checkpoint_status": {"enum": ["written_new_raw", "reused_existing_raw", "written_paced_refetch_raw", "reused_paced_refetch_raw"]},
        "tracked_summary_excludes_raw_rows": {"const": true},
        "error_class": {"$ref": "#/$defs/nullableString"},
        "error_message_redacted": {"$ref": "#/$defs/nullableString"}
      }
    },
    "tableRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "status", "calls_total", "calls_success", "missing_minimum_fields", "plain_result"],
      "properties": {
        "table_id": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["passed_full_period_panel_shape", "partial_or_failed_full_period_panel_shape", "not_tested"]},
        "calls_total": {"type": "integer", "minimum": 0},
        "calls_success": {"type": "integer", "minimum": 0},
        "missing_minimum_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "plain_result": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialization_status",
        "data_can_be_used_for_alpha_now",
        "audit_rerun_authorized_by_this_summary",
        "signal_search_authorized_by_this_summary",
        "plain_result",
        "next_action"
      ],
      "properties": {
        "materialization_status": {"enum": ["passed_full_period_panel_materialization_shape", "partial_or_failed_full_period_panel_materialization", "not_executed_environment_missing"]},
        "data_can_be_used_for_alpha_now": {"const": false},
        "audit_rerun_authorized_by_this_summary": {"const": false},
        "signal_search_authorized_by_this_summary": {"const": false},
        "plain_result": {"$ref": "#/$defs/nonEmptyString"},
        "next_action": {"$ref": "#/$defs/nonEmptyString"}
      }
