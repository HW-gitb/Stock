{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/a_long_tushare_broader_materialization_execution_summary/1.0.0/schema.json",
  "title": "A-Long Tushare Broader Materialization Execution Summary",
  "description": "Tracked no-secret execution summary for the bounded A-long 2018-2025 full-period panel materialization. Raw rows stay under gitignored data/a_long/raw/ and are not written into this summary. A pass proves materialization shape only, not data integrity or alpha readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "artifact_id",
    "packet_ref",
    "scope",
    "execution",
    "broader_materialization_boundary",
    "endpoint_results",
    "table_rollup",
    "decision",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_tushare_broader_materialization_execution_summary"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_tushare_broader_materialization_execution_summary_20260604"},
    "packet_ref": {"const": "docs/a_long_tushare_broader_materialization_packet_20260604.json"},
    "scope": {"$ref": "#/$defs/scope"},
    "execution": {"$ref": "#/$defs/execution"},
    "broader_materialization_boundary": {"$ref": "#/$defs/boundary"},
    "endpoint_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/endpointResult"}
    },
    "table_rollup": {
      "type": "array",
      "items": {"$ref": "#/$defs/tableRollup"},
      "minItems": 11,
      "maxItems": 11
    },
    "decision": {"$ref": "#/$defs/decision"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "limitations": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "minItems": 1
    },
    "nullableString": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "purpose",
        "lane_id",
        "market",
        "research_only",
        "provider_family",
        "provider_call_executed",
        "tushare_call_executed",
        "data_fetch_executed",
        "raw_payload_written_to_gitignored_path",
        "tracked_summary_contains_raw_rows",
        "tracked_summary_contains_secret",
        "full_market_materialization_executed",
        "full_universe_materialization_executed",
        "audit_rerun_executed",
        "signal_search_executed",
        "alpha_backtest_executed",
        "datahub_allowed",
        "production_use_allowed",
        "ship_gate_claim_allowed",
        "full_size_manual_use_allowed",
        "broker_or_order_automation_allowed",
        "manual_order_only"
      ],
      "properties": {
        "phase": {"const": "7a_alpha_validation"},
        "purpose": {"const": "a_long_tushare_full_period_panel_materialization_execution"},
        "lane_id": {"const": "a_long"},
        "market": {"const": "A-share"},
        "research_only": {"const": true},
        "provider_family": {"const": "tushare_existing_account"},
        "provider_call_executed": {"type": "boolean"},
        "tushare_call_executed": {"type": "boolean"},
        "data_fetch_executed": {"type": "boolean"},
        "raw_payload_written_to_gitignored_path": {"type": "boolean"},
        "tracked_summary_contains_raw_rows": {"const": false},
        "tracked_summary_contains_secret": {"const": false},
        "full_market_materialization_executed": {"const": false},
        "full_universe_materialization_executed": {"const": false},
        "audit_rerun_executed": {"const": false},
        "signal_search_executed": {"const": false},
        "alpha_backtest_executed": {"const": false},
        "datahub_allowed": {"const": false},
        "production_use_allowed": {"const": false},
        "ship_gate_claim_allowed": {"const": false},
        "full_size_manual_use_allowed": {"const": false},
        "broker_or_order_automation_allowed": {"const": false},
        "manual_order_only": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "raw_output_root",
        "raw_output_root_is_gitignored",
        "max_total_endpoint_calls",
        "planned_total_endpoint_calls",
        "endpoint_results_count",
        "new_network_call_count",
        "reused_raw_payload_count",
        "min_seconds_between_network_calls",
        "daily_empty_raw_refetch_count",
        "budget_exceeded",
        "network_call_attempted",
        "environment_precheck_passed",
        "independent_review_confirmed",
        "post_review_execute_confirmed",
        "token_logged",
        "request_url_logged"
      ],
      "properties": {
        "summary_path": {"const": "docs/a_long_tushare_broader_materialization_execution_summary_20260604.json"},
        "raw_output_root": {"const": "data/a_long/raw/tushare/materialization_full_period_panel_20260604/"},
        "raw_output_root_is_gitignored": {"const": true},
        "max_total_endpoint_calls": {"const": 80},
        "planned_total_endpoint_calls": {"const": 71},
        "endpoint_results_count": {"type": "integer", "minimum": 0, "maximum": 80},
        "new_network_call_count": {"type": "integer", "minimum": 0, "maximum": 80},
        "reused_raw_payload_count": {"type": "integer", "minimum": 0, "maximum": 80},
        "min_seconds_between_network_calls": {"type": "number", "minimum": 0},
        "daily_empty_raw_refetch_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "budget_exceeded": {"const": false},
        "network_call_attempted": {"type": "boolean"},
        "environment_precheck_passed": {"type": "boolean"},
        "independent_review_confirmed": {"type": "boolean"},
        "post_review_execute_confirmed": {"type": "boolean"},
        "token_logged": {"const": false},
        "request_url_logged": {"const": false}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialization_id", "start_date", "end_date", "active_symbols", "delisted_symbols", "benchmark_indices", "not_full_market", "not_full_universe"],
