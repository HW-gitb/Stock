    "prohibitedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a_long_data_ready", "a_long_alpha_found", "audit_passed", "signal_search_authorized", "full_universe_materialization_done", "production_ready", "ship_gate_evidence", "full_size_allowed", "datahub_authorized", "broker_or_order_automation_authorized"],
      "properties": {
        "a_long_data_ready": {"const": false},
        "a_long_alpha_found": {"const": false},
        "audit_passed": {"const": false},
        "signal_search_authorized": {"const": false},
        "full_universe_materialization_done": {"const": false},
        "production_ready": {"const": false},
        "ship_gate_evidence": {"const": false},
        "full_size_allowed": {"const": false},
        "datahub_authorized": {"const": false},
        "broker_or_order_automation_authorized": {"const": false}
      }
    }
