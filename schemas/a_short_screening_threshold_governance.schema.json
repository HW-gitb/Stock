{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/a_short_screening_runtime_policy/2.0.0/schema.json",
  "title": "A-short Screening Runtime Policy",
  "description": "The active JSON authority for A-short screening business thresholds. Python may validate and consume these values, but may not provide a fallback threshold.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "policy_id", "runtime_authority", "thresholds"],
  "properties": {
    "schema_name": {"const": "a_short_screening_runtime_policy"},
    "schema_version": {"const": "2.0.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "runtime_authority": {"const": true},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_avg_amount", "unlock_ratio", "top_n", "watch_n", "final_n", "suspend_lookback", "suspend_daily_min_coverage", "daily_stats_min_rows", "momentum_std_threshold", "overheat_5d", "overheat_20d", "esp_raw_cap"],
      "properties": {
        "min_avg_amount": {"type": "number", "minimum": 0},
        "unlock_ratio": {"type": "number", "minimum": 0, "maximum": 100},
        "top_n": {"type": "integer", "minimum": 1},
        "watch_n": {"type": "integer", "minimum": 1},
        "final_n": {"type": "integer", "minimum": 1},
        "suspend_lookback": {"type": "integer", "minimum": 1},
        "suspend_daily_min_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "daily_stats_min_rows": {"type": "integer", "minimum": 1},
        "momentum_std_threshold": {"type": "number", "minimum": 0},
        "overheat_5d": {"type": "number", "minimum": 0},
        "overheat_20d": {"type": "number", "minimum": 0},
        "esp_raw_cap": {"type": "number", "minimum": 0}
      }
    }
  }
}
