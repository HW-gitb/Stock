{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_llm_theme_discovery.schema.json",
  "title": "US-short offline LLM theme discovery artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "decision_clock",
    "discovery_contract",
    "source_refs",
    "themes"
  ],
  "properties": {
    "schema_name": {
      "const": "us_short_llm_theme_discovery"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "cutoff_policy", "pit_enforced"],
      "properties": {
        "expected_decision_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "cutoff_policy": {
          "const": "before_decision_open_et"
        },
        "pit_enforced": {
          "const": true
        }
      }
    },
    "discovery_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_kind",
        "input_mode",
        "membership_status",
        "market_confirmation_status",
        "scoring_eligible",
        "top15_effect_enabled",
        "operation_advice_effect_enabled",
        "dynamic_seats_enabled",
        "theme_probe_enabled",
        "lifecycle_actions_enabled"
      ],
      "properties": {
        "producer_kind": {
          "const": "llm_theme_discovery"
        },
        "input_mode": {
          "const": "offline_local_input"
        },
        "membership_status": {
          "const": "provisional_unvalidated"
        },
        "market_confirmation_status": {
          "const": "not_run"
        },
        "scoring_eligible": {
          "const": false
        },
        "top15_effect_enabled": {
          "const": false
        },
        "operation_advice_effect_enabled": {
          "const": false
        },
        "dynamic_seats_enabled": {
          "const": false
        },
        "theme_probe_enabled": {
          "const": false
        },
        "lifecycle_actions_enabled": {
          "const": false
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source_ref"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/theme"
      }
    }
  },
  "definitions": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "observed_at"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"
        },
        "source_type": {
          "enum": ["web", "x", "llm"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "membership_status", "source_ref_ids"],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"
        },
        "membership_status": {
          "const": "provisional_unvalidated"
        },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "display_name",
        "summary",
        "status",
        "observed_at",
        "source_ref_ids",
        "members",
        "cross_industry_validation_status",
        "market_confirmation_status"
      ],
      "properties": {
        "theme_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "const": "provisional_discovered"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/member"
          }
        },
        "cross_industry_validation_status": {
          "const": "not_run"
        },
        "market_confirmation_status": {
          "const": "not_run"
        }
      }
    }
  }
}
