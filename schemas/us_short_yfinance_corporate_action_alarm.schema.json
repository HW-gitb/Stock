{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_yfinance_corporate_action_alarm/1.0.0/schema.json",
  "title": "US-short yfinance corporate-action daily smoke alarm",
  "description": "Low-trust, non-critical split/dividend/source-availability alarm. It cannot confirm corporate-action semantics, affect selection/provider health, or satisfy paper/ship gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "security_binding", "expected_price_date", "observed_at", "alarm_status", "alarm_reasons", "manual_review_required", "ticker_scoped_freeze_required", "failure_isolation", "boundary"],
  "properties": {
    "schema_name": {"const": "us_short_yfinance_corporate_action_alarm"},
    "schema_version": {"const": "1.0.0"},
    "security_binding": {"$ref": "#/$defs/securityBinding"},
    "expected_price_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "alarm_status": {"enum": ["clear", "advisory_alarm", "source_unavailable"]},
    "alarm_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["source_unavailable", "returned_ticker_mismatch", "missing_expected_bar", "dividend_reported", "split_reported"]}
    },
    "manual_review_required": {"type": "boolean"},
    "ticker_scoped_freeze_required": {"type": "boolean"},
    "failure_isolation": {"$ref": "#/$defs/failureIsolation"},
    "boundary": {"$ref": "#/$defs/boundary"}
  },
  "allOf": [
    {
      "if": {"properties": {"alarm_status": {"const": "clear"}}},
      "then": {"properties": {"alarm_reasons": {"maxItems": 0}, "manual_review_required": {"const": false}, "ticker_scoped_freeze_required": {"const": false}}},
      "else": {"properties": {"alarm_reasons": {"minItems": 1}, "manual_review_required": {"const": true}, "ticker_scoped_freeze_required": {"const": true}}}
    },
    {
      "if": {"properties": {"alarm_status": {"const": "source_unavailable"}}},
      "then": {"properties": {"alarm_reasons": {"const": ["source_unavailable"]}}}
    }
  ],
  "$defs": {
    "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "securityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_id", "current_ticker", "identity_ref_sha256"],
      "properties": {
        "security_id": {"type": "string", "pattern": "^US-CIK-[0-9]{10}-(COMMON|CLASS_[A-Z]{1,3}|ADR|PREFERRED)$"},
        "current_ticker": {"$ref": "#/$defs/ticker"},
        "identity_ref_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "failureIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_run_blocked", "unrelated_symbols_frozen"],
      "properties": {"global_run_blocked": {"const": false}, "unrelated_symbols_frozen": {"const": false}}
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_call_performed", "source_trust", "corporate_event_semantics_confirmed", "selection_use_allowed", "provider_health_gate_use_allowed", "paper_performance_confirmation_allowed", "account_state_read", "broker_order_placed", "ship_gate_evidence_claimed"],
      "properties": {
        "provider_call_performed": {"type": "boolean"},
        "source_trust": {"const": "low_trust_advisory"},
        "corporate_event_semantics_confirmed": {"const": false},
        "selection_use_allowed": {"const": false},
        "provider_health_gate_use_allowed": {"const": false},
        "paper_performance_confirmation_allowed": {"const": false},
        "account_state_read": {"const": false},
        "broker_order_placed": {"const": false},
        "ship_gate_evidence_claimed": {"const": false}
      }
    }
  }
}
