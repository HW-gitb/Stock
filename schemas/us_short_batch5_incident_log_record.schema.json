{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_incident_log_record.schema.json",
  "title": "US-short batch5 incident log record",
  "description": "US-short batch5 private incident log record schema. This validates private incident rows only; it does not authorize provider/live/network calls, provider status polling, fallback execution, DataHub, production storage, live_normalized evidence, or ship-gate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "incident_id",
    "detected_at",
    "detected_by",
    "source_family",
    "provider_candidate",
    "endpoint_family",
    "affected_symbols_or_universe",
    "affected_date_window",
    "incident_type",
    "severity",
    "trigger_summary",
    "evidence_artifact_refs",
    "raw_payload_storage_ref",
    "secret_scan_status",
    "immediate_action",
    "production_use_blocked",
    "fallback_execution_performed",
    "provider_calls_performed_by_log_contract",
    "status_page_polled_by_log_contract",
    "manual_review_owner",
    "review_status",
    "disposition",
    "replay_or_revalidation_requirement",
    "scope_locks"
  ],
  "properties": {
    "schema_name": {
      "const": "us_short_batch5_incident_log_record"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 8,
      "maxLength": 120
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40
    },
    "detected_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "source_family": {
      "type": "string",
      "enum": [
        "fundamentals",
        "price_volume_liquidity",
        "corporate_actions",
        "security_master_coverage",
        "sec_edgar_audit",
        "benchmark_gics",
        "provider_transport",
        "unknown"
      ]
    },
    "provider_candidate": {
      "type": "string",
      "enum": [
        "financial_modeling_prep",
        "sec_edgar",
        "manual_audit",
        "unresolved_candidate",
        "unknown"
      ]
    },
    "endpoint_family": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "not": {
        "pattern": "https?://|apikey=|api_key=|bearer\\s+|financialmodelingprep\\.com|sec\\.gov"
      }
    },
    "affected_symbols_or_universe": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "affected_date_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "quota_or_rate_limit",
        "http_5xx_or_provider_outage",
        "http_401_403_auth_scope",
        "schema_or_field_semantics_drift",
        "stale_or_missing_rows",
        "pit_or_observed_date_ambiguity",
        "corporate_action_adjustment_conflict",
        "sec_edgar_audit_conflict"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning_only",
        "production_blocker",
        "evidence_blocker"
      ]
    },
    "trigger_summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800,
      "not": {
        "pattern": "https?://|apikey=|api_key=|bearer\\s+|financialmodelingprep\\.com|data\\.sec\\.gov|www\\.sec\\.gov|\\\"payload\\\"|\\\"raw_payload\\\""
      }
    },
    "evidence_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 180,
        "not": {
          "pattern": "https?://|apikey=|api_key=|bearer\\s+"
        }
      }
    },
    "raw_payload_storage_ref": {
      "type": "string",
      "maxLength": 220,
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^provider_samples/us_short_batch5_provider_incidents/[^?]+$"
        }
      ],
      "not": {
        "pattern": "https?://|\\.\\.|apikey=|api_key=|bearer\\s+"
      }
    },
    "secret_scan_status": {
      "type": "string",
      "enum": [
        "clean",
        "pending_review",
        "not_applicable_no_raw"
      ]
    },
    "immediate_action": {
      "type": "string",
      "enum": [
        "record_incident",
        "block_production_use",
        "fallback_path_review",
        "manual_review",
        "rerun_provider_evidence",
        "freeze_latest_only_claims",
        "use_reviewed_audit_source_only"
      ]
    },
    "production_use_blocked": {
      "const": true
    },
    "fallback_execution_performed": {
      "const": false
    },
    "provider_calls_performed_by_log_contract": {
      "const": false
    },
    "status_page_polled_by_log_contract": {
      "const": false
    },
    "manual_review_owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "reviewed_blocked",
        "reviewed_resolved",
        "accepted_risk_by_user"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "pending",
        "blocked",
        "resolved",
        "accepted_risk_by_user",
        "not_applicable"
      ]
    },
    "replay_or_revalidation_requirement": {
      "type": "string",
      "enum": [
        "separate_approval_required",
        "manual_review_required",
        "none"
      ]
    },
    "scope_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selection_allowed",
        "provider_status_polling_allowed",
        "fallback_execution_allowed",
        "datahub_consumption_allowed",
        "runner_consumption_allowed",
        "production_storage_allowed",
        "live_normalized_evidence_allowed",
        "ship_gate_evidence_allowed"
      ],
      "properties": {
        "provider_selection_allowed": {
          "const": false
        },
        "provider_status_polling_allowed": {
          "const": false
        },
        "fallback_execution_allowed": {
          "const": false
        },
        "datahub_consumption_allowed": {
          "const": false
        },
        "runner_consumption_allowed": {
          "const": false
        },
        "production_storage_allowed": {
          "const": false
        },
        "live_normalized_evidence_allowed": {
          "const": false
        },
        "ship_gate_evidence_allowed": {
          "const": false
        }
      }
    }
  }
}
