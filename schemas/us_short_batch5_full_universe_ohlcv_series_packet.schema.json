{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_universe_ohlcv_series_packet.schema.json",
  "title": "US-short Batch5 full-universe OHLCV per-ticker series packet (§4.3 overextension producer input)",
  "description": "Envelope-strict, series-lenient (mirrors the momentum series packet): the envelope (clock / contract) fails closed, but individual per-ticker series carry only a well-formed OHLCV shape (dates + numeric high/low/close) — thin / non-positive / high<low / close-outside-[low,high] / short series are NOT schema-rejected because engine/us_short_overextension.py::compute_overextension_features is the single PIT/clean authority and gracefully dispositions a bad ticker (insufficient_data). Unlike the momentum packet, each point carries high/low (needed for ATR) and there are NO SPY/QQQ benchmarks (overextension is a per-ticker absolute signal, not relative-strength). This packet is written by the GATED grouped-window fetch (SR-PROVIDER-001; the momentum grouped fetch already pulls full OHLCV and currently drops high/low); the offline producer runner consumes it via engine/us_short_overextension_producer.py::build_overextension_projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "scope",
    "decision_clock",
    "series_contract",
    "provenance",
    "series_by_ticker"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_full_universe_ohlcv_series_packet" },
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "lane",
        "batch",
        "packet_status",
        "full_market_reconstruction",
        "network_access_performed_by_packet_producer",
        "provider_calls_performed_by_packet_producer",
        "raw_payload_refs_gitignored",
        "datahub_consumption_allowed",
        "production_storage_allowed",
        "ship_gate_evidence_claimed",
        "broker_or_order_automation_allowed",
        "a_share_crossing_allowed"
      ],
      "properties": {
        "market": { "const": "US" },
        "lane": { "const": "us_short" },
        "batch": { "const": "batch5_provider_live" },
        "packet_status": { "const": "full_universe_per_ticker_ohlcv_series_ready_for_local_overextension_projection" },
        "full_market_reconstruction": { "const": true },
        "network_access_performed_by_packet_producer": { "type": "boolean" },
        "provider_calls_performed_by_packet_producer": { "type": "boolean" },
        "raw_payload_refs_gitignored": { "const": true },
        "datahub_consumption_allowed": { "const": false },
        "production_storage_allowed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "broker_or_order_automation_allowed": { "const": false },
        "a_share_crossing_allowed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_decision_date",
        "candidate_price_basis_date",
        "price_basis_date",
        "source_as_of"
      ],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "candidate_price_basis_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "price_basis_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "series_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "adjustment_mode",
        "as_of",
        "grouped_session_count"
      ],
      "properties": {
        "session": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "adjustment_mode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "grouped_session_count": { "type": "integer", "minimum": 1, "maximum": 3000 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_or_family",
        "source_as_of",
        "observed_at",
        "coverage_status",
        "parser_status"
      ],
      "properties": {
        "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "maxLength": 64 },
        "endpoint_or_family": { "type": "string", "minLength": 1 },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "observed_at": { "type": "string", "minLength": 1 },
        "coverage_status": { "enum": ["full", "partial", "missing"] },
        "parser_status": { "enum": ["ok", "partial", "failed"] }
      }
    },
    "series_by_ticker": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "session", "adjustment_mode", "points"],
      "properties": {
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "session": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "adjustment_mode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "high", "low", "close"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "open": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "volume": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
      }
    }
  }
}
