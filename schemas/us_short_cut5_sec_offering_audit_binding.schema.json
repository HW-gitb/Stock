{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_cut5_sec_offering_audit_binding.schema.json",
  "title": "US-short Cut 5-a SEC offering-audit source binding",
  "description": "Frozen schema-first contract for the offline SEC offering (§5.1a 增发/转售) audit source. Const-pins the load-bearing semantics (provider/endpoint, offering form families + matchers, takedown family, recency window, status derivation, materiality-unavailable policy, provenance fields, coverage/parser enums, emission fitness) so a producer + the engine consts cannot silently drift. Offline shape only; live fetch gated under SR-PROVIDER-001.",
  "type": "object",
  "required": [
    "binding_name", "binding_version", "provider_id", "endpoint_or_filing_type", "decision_timezone",
    "offering_form_families", "takedown_family", "recency_window_days", "status_derivation",
    "materiality_policy", "signal_contract", "provenance_fields", "coverage_status_allowed",
    "parser_status_allowed", "emission_fitness", "pit_rule", "filing_fields", "pit_clock_contract",
    "duplicate_policy", "checked_empty_disposition", "lineage_ref_format", "authorization_boundary"
  ],
  "properties": {
    "binding_name": { "const": "us_short_cut5_sec_offering_audit_binding" },
    "binding_version": { "type": "string" },
    "design_authority": { "type": "string" },
    "authorization_note": { "type": "string" },
    "provider_id": { "const": "sec_edgar" },
    "endpoint_or_filing_type": { "const": "submissions" },
    "decision_timezone": { "const": "America/New_York" },
    "foreign_and_reit_note": { "type": "string" },
    "offering_form_families": {
      "type": "object",
      "required": ["primary_registration", "shelf_registration", "prospectus_supplement"],
      "properties": {
        "primary_registration": {
          "type": "object",
          "required": ["match", "forms", "dilution_role"],
          "properties": {
            "match": { "const": "exact_or_amend" },
            "forms": { "const": ["S-1", "S-11", "F-1"] },
            "dilution_role": { "const": "registration" }
          },
          "additionalProperties": false
        },
        "shelf_registration": {
          "type": "object",
          "required": ["match", "forms", "dilution_role"],
          "properties": {
            "match": { "const": "exact_or_amend" },
            "forms": { "const": ["S-3", "S-3ASR", "F-3", "F-3ASR"] },
            "dilution_role": { "const": "registration" }
          },
          "additionalProperties": false
        },
        "prospectus_supplement": {
          "type": "object",
          "required": ["match", "forms", "dilution_role"],
          "properties": {
            "match": { "const": "prefix" },
            "forms": { "const": ["424B"] },
            "dilution_role": { "const": "takedown" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "takedown_family": { "const": "prospectus_supplement" },
    "recency_window_days": { "const": 90 },
    "recency_window_basis": { "type": "string" },
    "status_derivation": {
      "type": "object",
      "required": ["active", "registered_shelf"],
      "properties": {
        "active": { "type": "string" },
        "registered_shelf": { "type": "string" }
      },
      "additionalProperties": false
    },
    "materiality_policy": { "type": "string" },
    "excluded_forms_note": { "type": "string" },
    "signal_contract": {
      "type": "object",
      "required": ["consumer", "active_offering"],
      "properties": {
        "consumer": { "type": "string" },
        "active_offering": {
          "type": "object",
          "required": ["recency", "status", "materiality"],
          "properties": {
            "recency": { "const": ["recent", "stale"] },
            "status": { "const": ["active", "registered_shelf"] },
            "materiality": { "const": [null] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance_fields": {
      "const": ["provider_id", "endpoint_or_filing_type", "source_as_of", "observed_at", "coverage_status", "parser_status", "lineage_ref"]
    },
    "coverage_status_allowed": { "const": ["full", "partial", "missing"] },
    "parser_status_allowed": { "const": ["ok", "degraded", "failed"] },
    "emission_fitness": {
      "type": "object",
      "required": ["coverage_status", "parser_status"],
      "properties": {
        "coverage_status": { "const": "full" },
        "parser_status": { "const": "ok" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "date_format": { "type": "string" },
    "pit_rule": { "type": "string" },
    "filing_fields": { "const": ["form", "filing_date", "acceptance_datetime", "accession"] },
    "pit_clock_contract": {
      "type": "object",
      "required": ["observed_at_cutoff_operator", "observed_at_cutoff_reference", "chronology_order", "chronology_relation"],
      "properties": {
        "observed_at_cutoff_operator": { "const": "strictly_before" },
        "observed_at_cutoff_reference": { "const": "decision_session_open" },
        "chronology_order": { "const": ["acceptance_datetime", "observed_at", "source_as_of", "as_of"] },
        "chronology_relation": { "const": "non_decreasing" }
      },
      "additionalProperties": false
    },
    "duplicate_policy": {
      "type": "object",
      "required": ["source_row_identity", "on_duplicate"],
      "properties": {
        "source_row_identity": { "const": "accession" },
        "on_duplicate": { "const": "reject" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checked_empty_disposition": { "const": "audited_no_active_offering" },
    "checked_empty_note": { "type": "string" },
    "lineage_ref_format": {
      "type": "object",
      "required": ["structure", "record_id_rule"],
      "properties": {
        "structure": { "const": "provider_id:endpoint_or_filing_type:source_as_of#record_id" },
        "record_id_rule": { "const": "nonempty_ascii_no_colon_hash_whitespace" }
      },
      "additionalProperties": false
    },
    "authorization_boundary": {
      "type": "object",
      "required": ["live_fetch", "network", "raw_capture", "runner_wired", "datahub", "production", "ship_gate"],
      "properties": {
        "live_fetch": { "const": false },
        "network": { "const": false },
        "raw_capture": { "const": false },
        "runner_wired": { "const": false },
        "datahub": { "const": false },
        "production": { "const": false },
        "ship_gate": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
