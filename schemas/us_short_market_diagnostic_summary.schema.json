{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_market_diagnostic_summary.schema.json",
  "title": "US-short 26-week market diagnostic summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "window_id",
    "diagnostic_epoch",
    "window_start_week",
    "window_end_week",
    "calendar_weeks",
    "mixed_ruleset_window",
    "strategy",
    "benchmarks",
    "overall_status",
    "status_reason",
    "ruleset_fingerprints",
    "v1_1_reminder",
    "source_week_record_sha256",
    "boundary"
  ],
  "properties": {
    "schema_name": {"const": "us_short_market_diagnostic_summary"},
    "schema_version": {"const": "1.0.0"},
    "window_id": {"type": "string", "pattern": "^26w-[1-9][0-9]*-[1-9][0-9]*$"},
    "diagnostic_epoch": {"type": "string", "minLength": 1},
    "window_start_week": {"type": "integer", "minimum": 1},
    "window_end_week": {"type": "integer", "minimum": 1},
    "calendar_weeks": {"const": 26},
    "mixed_ruleset_window": {"type": "boolean"},
    "strategy": {"$ref": "#/definitions/strategy_summary"},
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VTI", "IWB", "SPY", "QQQ"],
      "properties": {
        "VTI": {"$ref": "#/definitions/benchmark_summary"},
        "IWB": {"$ref": "#/definitions/benchmark_summary"},
        "SPY": {"$ref": "#/definitions/benchmark_summary"},
        "QQQ": {"$ref": "#/definitions/benchmark_summary"}
      }
    },
    "overall_status": {
      "enum": [
        "ahead_diagnostic",
        "behind_diagnostic",
        "mixed_across_benchmarks",
        "data_insufficient",
        "data_degraded",
        "unavailable"
      ]
    },
    "status_reason": {"type": "string", "minLength": 1},
    "ruleset_fingerprints": {
      "type": "array",
      "items": {"$ref": "#/definitions/sha256"},
      "minItems": 1,
      "maxItems": 26,
      "uniqueItems": true
    },
    "v1_1_reminder": {"$ref": "#/definitions/v1_1_reminder"},
    "source_week_record_sha256": {
      "type": "array",
      "items": {"$ref": "#/definitions/sha256"},
      "minItems": 1,
      "maxItems": 26,
      "uniqueItems": true
    },
    "boundary": {"$ref": "#/definitions/boundary"}
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
    },
    "number_or_null": {
      "type": ["number", "null"]
    },
    "ratio_or_null": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "nonnegative_number_or_null": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "strategy_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "final_nav",
        "cumulative_return",
        "since_inception_return",
        "strategy_evaluable_weeks",
        "no_count_weeks",
        "paper_degraded_weeks",
        "max_drawdown",
        "cumulative_cost_paid",
        "cash_ratio",
        "equity_ratio",
        "turnover",
        "unfilled_order_count",
        "data_coverage"
      ],
      "properties": {
        "status": {"enum": ["evaluable", "diagnostic_data_degraded", "not_evaluable"]},
        "final_nav": {"$ref": "#/definitions/money"},
        "cumulative_return": {"$ref": "#/definitions/number_or_null"},
        "since_inception_return": {"$ref": "#/definitions/number_or_null"},
        "strategy_evaluable_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "no_count_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "paper_degraded_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "max_drawdown": {"$ref": "#/definitions/number_or_null"},
        "cumulative_cost_paid": {"anyOf": [{"$ref": "#/definitions/money"}, {"type": "null"}]},
        "cash_ratio": {"$ref": "#/definitions/ratio_or_null"},
        "equity_ratio": {"$ref": "#/definitions/ratio_or_null"},
        "turnover": {"$ref": "#/definitions/nonnegative_number_or_null"},
        "unfilled_order_count": {"type": "integer", "minimum": 0},
        "data_coverage": {"$ref": "#/definitions/ratio_or_null"}
      }
    },
    "benchmark_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "cumulative_return",
        "relative_wealth",
        "raw_excess",
        "information_ratio",
        "hac_t",
        "joint_evaluable_weeks",
        "total_return_evaluable_weeks",
        "price_only_weeks",
        "unavailable_weeks",
        "data_coverage",
        "status"
      ],
      "properties": {
        "role": {"enum": [
          "ship_gate_economic_continuity",
          "russell_1000_investable_proxy",
          "broad_large_cap_sensitivity",
          "growth_technology_sensitivity"
        ]},
        "cumulative_return": {"$ref": "#/definitions/number_or_null"},
        "relative_wealth": {"$ref": "#/definitions/number_or_null"},
        "raw_excess": {"$ref": "#/definitions/number_or_null"},
        "information_ratio": {"$ref": "#/definitions/number_or_null"},
        "hac_t": {"$ref": "#/definitions/number_or_null"},
        "joint_evaluable_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "total_return_evaluable_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "price_only_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "unavailable_weeks": {"type": "integer", "minimum": 0, "maximum": 26},
        "max_drawdown": {"$ref": "#/definitions/number_or_null"},
        "data_coverage": {"$ref": "#/definitions/ratio_or_null"},
        "status": {"enum": [
          "ahead_diagnostic",
          "behind_diagnostic",
          "mixed_across_benchmarks",
          "data_insufficient",
          "data_degraded",
          "unavailable"
        ]}
      }
    },
    "v1_1_reminder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluable_week_count", "text"],
      "properties": {
        "status": {"enum": ["pending", "ready_for_v1_1_implementation", "overdue", "active"]},
        "evaluable_week_count": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "comparison_only",
        "counts_ship_gate",
        "changes_selection_or_action",
        "automatic_policy_switch",
        "broker_or_order_automation"
      ],
      "properties": {
        "diagnostic_only": {"const": true},
        "comparison_only": {"const": true},
        "counts_ship_gate": {"const": false},
        "changes_selection_or_action": {"const": false},
        "automatic_policy_switch": {"const": false},
        "broker_or_order_automation": {"const": false}
      }
    }
  }
}
