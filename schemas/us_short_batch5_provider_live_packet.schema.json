            "required": [
              "artifact_id"
            ]
          }
        }
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "future_provider_live_probe_boundary": {
      "$ref": "#/$defs/futureProviderLiveProbeBoundary"
    },
    "storage_and_secret_boundary": {
