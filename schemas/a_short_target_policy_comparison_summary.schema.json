{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_target_policy_comparison_summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "summary_id",
    "as_of",
    "data_through",
    "status",
    "target_exit",
    "breakout_entry",
    "execution_data_status",
    "verdict",
    "progress",
    "fingerprint",
    "source_hash",
    "target_exit_adjudication",
    "breakout_entry_reports",
    "breakout_entry_verdict",
    "admissions",
    "message",
    "production_unchanged"
  ],
  "properties": {
    "schema_name": {"const": "a_short_target_policy_comparison_summary"},
    "schema_version": {"const": "1.0.0"},
    "summary_id": {"const": "a_short_target_policy_comparison"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "data_through": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
    "status": {
      "enum": [
        "not_configured",
        "accumulating",
        "review_due",
        "review_pass_pending_confirmation",
        "evidence_unavailable_or_inconclusive"
      ]
    },
    "target_exit": {"$ref": "#/definitions/progress"},
    "breakout_entry": {"$ref": "#/definitions/progress"},
    "execution_data_status": {"enum": ["unavailable", "available"]},
    "verdict": {"enum": ["not_adjudicated", "edge_positive", "edge_not_supported"]},
    "progress": {"$ref": "#/definitions/adjudication_progress"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_exit_adjudication": {"type": "object"},
    "breakout_entry_reports": {"type": "object", "additionalProperties": false, "required": ["new_old_entry_week_portfolios", "excluded_vs_csi1000", "missed_large_moves", "risk_outcomes"], "properties": {"new_old_entry_week_portfolios": {"type": "array"}, "excluded_vs_csi1000": {"type": "array"}, "missed_large_moves": {"type": "array"}, "risk_outcomes": {"type": "array"}}},
    "breakout_entry_verdict": {"const": "not_adjudicated"},
    "admissions": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["experiment_id", "component_id", "track_mode", "identity_sha256", "statistical_contract_sha256", "pit_forward_contract_sha256", "dependency_components"],
      "properties": {"experiment_id": {"type": "string"}, "component_id": {"type": "string"}, "track_mode": {"enum": ["switchable", "diagnostic_only"]}, "identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "statistical_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "pit_forward_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "dependency_components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component_id", "baseline_definition_sha256"], "properties": {"component_id": {"type": "string"}, "baseline_definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}}}},
    "message": {"type": "string", "minLength": 1},
    "production_unchanged": {"const": true}
  },
  "definitions": {
    "adjudication_progress": {"type": "object", "additionalProperties": false, "required": ["forward_weeks", "difference_weeks", "evaluable_plans", "evaluable_weeks"], "properties": {"forward_weeks": {"type": "integer", "minimum": 0}, "difference_weeks": {"type": "integer", "minimum": 0}, "evaluable_plans": {"type": "integer", "minimum": 0}, "evaluable_weeks": {"type": "integer", "minimum": 0}}},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_weeks",
        "required_forward_weeks",
        "decision_difference_weeks",
        "required_decision_difference_weeks",
        "evaluable_plans",
        "required_evaluable_plans",
        "review_state"
      ],
      "properties": {
        "forward_weeks": {"type": "integer", "minimum": 0},
        "required_forward_weeks": {"const": 12},
        "decision_difference_weeks": {"type": "integer", "minimum": 0},
        "required_decision_difference_weeks": {"const": 8},
        "evaluable_plans": {"type": "integer", "minimum": 0},
        "required_evaluable_plans": {"const": 20},
        "review_state": {"enum": ["not_due", "due", "pass_pending_confirmation"]}
      }
    }
  }
}
