        "formal_verdict": {"enum": ["not_evaluated", "inconclusive", "supported", "not_supported"]},
        "winning_arm_id": {"type": ["string", "null"]},
        "by_arm": {"type": "object", "additionalProperties": {"type": "object"}},
        "arm_statistics": {"type": "array", "items": {"type": "object"}},
        "finalist_comparisons": {"type": "object"}
