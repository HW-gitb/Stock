        "settled_week_count": {"type": "integer", "minimum": 0},
        "pending_week_count": {"type": "integer", "minimum": 0},
        "no_count_week_count": {"type": "integer", "minimum": 0},
        "calendar_effective_weeks": {"type": "integer", "minimum": 0},
        "trigger_effective_weeks": {"type": "integer", "minimum": 0},
        "current_epoch_id": {"type": "string", "minLength": 1},
        "source_bound_record_count": {"type": "integer", "minimum": 0},
