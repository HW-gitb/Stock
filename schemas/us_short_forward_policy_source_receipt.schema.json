{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnhea.local/schemas/us_short_forward_policy_source_receipt.schema.json",
  "title": "US-short A1 comparison source-bound same-run receipt",
  "description": "A private receipt emitted by the authorized weekly source stage before a comparison week may be accumulated. It binds the retained price window, costs and corporate-action evidence; it does not authorize a provider call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "run_id", "decision_date", "capture_sha256", "source_context_sha256", "baseline_epoch_sha256", "source_packet_sha256", "common_price_snapshot_sha256", "price_window_sha256", "cost_prior_sha256", "adjustment_evidence_sha256", "same_run_live_source", "provider_calls_added"],
  "properties": {
    "schema_name": {"const": "us_short_forward_policy_source_receipt"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "capture_sha256": {"$ref": "#/$defs/sha256"},
    "source_context_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_epoch_sha256": {"$ref": "#/$defs/sha256"},
    "source_packet_sha256": {"$ref": "#/$defs/sha256"},
    "common_price_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "price_window_sha256": {"$ref": "#/$defs/sha256"},
    "cost_prior_sha256": {"$ref": "#/$defs/sha256"},
    "adjustment_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "same_run_live_source": {"const": true},
    "provider_calls_added": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
