{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/provider_p1_fmp_paid_tier_license_public_docs_review/1.0.0/schema.json",
  "title": "Provider P1 FMP Paid-Tier License Public Docs Review",
  "description": "Phase 7b-2 no-access public-docs review for FMP pricing tiers, listed endpoint families, and public Terms / license / storage signals. This artifact reads only public webpages and existing tracked repo artifacts. It does not call APIs, register, buy, start a trial, contact the provider, parse raw payloads, select a provider, authorize DataHub / Phase 7c, claim legal clearance, or claim production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "scope",
    "source_refs",
    "public_pricing_review",
    "public_endpoint_docs_review",
    "public_terms_storage_review",
    "decision_routing_summary",
    "no_silent_default_policy",
    "prohibited_claims",
    "next_steps",
    "limitations"
  ],
  "properties": {
    "schema_name": {
      "const": "provider_p1_fmp_paid_tier_license_public_docs_review"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "minItems": 10,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "source_id": {
                "const": "fmp_pricing_plans_public_page"
              }
            },
            "required": [
              "source_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "source_id": {
                "const": "fmp_terms_of_service_public_page"
              }
            },
            "required": [
              "source_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "source_id": {
                "const": "fmp_faq_public_page"
              }
            },
            "required": [
              "source_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "source_id": {
                "const": "fmp_delisted_companies_doc"
              }
            },
            "required": [
              "source_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "source_id": {
                "const": "p1_sivb_reprobe_execution_summary_20260603"
              }
            },
            "required": [
              "source_id"
            ]
          }
        }
      ]
    },
    "public_pricing_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_date",
        "review_status",
        "pricing_page_is_binding_contract_terms",
        "plans",
        "pricing_page_limitations"
      ],
      "properties": {
        "review_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_status": {
          "const": "public_pricing_page_reviewed_not_entitlement_validation"
        },
        "pricing_page_is_binding_contract_terms": {
          "const": false
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pricingPlan"
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "const": "basic"
                  }
                },
                "required": [
                  "plan_id"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "const": "starter"
                  }
                },
                "required": [
                  "plan_id"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "const": "premium"
                  }
                },
                "required": [
                  "plan_id"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "plan_id": {
                    "const": "ultimate"
                  }
                },
                "required": [
                  "plan_id"
                ]
              }
            }
          ]
        },
        "pricing_page_limitations": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "public_endpoint_docs_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "endpoint_docs_listed_is_access_validation",
        "endpoint_families"
      ],
      "properties": {
        "review_status": {
          "const": "endpoint_templates_listed_not_called_not_entitled"
        },
        "endpoint_docs_listed_is_access_validation": {
          "const": false
        },
        "endpoint_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpointFamily"
          },
          "minItems": 6
        }
      }
    },
    "public_terms_storage_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_date",
        "review_status",
        "legal_advice_claimed",
        "terms_cleared",
        "license_approved",
        "binding_terms_source_note",
        "observations"
      ],
      "properties": {
        "review_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_status": {
          "const": "public_terms_review_only_needs_user_or_legal_decision"
        },
        "legal_advice_claimed": {
          "const": false
        },
        "terms_cleared": {
          "const": false
        },
        "license_approved": {
          "const": false
        },
        "binding_terms_source_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/termsObservation"
          },
          "minItems": 6
        }
      }
    },
    "decision_routing_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_status",
        "provider_selected_by_this_artifact",
        "routes"
      ],
      "properties": {
        "summary_status": {
          "const": "routes_compared_no_decision_made"
        },
        "provider_selected_by_this_artifact": {
          "const": false
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionRoute"
          },
          "minItems": 3,
          "maxItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "route_id": {
                    "const": "continue_basic_active_only"
                  }
                },
                "required": [
                  "route_id"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "route_id": {
                    "const": "upgrade_fmp_paid_tier"
                  }
                },
                "required": [
                  "route_id"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "route_id": {
                    "const": "replace_or_add_specialized_source"
                  }
                },
                "required": [
                  "route_id"
                ]
              }
            }
          ]
        }
      }
    },
    "no_silent_default_policy": {
      "$ref": "#/$defs/noSilentDefaultPolicy"
    },
    "prohibited_claims": {
      "$ref": "#/$defs/prohibitedClaims"
    },
    "next_steps": {
      "$ref": "#/$defs/stringList"
    },
    "limitations": {
      "$ref": "#/$defs/stringList"
    }
  },
