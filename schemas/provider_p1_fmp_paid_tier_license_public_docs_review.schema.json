    },
    "termsObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "source_url",
        "public_text_summary",
        "plain_meaning_for_this_project",
        "requires_user_or_legal_judgment",
        "clears_use"
      ],
      "properties": {
