        },
        "listed_feature_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/featureSignal"
          },
          "minItems": 4
        },
        "feature_listed_is_verified_for_delisted": {
          "const": false
        },
        "paid_tier_coverage_proven": {
          "const": false
        },
        "source_url": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "featureSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
