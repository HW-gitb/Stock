{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_margin_overheat_cash_control_outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "track_id", "comparison_only", "capture_sha256", "payload", "payload_sha256", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_margin_overheat_cash_control_outcome"},
    "schema_version": {"const": "1.0.0"},
    "track_id": {"const": "a_short_margin_overheat_cash_control"},
    "comparison_only": {"const": true},
    "capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "decision_date", "run_date", "price_data_through", "daily_cache_digest", "status", "reason", "arms"],
      "properties": {
        "question_id": {"const": "margin_overheat_cash_control"},
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "run_revision_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
        "run_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "price_data_through": {"type": "string", "pattern": "^[0-9]{8}$"},
        "daily_cache_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pending", "no_count", "settled"]},
        "reason": {"type": ["string", "null"]},
        "arms": {
          "type": "array", "minItems": 3, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["arm_id", "predicate_triggered", "status", "reason", "horizons", "risk_evidence"],
            "properties": {
              "arm_id": {"type": "string"}, "predicate_triggered": {"type": ["boolean", "null"]},
              "status": {"enum": ["pending", "no_count", "settled"]},
              "reason": {"type": ["string", "null"]},
              "position_count": {"type": "integer", "minimum": 0},
              "risk_evidence": {
                "type": "object", "additionalProperties": false,
                "required": ["max_drawdown_pct", "bad_name_rate", "tail_loss_pct", "loss_distribution_count", "cash_drag_pct", "unfilled_rate", "fill_rate", "turnover_pct", "total_cost_pct", "max_name_weight_pct", "adjustment_coverage_pct", "loss_distribution_basis"],
                "properties": {
                  "max_drawdown_pct": {"type": ["number", "null"]},
                  "bad_name_rate": {"type": ["number", "null"]},
                  "tail_loss_pct": {"type": ["number", "null"]},
                  "loss_distribution_count": {"type": ["integer", "null"], "minimum": 0},
                  "cash_drag_pct": {"type": ["number", "null"]},
                  "unfilled_rate": {"type": ["number", "null"]},
                  "fill_rate": {"type": ["number", "null"]},
                  "turnover_pct": {"type": ["number", "null"]},
                  "total_cost_pct": {"type": ["number", "null"]},
                  "max_name_weight_pct": {"type": ["number", "null"]},
                  "adjustment_coverage_pct": {"type": ["number", "null"]},
                  "loss_distribution_basis": {"enum": ["filled_positions_only", null]}
                }
              },
              "horizons": {
                "type": "array", "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["horizon", "entry_date", "exit_date", "nav", "return_pct", "cost"],
                  "properties": {
                    "horizon": {"enum": [5, 10, 20]},
                    "entry_date": {"type": "string", "pattern": "^[0-9]{8}$"},
                    "exit_date": {"type": "string", "pattern": "^[0-9]{8}$"},
                    "nav": {"type": "number"}, "return_pct": {"type": "number"}, "cost": {"type": "number", "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["production", "production_effect_enabled", "automatic_policy_switch", "historical_replay_counts_as_forward", "historical_backfill_forbidden", "provider_calls_during_settlement", "direct_activation_requires_user_authorization"],
      "properties": {
        "production": {"const": false}, "production_effect_enabled": {"const": false},
        "automatic_policy_switch": {"const": false}, "historical_replay_counts_as_forward": {"const": false},
        "historical_backfill_forbidden": {"const": true}, "provider_calls_during_settlement": {"const": false},
        "direct_activation_requires_user_authorization": {"const": true}
      }
    }
  }
}
