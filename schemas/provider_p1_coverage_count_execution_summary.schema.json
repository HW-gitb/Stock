      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "enum": [
              "AAPL",
              "MSFT",
              "NVDA",
              "JPM",
              "XOM"
            ]
          },
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
