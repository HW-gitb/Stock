        "symbol_all_endpoint_success_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "missing_required_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "statement_observed_date_endpoint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "price_ohlcv_presence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "endpoint_family_row_counts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "endpoint_family",
              "min_row_count",
              "max_row_count"
