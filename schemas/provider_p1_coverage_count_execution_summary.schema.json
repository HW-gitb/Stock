                "integer",
                "null"
              ]
            }
          }
        },
        "field_presence": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "missing_required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "symbolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "fmp",
        "validation_observations"
      ],
      "properties": {
        "symbol": {
          "enum": [
            "AAPL",
            "MSFT",
            "NVDA",
            "JPM",
            "XOM"
          ]
        },
        "fmp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoints_ok",
            "endpoints_error",
            "all_endpoint_families_successful",
            "missing_required_field_count",
            "statement_observed_date_endpoint_count",
            "price_ohlcv_fields_present"
          ],
          "properties": {
            "endpoints_ok": {
              "type": "integer",
              "minimum": 0
            },
            "endpoints_error": {
              "type": "integer",
              "minimum": 0
            },
            "all_endpoint_families_successful": {
              "type": "boolean"
            },
            "missing_required_field_count": {
              "type": "integer",
              "minimum": 0
            },
            "statement_observed_date_endpoint_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "price_ohlcv_fields_present": {
              "type": "boolean"
            }
          }
        },
        "validation_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "aggregateCountMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_success_count",
        "endpoint_error_count",
        "symbol_all_endpoint_success_count",
        "missing_required_field_count",
        "statement_observed_date_endpoint_count",
        "price_ohlcv_presence_count",
        "endpoint_family_row_counts"
