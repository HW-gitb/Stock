{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_final_action_validation_summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "summary_id", "as_of", "data_through", "status", "comparison_only", "automatic_policy_switch", "verdict", "adjudication", "evidence_epoch_fingerprint", "latest_evidence_as_of", "source_hash", "admissions", "round_trip_cost_pct", "hold_based_forward_weeks", "full_edge_forward_weeks", "hold_based", "full_edge", "first_forward_live_as_of", "reminders", "message", "production_unchanged"],
  "properties": {
    "schema_name": {"const": "a_short_final_action_validation_summary"},
    "schema_version": {"const": "1.0.0"},
    "summary_id": {"const": "a_short_final_action_validation"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "data_through": {"type": ["string", "null"]},
    "status": {"enum": ["accumulating", "review_due", "unavailable"]},
    "comparison_only": {"const": true},
    "automatic_policy_switch": {"const": false},
    "verdict": {"enum": ["not_adjudicated", "preliminary_edge_positive", "edge_not_proven", "edge_negative"]},
    "adjudication": {"type": "object", "additionalProperties": false, "required": ["verdict", "progress", "reason"], "properties": {"verdict": {"enum": ["not_adjudicated", "preliminary_edge_positive", "edge_not_proven", "edge_negative"]}, "progress": {"type": "object"}, "reason": {"type": "string", "minLength": 1}}},
    "evidence_epoch_fingerprint": {"type": ["string", "null"]},
    "latest_evidence_as_of": {"type": ["string", "null"]},
    "source_hash": {"type": ["string", "null"]},
    "admissions": {"type": "object", "minProperties": 3},
    "round_trip_cost_pct": {"const": 0.16},
    "hold_based_forward_weeks": {"type": "integer", "minimum": 0},
    "full_edge_forward_weeks": {"type": "integer", "minimum": 0},
    "hold_based": {"$ref": "#/definitions/track"},
    "full_edge": {"$ref": "#/definitions/track"},
    "first_forward_live_as_of": {"type": ["string", "null"]},
    "reminders": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/reminder"}},
    "message": {"type": "string", "minLength": 1},
    "production_unchanged": {"const": true}
  },
  "definitions": {
    "stats": {"type": "object", "additionalProperties": false, "required": ["mean_pct", "median_pct", "favorable_ratio"], "properties": {"mean_pct": {"type": ["number", "null"]}, "median_pct": {"type": ["number", "null"]}, "favorable_ratio": {"type": ["number", "null"]}}},
    "track": {"type": "object", "additionalProperties": false, "required": ["forward_weeks", "review_threshold_weeks"], "properties": {"forward_weeks": {"type": "integer", "minimum": 0}, "review_threshold_weeks": {"type": "integer", "minimum": 1}, "managed_plan_count": {"type": "integer", "minimum": 0}, "selection_minus_pool": {"$ref": "#/definitions/stats"}, "selection_minus_csi1000": {"$ref": "#/definitions/stats"}, "managed_minus_simple_hold": {"$ref": "#/definitions/stats"}, "managed_minus_csi1000": {"$ref": "#/definitions/stats"}}},
    "reminder": {"type": "object", "additionalProperties": false, "required": ["reminder_id", "status", "current", "threshold", "message", "automatic_policy_switch"], "properties": {"reminder_id": {"type": "string", "minLength": 1}, "status": {"enum": ["accumulating", "review_due", "unavailable"]}, "current": {"type": "integer", "minimum": 0}, "threshold": {"type": "integer", "minimum": 1}, "message": {"type": "string", "minLength": 1}, "automatic_policy_switch": {"const": false}}}
  }
}
