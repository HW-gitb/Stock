{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A-short official operation evidence progress ledger",
  "description": "Private decision-level progress index only; explicitly not a portfolio, position, cash, or NAV ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "program_id", "records", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_official_operation_evidence_ledger"},
    "schema_version": {"const": "1.0.0"},
    "program_id": {"const": "a_short_official_operation_evidence"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "capture_as_of", "capture_sha256", "evaluation_mode", "policy_version", "status", "reason", "outcome_sha256"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "capture_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
          "capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evaluation_mode": {"const": "live_normalized"},
          "policy_version": {"const": "official_m67_v1"},
          "status": {"enum": ["capture_pending", "pending", "settled", "no_count"]},
          "reason": {"type": ["string", "null"]},
          "outcome_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_progress_ledger_only", "portfolio_state_created", "cash_or_positions_created", "nav_or_head_manifest_created", "automatic_order_execution"],
      "properties": {
        "program_progress_ledger_only": {"const": true},
        "portfolio_state_created": {"const": false},
        "cash_or_positions_created": {"const": false},
        "nav_or_head_manifest_created": {"const": false},
        "automatic_order_execution": {"const": false}
      }
    }
  }
}
