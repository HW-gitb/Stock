{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/a_long_large_cap_market_cap_audit_report/1.0.0/schema.json",
  "title": "A-long Large-Cap Market-Cap Audit Report",
  "description": "Local-only audit report for the already-materialized A-long large-cap monthly market-cap raw payloads. It records counts and gates only, with no raw rows, no endpoint results, and no complete top-500 symbol lists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "artifact_id",
    "source_refs",
    "scope",
    "execution",
    "audit_boundary",
    "required_runner_self_tests",
    "check_results",
    "monthly_coverage",
    "decision",
    "prohibited_claims",
    "result_artifacts",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_large_cap_market_cap_audit_report"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_large_cap_market_cap_audit_report_20260607"},
    "source_refs": {"$ref": "#/$defs/stringList"},
    "scope": {"$ref": "#/$defs/scope"},
    "execution": {"$ref": "#/$defs/execution"},
    "audit_boundary": {"$ref": "#/$defs/auditBoundary"},
    "required_runner_self_tests": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/selfTest"}
    },
    "check_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/checkResult"}
    },
    "monthly_coverage": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/monthlyCoverage"}
    },
    "decision": {"$ref": "#/$defs/decision"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "result_artifacts": {"$ref": "#/$defs/stringList"},
    "limitations": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "nullableNumber": {"type": ["number", "null"]},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "minItems": 1},
    "date8": {"type": "string", "pattern": "^[0-9]{8}$"},
    "flexibleObject": {"type": "object", "additionalProperties": true},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "purpose",
        "lane_id",
        "market",
        "research_only",
        "local_market_cap_raw_read_only",
        "prior_full_main_board_raw_read_only",
        "provider_call_executed",
        "tushare_call_executed",
        "data_fetch_executed",
        "raw_rows_in_tracked_report",
        "top500_symbols_in_tracked_report",
        "endpoint_results_in_tracked_report",
        "signal_search_executed",
        "alpha_backtest_executed",
        "production_use_allowed",
        "ship_gate_claim_allowed",
        "full_size_manual_use_allowed",
        "broker_or_order_automation_allowed",
        "manual_order_only"
      ],
      "properties": {
        "phase": {"const": "7a_alpha_validation"},
        "purpose": {"const": "a_long_large_cap_market_cap_materialization_audit"},
        "lane_id": {"const": "a_long"},
        "market": {"const": "A-share"},
        "research_only": {"const": true},
        "local_market_cap_raw_read_only": {"const": true},
        "prior_full_main_board_raw_read_only": {"const": true},
        "provider_call_executed": {"const": false},
        "tushare_call_executed": {"const": false},
        "data_fetch_executed": {"const": false},
        "raw_rows_in_tracked_report": {"const": false},
        "top500_symbols_in_tracked_report": {"const": false},
        "endpoint_results_in_tracked_report": {"const": false},
        "signal_search_executed": {"const": false},
        "alpha_backtest_executed": {"const": false},
        "production_use_allowed": {"const": false},
        "ship_gate_claim_allowed": {"const": false},
        "full_size_manual_use_allowed": {"const": false},
        "broker_or_order_automation_allowed": {"const": false},
        "manual_order_only": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_packet_ref",
        "materialization_summary_ref",
        "market_cap_raw_root",
        "prior_full_main_board_raw_root",
        "monthly_as_of_count",
        "months_audited",
        "network_calls_executed",
        "provider_calls_executed",
        "self_tests_required",
        "self_tests_passed",
        "independent_review_confirmed",
        "post_review_execute_confirmed",
        "tracked_report_contains_raw_records",
        "tracked_report_contains_top500_symbols",
        "tracked_report_contains_endpoint_results",
        "tracked_report_contains_secret",
        "tracked_report_contains_request_url"
      ],
      "properties": {
        "audit_packet_ref": {"const": "docs/a_long_large_cap_market_cap_audit_packet_20260607.json"},
        "materialization_summary_ref": {"const": "docs/a_long_large_cap_market_cap_materialization_execution_summary_20260607.json"},
        "market_cap_raw_root": {"const": "data/a_long/raw/tushare/large_cap_market_cap_materialization_20260607/"},
        "prior_full_main_board_raw_root": {"const": "data/a_long/raw/tushare/full_main_board_signal_search_20260605/"},
        "monthly_as_of_count": {"const": 96},
        "months_audited": {"const": 96},
        "network_calls_executed": {"const": 0},
        "provider_calls_executed": {"const": 0},
        "self_tests_required": {"const": 5},
        "self_tests_passed": {"const": 5},
        "independent_review_confirmed": {"const": true},
        "post_review_execute_confirmed": {"const": true},
        "tracked_report_contains_raw_records": {"const": false},
        "tracked_report_contains_top500_symbols": {"const": false},
        "tracked_report_contains_endpoint_results": {"const": false},
        "tracked_report_contains_secret": {"const": false},
        "tracked_report_contains_request_url": {"const": false}
      }
    },
    "auditBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialization_id",
        "selected_market_cap_field",
        "universe_size_n",
        "board_scope",
        "main_board_filter_source",
        "monthly_as_of_count",
        "monthly_as_of_dates",
        "same_as_materialization_dates",
        "prior_audited_universe_count",
        "size_bucket_count",
        "minimum_size_bucket_count_for_primary_percentile",
        "top500_symbols_written_to_tracked_report",
        "not_signal_search"
      ],
      "properties": {
        "materialization_id": {"const": "a_long_large_cap_market_cap_top500_monthly_2018_2025"},
        "selected_market_cap_field": {"const": "circ_mv"},
        "universe_size_n": {"const": 500},
        "board_scope": {"const": "main_board_only"},
        "main_board_filter_source": {"const": "engine.data.a_share_board_scope.is_main_board_ts_code"},
        "monthly_as_of_count": {"const": 96},
        "monthly_as_of_dates": {
          "type": "array",
          "items": {"$ref": "#/$defs/date8"},
          "minItems": 96,
          "maxItems": 96,
          "uniqueItems": true
        },
        "same_as_materialization_dates": {"const": true},
        "prior_audited_universe_count": {"const": 3387},
        "size_bucket_count": {"const": 5},
        "minimum_size_bucket_count_for_primary_percentile": {"const": 50},
        "top500_symbols_written_to_tracked_report": {"const": false},
        "not_signal_search": {"const": true}
      }
    },
    "selfTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "checker_origin", "status", "detected_expected_violation"],
      "properties": {
        "fixture_id": {
          "enum": [
            "materialization_summary_scope_creep_blocks",
            "missing_raw_ref_blocks",
            "main_board_filter_excludes_non_main_high_caps",
            "sparse_top500_blocks",
            "prior_universe_gap_blocks"
          ]
        },
        "checker_origin": {"const": "large_cap_market_cap_audit_runner"},
        "status": {"const": "pass"},
        "detected_expected_violation": {"const": true}
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "hard_check", "blocks_signal_search", "metrics", "findings", "allowed_followup"],
      "properties": {
        "check_id": {
          "enum": [
            "materialization_summary_gate",
            "raw_payload_shape_and_refs",
            "top500_rederivation_consistency",
            "main_board_filter_integrity",
            "prior_full_main_board_universe_bridge",
            "size_quintile_coverage"
          ]
        },
        "status": {
          "enum": [
            "pass_large_cap_market_cap_audit",
            "fail_data_not_ready",
            "blocked_missing_required_source"
          ]
        },
        "hard_check": {"const": true},
        "blocks_signal_search": {"type": "boolean"},
        "metrics": {"$ref": "#/$defs/flexibleObject"},
        "findings": {"$ref": "#/$defs/stringList"},
        "allowed_followup": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "monthlyCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "raw_row_count",
        "summary_row_count",
        "date_mismatch_count",
        "main_board_row_count",
        "positive_main_board_circ_mv_count",
        "selected_top500_count",
        "selected_top500_complete",
        "selected_top500_min_circ_mv",
        "selected_top500_max_circ_mv",
        "summary_rederivation_mismatch",
        "outside_prior_audited_universe_count",
        "outside_prior_audited_universe_sample",
        "size_q1_count",
        "size_q2_count",
        "size_q3_count",
        "size_q4_count",
        "size_q5_count",
        "minimum_size_quintile_count",
        "top500_symbols_written_to_tracked_report"
      ],
      "properties": {
        "as_of": {"$ref": "#/$defs/date8"},
        "raw_row_count": {"type": "integer", "minimum": 0},
        "summary_row_count": {"type": ["integer", "null"], "minimum": 0},
        "date_mismatch_count": {"type": "integer", "minimum": 0},
        "main_board_row_count": {"type": "integer", "minimum": 0},
        "positive_main_board_circ_mv_count": {"type": "integer", "minimum": 0},
        "selected_top500_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "selected_top500_complete": {"type": "boolean"},
        "selected_top500_min_circ_mv": {"$ref": "#/$defs/nullableNumber"},
        "selected_top500_max_circ_mv": {"$ref": "#/$defs/nullableNumber"},
        "summary_rederivation_mismatch": {"type": "boolean"},
        "outside_prior_audited_universe_count": {"type": "integer", "minimum": 0},
        "outside_prior_audited_universe_sample": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 20
        },
        "size_q1_count": {"type": "integer", "minimum": 0},
        "size_q2_count": {"type": "integer", "minimum": 0},
        "size_q3_count": {"type": "integer", "minimum": 0},
        "size_q4_count": {"type": "integer", "minimum": 0},
        "size_q5_count": {"type": "integer", "minimum": 0},
        "minimum_size_quintile_count": {"type": "integer", "minimum": 0},
        "top500_symbols_written_to_tracked_report": {"const": false}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_status",
        "hard_checks_pass",
        "market_cap_universe_ready_for_signal_package_after_review",
        "signal_search_package_may_be_built_after_review",
        "signal_search_authorized_by_this_report",
        "alpha_found",
        "plain_result",
        "next_action"
      ],
      "properties": {
        "audit_status": {
          "enum": [
            "passed_large_cap_market_cap_audit_for_signal_package",
            "fail_data_not_ready",
            "blocked_missing_required_source"
          ]
        },
        "hard_checks_pass": {"type": "boolean"},
        "market_cap_universe_ready_for_signal_package_after_review": {"type": "boolean"},
        "signal_search_package_may_be_built_after_review": {"type": "boolean"},
        "signal_search_authorized_by_this_report": {"const": false},
        "alpha_found": {"const": false},
        "plain_result": {"$ref": "#/$defs/nonEmptyString"},
        "next_action": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "prohibitedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_long_alpha_found",
        "signal_search_executed",
        "signal_search_authorized",
        "alpha_backtest_executed",
        "production_ready",
        "ship_gate_evidence",
        "full_size_allowed",
        "provider_selected",
        "datahub_authorized",
        "broker_or_order_automation_authorized"
      ],
      "properties": {
        "a_long_alpha_found": {"const": false},
        "signal_search_executed": {"const": false},
        "signal_search_authorized": {"const": false},
        "alpha_backtest_executed": {"const": false},
        "production_ready": {"const": false},
        "ship_gate_evidence": {"const": false},
        "full_size_allowed": {"const": false},
        "provider_selected": {"const": false},
        "datahub_authorized": {"const": false},
        "broker_or_order_automation_authorized": {"const": false}
      }
    }
  }
}
