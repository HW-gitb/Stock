{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_overlay_eval_summary",
  "description": "A-short overlay §6 readiness + promotion-review reminder artifact (comparison-track, non-production). Counts forward overlay observations and flags promotion_review_due at the governance min_forward_observations; does NOT compute outperformance metrics or auto-promote (that needs the still-unfrozen stable_win_margin + a separate metrics slice).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "generated_at", "as_of", "track",
    "min_forward_observations", "n_forward_observations", "promotion_review_due",
    "stable_win_margin_frozen", "decision_status", "benchmarks_required",
    "metrics_required", "forward_observations", "boundary"
  ],
  "properties": {
    "schema_name": {"const": "a_short_overlay_eval_summary"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "track": {"const": "comparison_non_production"},
    "min_forward_observations": {"type": "integer", "minimum": 1},
    "n_forward_observations": {"type": "integer", "minimum": 0},
    "promotion_review_due": {"type": "boolean"},
    "stable_win_margin_frozen": {"type": "boolean"},
    "decision_status": {"enum": ["accumulating", "review_due_margin_pending", "review_due_ready"]},
    "benchmarks_required": {"type": "array", "items": {"type": "string"}},
    "metrics_required": {"type": "array", "items": {"type": "string"}},
    "forward_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["as_of", "generated_at", "candidate_count"],
        "properties": {
          "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
          "generated_at": {"type": "string"},
          "candidate_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "is_promotion_decision", "satisfies_ship_gate"],
      "properties": {
        "production": {"const": false},
        "is_promotion_decision": {"const": false},
        "satisfies_ship_gate": {"const": false}
      }
    }
  }
}
