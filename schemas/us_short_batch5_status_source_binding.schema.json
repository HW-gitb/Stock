              },
              "role": {
                "const": "US-short single design authority; §3.3 critical-status unknown must not be assumed clean, §3.7 provider health; batch5 status-source fetch remains gated under SR-PROVIDER-001."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "source_artifact_refs": {
          "contains": {
            "required": [
              "artifact_id",
              "path",
              "role"
            ],
            "properties": {
