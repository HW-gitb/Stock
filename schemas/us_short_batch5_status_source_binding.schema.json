                "const": "Open provider blocker; this binding does not authorize the live status fetch, only freezes the schema-first per-flag source contract for a later reviewed status-source access packet + preflight."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "source_artifact_refs": {
