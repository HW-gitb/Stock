{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "us_short_batch5_status_source_binding",
  "title": "US-short batch5 status-source binding (offline contract)",
  "description": "Schema-first contract binding the four US-short eligibility disqualifying status flags (delisted/halted/otc/bankruptcy) to their authorized real data sources with per-flag provenance + unknown policy, closing R-USSHORT-BATCH5-PASS1-CRITICAL-STATUS-HEALTH-FAILOPEN. STRUCTURE + boundary only: it authorizes NO live status-source call (the live fetch needs a separate reviewed access packet + preflight). All const-pinned so a same-shaped artifact cannot drift the source/flag/unknown-policy/no-authorize boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "source_artifact_refs",
    "scope",
    "review_basis",
    "binding_summary",
    "status_flag_bindings",
    "provider_failure_health_policy",
    "decision_gates",
    "prohibited_actions",
    "next_authorization_boundary",
    "limitations",
    "next_steps"
  ],
  "allOf": [
    {
      "properties": {
        "status_flag_bindings": {
          "contains": {
            "required": [
              "flag_id",
              "authorized_source_id",
              "endpoint_family",
              "unknown_policy",
              "provenance_required",
              "status_semantics",
              "derivation_evidence_rule"
            ],
            "properties": {
              "flag_id": {
                "const": "delisted"
              },
              "authorized_source_id": {
                "const": "ticker_reference"
              },
              "endpoint_family": {
                "const": "active_listing_reference"
              },
              "unknown_policy": {
                "const": "conservative_reject"
              },
              "provenance_required": {
                "const": [
                  "source_id",
                  "as_of",
                  "observed_at",
                  "reference_active_value",
                  "coverage"
                ]
              },
              "status_semantics": {
                "const": "clean_false requires a positive reference observation that the symbol is an active listing at as_of; reference active=false OR absence from the active-listing reference at as_of -> delisted (True); no reference observation -> unknown."
              },
              "derivation_evidence_rule": {
                "const": "a same-session grouped-daily trade is NOT sufficient evidence of listing status; the active-listing reference is the authoritative source for delisting."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "status_flag_bindings": {
          "contains": {
            "required": [
              "flag_id",
              "authorized_source_id",
              "endpoint_family",
              "unknown_policy",
              "provenance_required",
              "status_semantics",
              "derivation_evidence_rule"
            ],
            "properties": {
              "flag_id": {
                "const": "halted"
              },
              "authorized_source_id": {
                "const": "exchange_halt_feed"
              },
              "endpoint_family": {
                "const": "public_trading_halt_feed"
              },
              "unknown_policy": {
                "const": "conservative_reject"
              },
              "provenance_required": {
                "const": [
                  "source_id",
                  "as_of",
                  "observed_at",
                  "halt_feed_observed",
                  "coverage"
                ]
              },
              "status_semantics": {
                "const": "True if the symbol appears in the exchange trading-halt feed effective at the decision PIT (prior settled session); clean_false requires the halt feed to have been observed and the symbol absent; feed unavailable -> unknown. Intraday halts that resolved before the PIT are not a standing disqualifier."
              },
              "derivation_evidence_rule": {
                "const": "absence from price/volume data is NOT evidence of a halt; only the halt feed sets the flag."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "status_flag_bindings": {
          "contains": {
            "required": [
              "flag_id",
              "authorized_source_id",
              "endpoint_family",
              "unknown_policy",
              "provenance_required",
              "status_semantics",
              "derivation_evidence_rule"
            ],
            "properties": {
              "flag_id": {
                "const": "otc"
              },
              "authorized_source_id": {
                "const": "ticker_reference"
              },
              "endpoint_family": {
                "const": "primary_exchange_reference"
              },
              "unknown_policy": {
                "const": "conservative_reject"
              },
              "provenance_required": {
                "const": [
                  "source_id",
                  "as_of",
                  "observed_at",
                  "primary_exchange_value",
                  "coverage"
                ]
              },
              "status_semantics": {
                "const": "True if the reference primary exchange/market is an OTC venue; clean_false requires a positive reference observation that the primary exchange is an authorized NYSE/NASDAQ venue (the §3.1 exchange whitelist); no reference observation -> unknown. This binds the explicit otc flag to the same reference exchange field the whitelist already screens."
              },
              "derivation_evidence_rule": {
                "const": "the exchange whitelist already rejects non-NYSE/NASDAQ; this flag records the explicit OTC determination with its reference provenance, never a hardwired False."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "status_flag_bindings": {
          "contains": {
            "required": [
              "flag_id",
              "authorized_source_id",
              "endpoint_family",
              "unknown_policy",
              "provenance_required",
              "status_semantics",
              "derivation_evidence_rule"
            ],
            "properties": {
              "flag_id": {
                "const": "bankruptcy"
              },
              "authorized_source_id": {
                "const": "sec_8k_item_103"
              },
              "endpoint_family": {
                "const": "sec_8k_bankruptcy_filing_search"
              },
              "unknown_policy": {
                "const": "mark_unscreened_not_clean"
              },
              "provenance_required": {
                "const": [
                  "source_id",
                  "as_of",
                  "observed_at",
                  "lookback_window",
                  "filing_accession_if_found",
                  "coverage",
                  "screen_status"
                ]
              },
              "status_semantics": {
                "const": "bankrupt_8k_found (True/reject) if an SEC 8-K Item 1.03 (Bankruptcy or Receivership) is found for the issuer within the lookback window; screened_no_filing (best-effort clean_false) if the 8-K search ran over the lookback window and found none; unscreened if the search did not run. There is NO positive proof of non-bankruptcy, so clean_false is a BEST-EFFORT negative, never an assumption."
              },
              "derivation_evidence_rule": {
                "const": "absence of an 8-K is recorded as screened_no_filing (best-effort), NOT proof of solvency; the run records bankruptcy_screen_coverage and flags any unscreened universe explicitly."
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "source_artifact_refs": {
