{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/a_short_weekly_publish_receipt.schema.json",
  "title": "A-short weekly publish receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "as_of",
    "stage_status"
  ],
  "properties": {
    "schema_name": {
      "const": "a_short_weekly_publish_receipt"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "decision_as_of": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "run_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{8}$"
    },
    "price_data_through": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "price_basis": {
      "type": "string",
      "enum": ["prior_settled", "close"],
      "description": "Which price clock produced price_as_of. Production is always prior_settled (the trading day strictly before the decision day); close is explicit historical research only and is refused unless that decision day has already settled. Recorded so a receipt can never leave the basis implicit -- the defect this replaced was two entry points silently choosing different bases for the same decision day."
    },
    "price_as_of": {
      "type": "string",
      "pattern": "^[0-9]{8}$",
      "description": "The resolved price basis date for this run, from runners/resolve_canonical_asof.py::resolve_price_as_of."
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "account_snapshot": {
      "type": [
        "object",
        "null"
      ]
    },
    "iv_feed_status": {
      "enum": ["not_requested", "build_failed", "digest_failed", "clock_mismatch", "ready"]
    },
    "stage_status": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs_digest": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/output_digest"
      }
    },
    "failure_reason": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer"
    },
    "failure_detail_ref": {
      "type": "string",
      "minLength": 1
    },
    "attempted_before_egs": {
      "type": "boolean"
    },
    "feed_ref": {
      "type": "string",
      "minLength": 1
    },
    "feed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage_status": {
            "const": "complete"
          }
        },
        "required": [
          "stage_status"
        ]
      },
      "then": {
        "required": [
          "decision_as_of",
          "run_date",
          "price_data_through",
          "run_id",
          "candidate_digest",
          "published_at",
          "account_snapshot",
          "outputs",
          "outputs_digest"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "failure_reason"
              ]
            },
            {
              "required": [
                "exit_code"
              ]
            },
            {
              "required": [
                "failure_detail_ref"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "failure_reason",
          "exit_code"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "decision_as_of"
              ]
            },
            {
              "required": [
                "run_date"
              ]
            },
            {
              "required": [
                "price_data_through"
              ]
            },
            {
              "required": [
                "published_at"
              ]
            },
            {
              "required": [
                "account_snapshot"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            },
            {
              "required": [
                "outputs_digest"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "output_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_length"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
