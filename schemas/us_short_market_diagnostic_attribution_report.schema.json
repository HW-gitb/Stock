{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_market_diagnostic_attribution_report.schema.json",
  "title": "US-short v1.1 attribution report",
  "description": "Diagnostic-only decomposition of strategy excess into exposure and active-system effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "attribution_epoch",
    "diagnostic_epoch",
    "window_id",
    "status",
    "weeks",
    "summary",
    "source_refs",
    "boundary"
  ],
  "properties": {
    "schema_name": {
      "const": "us_short_market_diagnostic_attribution_report"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "attribution_epoch": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_epoch": {
      "type": "string",
      "minLength": 1
    },
    "window_id": {
      "type": "string",
      "pattern": "^26w-[1-9][0-9]*-[1-9][0-9]*$"
    },
    "status": {
      "enum": [
        "evaluable",
        "unavailable"
      ]
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 26,
      "items": {
        "$ref": "#/definitions/week"
      }
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sha256"
      },
      "minItems": 1,
      "maxItems": 26,
      "uniqueItems": true,
      "description": "One pointer per week: the weekly_record_sha256 of every week this packet summarises. Deliberately NOT the union of every week's provenance — that flat rollup blew its own ceiling around week 24 with real per-ETF dividend digests, making the 26-week window this module exists for unreachable. Each week's own source_refs stays complete, so an auditor walks root -> week -> observation."
    },
    "boundary": {
      "$ref": "#/definitions/boundary"
    }
  },
  "definitions": {
    "date8": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "number_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_week_index",
        "decision_date",
        "valuation_date",
        "weekly_record_sha256",
        "status",
        "strategy_weekly_return",
        "vti_total_return",
        "cash_weekly_return",
        "g_star",
        "requested_exposure",
        "constraint_exposures",
        "matched_target_return",
        "raw_excess",
        "exposure_effect",
        "active_system_effect",
        "identity_residual",
        "binding_constraints",
        "source_refs",
        "unavailable_reasons",
        "target_exposure_source_refs"
      ],
      "properties": {
        "calendar_week_index": {
          "type": "integer",
          "minimum": 1
        },
        "decision_date": {
          "$ref": "#/definitions/date8"
        },
        "valuation_date": {
          "$ref": "#/definitions/date8"
        },
        "weekly_record_sha256": {
          "allOf": [
            {
              "$ref": "#/definitions/sha256"
            }
          ],
          "description": "This week's own pointer, the one the report root must name. Without it the root/week binding could only ask 'does this week share ANY digest with the root', which every week carrying week 1's digest satisfied. Expressed via allOf rather than a bare $ref with siblings: draft-07 ignores keys beside a $ref, so any real constraint added next to one would be silently inert."
        },
        "status": {
          "enum": [
            "evaluable",
            "unavailable"
          ]
        },
        "strategy_weekly_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "vti_total_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "cash_weekly_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "g_star": {
          "$ref": "#/definitions/number_or_null"
        },
        "requested_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "constraint_exposures": {
          "$ref": "#/definitions/constraint_exposures"
        },
        "matched_target_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "raw_excess": {
          "$ref": "#/definitions/number_or_null"
        },
        "exposure_effect": {
          "$ref": "#/definitions/number_or_null"
        },
        "active_system_effect": {
          "$ref": "#/definitions/number_or_null"
        },
        "identity_residual": {
          "$ref": "#/definitions/number_or_null"
        },
        "binding_constraints": {
          "type": "array",
          "items": {
            "enum": [
              "requested_exposure",
              "cash_capacity_exposure",
              "environment_position_cap",
              "long_only_cap"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sha256"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "unavailable_reasons": {
          "$ref": "#/definitions/reasons"
        },
        "target_exposure_source_refs": {
          "description": "What the producer named as the source of this week's target exposure. Carried so a reader can at least see what is being claimed; the report previously published exposures with no provenance of their own at all.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/sha256"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "constraint_exposures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_exposure",
        "carried_holdings_exposure",
        "new_order_exposure",
        "cash_capacity_exposure",
        "environment_position_cap",
        "long_only_cap"
      ],
      "properties": {
        "requested_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "carried_holdings_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "new_order_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "cash_capacity_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "environment_position_cap": {
          "$ref": "#/definitions/number_or_null"
        },
        "long_only_cap": {
          "$ref": "#/definitions/number_or_null"
        }
      },
      "description": "Every constraint the rule-implied g* is the minimum of, plus the two components requested_exposure is declared to come from. PRODUCER-ASSERTED: the validator re-derives g* from these values and re-derives requested_exposure as carried + new, but nothing here can check the components themselves against a holding, an order or a NAV -- design 12.7 forbids this module from reading fills. A filled position split across the two components still validates. Treat these as the producer's claim about what the rules asked for, not as a verified fact; the binding belongs to the target-exposure producer, which does not exist yet."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_weeks",
        "evaluable_weeks",
        "unavailable_weeks",
        "strategy_cumulative_return",
        "vti_cumulative_return",
        "matched_target_cumulative_return",
        "raw_excess",
        "exposure_effect",
        "active_system_effect",
        "identity_residual",
        "weekly_identity_max_abs_residual"
      ],
      "properties": {
        "calendar_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26
        },
        "evaluable_weeks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26
        },
        "unavailable_weeks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26
        },
        "strategy_cumulative_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "vti_cumulative_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "matched_target_cumulative_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "raw_excess": {
          "$ref": "#/definitions/number_or_null"
        },
        "exposure_effect": {
          "$ref": "#/definitions/number_or_null"
        },
        "active_system_effect": {
          "$ref": "#/definitions/number_or_null"
        },
        "identity_residual": {
          "$ref": "#/definitions/number_or_null"
        },
        "weekly_identity_max_abs_residual": {
          "$ref": "#/definitions/number_or_null"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "comparison_only",
        "counts_ship_gate",
        "changes_selection_or_action",
        "automatic_policy_switch",
        "broker_or_order_automation",
        "v1_record_mutated",
        "historical_backfill_performed",
        "provider_fetch_performed",
        "account_write_performed"
      ],
      "properties": {
        "diagnostic_only": {
          "const": true
        },
        "comparison_only": {
          "const": true
        },
        "counts_ship_gate": {
          "const": false
        },
        "changes_selection_or_action": {
          "const": false
        },
        "automatic_policy_switch": {
          "const": false
        },
        "broker_or_order_automation": {
          "const": false
        },
        "v1_record_mutated": {
          "const": false
        },
        "historical_backfill_performed": {
          "const": false
        },
        "provider_fetch_performed": {
          "const": false
        },
        "account_write_performed": {
          "const": false
        }
      }
    }
  }
}
