{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_llm_theme_discovery_parent_plan.schema.json",
  "title": "US-short soft-discovery immutable pre-dispatch parent query plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "plan_identity", "canonical_plan_core", "activation_status", "effect_boundary"],
  "properties": {
    "schema_name": {"const": "us_short_llm_theme_discovery_parent_plan"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "plan_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_plan_core": {"$ref": "#/definitions/parent_core"},
    "activation_status": {"const": "candidate_offline"},
    "effect_boundary": {"$ref": "#/definitions/effect_boundary"}
  },
  "definitions": {
    "parent_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_date", "policy_version", "policy_template_content_sha256", "stage1_queries", "stage2_rule_sha256", "provider_envelopes"],
      "properties": {
        "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"},
        "policy_template_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stage1_queries": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {"$ref": "#/definitions/stage1_query"}
        },
        "stage2_rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_envelopes": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/definitions/provider_envelope"}
        }
      }
    },
    "stage1_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "query_text"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "provider_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "stage1_max_dispatch_count", "stage2_max_dispatch_count", "retry_max_dispatch_count", "max_dispatch_count"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
        "stage1_max_dispatch_count": {"type": "integer", "minimum": 0},
        "stage2_max_dispatch_count": {"type": "integer", "minimum": 0},
        "retry_max_dispatch_count": {"type": "integer", "minimum": 0},
        "max_dispatch_count": {"type": "integer", "minimum": 0}
      }
    },
    "effect_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "dynamic_seats_enabled", "theme_probe_enabled", "lifecycle_actions_enabled"],
      "properties": {
        "scoring_eligible": {"const": false},
        "top15_effect_enabled": {"const": false},
        "operation_advice_effect_enabled": {"const": false},
        "dynamic_seats_enabled": {"const": false},
        "theme_probe_enabled": {"const": false},
        "lifecycle_actions_enabled": {"const": false}
      }
    }
  }
}
