{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_cut5_massive_news_binding.schema.json",
  "title": "US-short Cut 5-d Massive news source binding",
  "description": "Frozen schema-first contract for the offline Massive/Polygon news (§4.2 新闻催化剂 / §5.1b advisory) source. Const-pins provider/endpoint, recency window, per-ticker sentiment enum + unknown fallback, required record fields, provenance fields, coverage/parser enums, emission fitness, decision tz. Offline shape only; live fetch gated under SR-PROVIDER-001.",
  "type": "object",
  "required": [
    "binding_name", "binding_version", "provider_id", "endpoint_or_filing_type", "decision_timezone",
    "recency_window_days", "sentiment_allowed", "sentiment_unknown", "record_fields_required",
    "ticker_coverage_rule", "summary_contract", "pit_rule", "provenance_fields",
    "coverage_status_allowed", "parser_status_allowed", "emission_fitness",
    "pit_clock_contract", "duplicate_policy", "checked_empty_disposition", "lineage_ref_format",
    "authorization_boundary"
  ],
  "properties": {
    "binding_name": { "const": "us_short_cut5_massive_news_binding" },
    "binding_version": { "type": "string" },
    "design_authority": { "type": "string" },
    "authorization_note": { "type": "string" },
    "provider_id": { "const": "massive" },
    "endpoint_or_filing_type": { "const": "reference_news" },
    "decision_timezone": { "const": "America/New_York" },
    "recency_window_days": { "const": 30 },
    "recency_window_basis": { "type": "string" },
    "sentiment_allowed": { "const": ["positive", "negative", "neutral"] },
    "sentiment_unknown": { "const": "unknown" },
    "sentiment_note": { "type": "string" },
    "record_fields_required": {
      "const": ["id", "published_utc", "publisher", "title", "tickers", "insights"]
    },
    "ticker_coverage_rule": { "type": "string" },
    "summary_contract": {
      "type": "object",
      "required": ["over", "fields", "net_sentiment"],
      "properties": {
        "over": { "type": "string" },
        "fields": { "const": ["news_count", "distinct_publishers", "positive", "negative", "neutral", "unknown", "net_sentiment", "window_days"] },
        "net_sentiment": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pit_rule": { "type": "string" },
    "provenance_fields": {
      "const": ["provider_id", "endpoint_or_filing_type", "source_as_of", "observed_at", "coverage_status", "parser_status", "lineage_ref"]
    },
    "coverage_status_allowed": { "const": ["full", "partial", "missing"] },
    "parser_status_allowed": { "const": ["ok", "degraded", "failed"] },
    "emission_fitness": {
      "type": "object",
      "required": ["coverage_status", "parser_status"],
      "properties": {
        "coverage_status": { "const": "full" },
        "parser_status": { "const": "ok" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "date_format": { "type": "string" },
    "consumer_note": { "type": "string" },
    "pit_clock_contract": {
      "type": "object",
      "required": ["observed_at_cutoff_operator", "observed_at_cutoff_reference", "chronology_order", "chronology_relation"],
      "properties": {
        "observed_at_cutoff_operator": { "const": "strictly_before" },
        "observed_at_cutoff_reference": { "const": "decision_session_open" },
        "chronology_order": { "const": ["published_utc", "observed_at", "source_as_of", "as_of"] },
        "chronology_relation": { "const": "non_decreasing" }
      },
      "additionalProperties": false
    },
    "duplicate_policy": {
      "type": "object",
      "required": ["source_row_identity", "publisher_identity_normalization", "on_duplicate"],
      "properties": {
        "source_row_identity": { "const": "id" },
        "publisher_identity_normalization": { "const": "strip_and_casefold" },
        "on_duplicate": { "const": "reject" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checked_empty_disposition": { "const": "checked_no_recent_news" },
    "checked_empty_note": { "type": "string" },
    "lineage_ref_format": {
      "type": "object",
      "required": ["structure", "record_id_rule"],
      "properties": {
        "structure": { "const": "provider_id:endpoint_or_filing_type:source_as_of#record_id" },
        "record_id_rule": { "const": "nonempty_ascii_no_colon_hash_whitespace" }
      },
      "additionalProperties": false
    },
    "authorization_boundary": {
      "type": "object",
      "required": ["live_fetch", "network", "raw_capture", "runner_wired", "datahub", "production", "ship_gate"],
      "properties": {
        "live_fetch": { "const": false },
        "network": { "const": false },
        "raw_capture": { "const": false },
        "runner_wired": { "const": false },
        "datahub": { "const": false },
        "production": { "const": false },
        "ship_gate": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
