{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A-short industry-weight comparison private capture or outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "record_type", "program_id", "decision_date", "epoch_id", "contract_fingerprint", "payload", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_industry_weight_comparison_private_record"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"enum": ["capture", "outcome", "conflict"]},
    "program_id": {"const": "a_short_industry_weight_comparison_v1"},
    "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "epoch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "boundary": {"type": "object", "additionalProperties": false,
      "required": ["comparison_only", "automatic_policy_switch", "reads_account_or_holdings"],
      "properties": {"comparison_only": {"const": true}, "automatic_policy_switch": {"const": false}, "reads_account_or_holdings": {"const": false}, "p5b_implemented": {"type": "boolean"}}}
  }
}
