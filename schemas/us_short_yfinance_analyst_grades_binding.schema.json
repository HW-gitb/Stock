{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_yfinance_analyst_grades_binding.schema.json",
  "title": "US-short yfinance analyst-grades source binding",
  "description": "Frozen schema-first contract for the low-trust yfinance upgrades_downgrades analyst-grade source. Const-pins provider/endpoint, action direction map, PIT, duplicate, checked-empty, non-critical, and authorization boundaries.",
  "type": "object",
  "required": [
    "binding_name",
    "binding_version",
    "provider_id",
    "endpoint_or_filing_type",
    "decision_timezone",
    "recency_window_days",
    "direction_map",
    "record_fields_required",
    "summary_contract",
    "pit_rule",
    "provenance_fields",
    "coverage_status_allowed",
    "parser_status_allowed",
    "emission_fitness",
    "pit_clock_contract",
    "duplicate_policy",
    "checked_empty_disposition",
    "lineage_ref_format",
    "authorization_boundary"
  ],
  "properties": {
    "binding_name": { "const": "us_short_yfinance_analyst_grades_binding" },
    "binding_version": { "type": "string" },
    "design_authority": { "type": "string" },
    "authorization_note": { "type": "string" },
    "provider_id": { "const": "yfinance" },
    "endpoint_or_filing_type": { "const": "upgrades_downgrades" },
    "decision_timezone": { "const": "America/New_York" },
    "recency_window_days": { "const": 90 },
    "recency_window_basis": { "type": "string" },
    "direction_map": {
      "type": "object",
      "required": ["up", "down", "_default"],
      "properties": {
        "up": { "const": "up" },
        "down": { "const": "down" },
        "_default": { "const": "neutral" }
      },
      "additionalProperties": false
    },
    "direction_note": { "type": "string" },
    "record_fields_required": {
      "const": ["GradeDate", "Action", "Firm", "ToGrade", "FromGrade"]
    },
    "summary_contract": {
      "type": "object",
      "required": ["over", "fields", "net"],
      "properties": {
        "over": { "type": "string" },
        "fields": {
          "const": ["upgrades", "downgrades", "neutrals", "net", "distinct_firms", "distinct_downgrading_firms", "window_days"]
        },
        "net": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pit_rule": { "type": "string" },
    "provenance_fields": {
      "const": ["provider_id", "endpoint_or_filing_type", "source_as_of", "observed_at", "coverage_status", "parser_status", "lineage_ref"]
    },
    "coverage_status_allowed": { "const": ["full", "partial", "missing"] },
    "parser_status_allowed": { "const": ["ok", "degraded", "failed"] },
    "emission_fitness": {
      "type": "object",
      "required": ["coverage_status", "parser_status"],
      "properties": {
        "coverage_status": { "const": "full" },
        "parser_status": { "const": "ok" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "date_format": { "type": "string" },
    "consumer_note": { "type": "string" },
    "pit_clock_contract": {
      "type": "object",
      "required": ["observed_at_cutoff_operator", "observed_at_cutoff_reference", "chronology_order", "chronology_relation"],
      "properties": {
        "observed_at_cutoff_operator": { "const": "strictly_before" },
        "observed_at_cutoff_reference": { "const": "decision_session_open" },
        "chronology_order": { "const": ["record_date", "observed_at", "source_as_of", "as_of"] },
        "chronology_relation": { "const": "non_decreasing" }
      },
      "additionalProperties": false
    },
    "duplicate_policy": {
      "type": "object",
      "required": ["source_row_identity", "firm_identity_normalization", "on_duplicate"],
      "properties": {
        "source_row_identity": { "const": ["record_date", "firm", "action", "to_grade", "from_grade"] },
        "firm_identity_normalization": { "const": "strip_and_casefold" },
        "on_duplicate": { "const": "reject" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checked_empty_disposition": { "const": "checked_no_recent_activity" },
    "checked_empty_note": { "type": "string" },
    "lineage_ref_format": {
      "type": "object",
      "required": ["structure", "record_id_rule"],
      "properties": {
        "structure": { "const": "provider_id:endpoint_or_filing_type:source_as_of#record_id" },
        "record_id_rule": { "const": "nonempty_ascii_no_colon_hash_whitespace" }
      },
      "additionalProperties": false
    },
    "authorization_boundary": {
      "type": "object",
      "required": [
        "live_fetch",
        "network",
        "raw_capture",
        "datahub",
        "production",
        "ship_gate",
        "emit_gate",
        "critical_provider_health"
      ],
      "properties": {
        "live_fetch": { "const": false },
        "network": { "const": false },
        "raw_capture": { "const": false },
        "datahub": { "const": false },
        "production": { "const": false },
        "ship_gate": { "const": false },
        "emit_gate": { "const": false },
        "critical_provider_health": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
