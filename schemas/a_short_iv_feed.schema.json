{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_iv_feed",
  "description": "A-short 50ETF IV feed artifact: per PIT trade_date (<= as_of) a constant-maturity ATM IV (BS-inverted) + its 252d rolling percentile + the 50ETF realized vol (hv_value, trailing hv_window log-returns annualized). Feasibility-grade (approx r/q); not production/ship-gate. Consumed by Slice B market_context.volatility; engine emits the #6 IV-HV advisory tag from iv_value/hv_value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "as_of", "underlying",
               "params", "n_days", "series", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_iv_feed"},
    "schema_version": {"enum": ["1.1.0", "1.2.0"]},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "underlying": {"const": "510050.SH"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_free", "div_yield", "const_maturity_days", "min_t_days", "roll_window", "min_roll_obs", "hv_window"],
      "properties": {
        "risk_free": {"const": 0.02},
        "div_yield": {"const": 0.0},
        "const_maturity_days": {"const": 30},
        "min_t_days": {"const": 5},
        "roll_window": {"const": 252},
        "min_roll_obs": {"const": 60},
        "hv_window": {"const": 21}
      }
    },
    "n_days": {"type": "integer", "minimum": 0},
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "trade_dates"],
      "properties": {
        "status": {"enum": ["available", "calendar_unavailable"]},
        "source": {"enum": ["tushare.trade_cal", "tushare.trade_cal+fund_daily", "calendar_unavailable"]},
        "trade_dates": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{8}$"},
          "uniqueItems": true
        },
        "coverage_start": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{8}$"},
            {"type": "null"}
          ]
        },
        "coverage_end": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{8}$"},
            {"type": "null"}
          ]
        },
        "n_trade_dates": {"type": "integer", "minimum": 0},
        "trade_dates_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "probed_trade_dates": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{8}$"},
          "uniqueItems": true
        },
        "probed_trade_dates_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
        ,"independent_source": {"const": "tushare.fund_daily"}
        ,"independent_trade_dates": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{8}$"},
          "uniqueItems": true
        }
        ,"independent_trade_dates_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}, "required": ["status"]},
          "then": {
            "required": ["coverage_start", "coverage_end", "n_trade_dates",
                          "trade_dates_sha256", "probed_trade_dates", "probed_trade_dates_sha256"],
            "properties": {
              "trade_dates": {"minItems": 1},
              "probed_trade_dates": {"minItems": 1},
              "coverage_start": {"type": "string"},
              "coverage_end": {"type": "string"},
              "n_trade_dates": {"minimum": 1},
              "trade_dates_sha256": {"pattern": "^[0-9a-f]{64}$"},
              "probed_trade_dates_sha256": {"pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "calendar_unavailable"}}, "required": ["status"]},
          "then": {
            "properties": {
              "trade_dates": {"maxItems": 0},
              "source": {"const": "calendar_unavailable"},
              "coverage_start": {"type": "null"},
              "coverage_end": {"type": "null"},
              "n_trade_dates": {"const": 0},
              "trade_dates_sha256": {"const": ""},
              "probed_trade_dates": {"maxItems": 0},
              "probed_trade_dates_sha256": {"const": ""},
              "independent_trade_dates": {"maxItems": 0},
              "independent_trade_dates_sha256": {"const": ""}
            }
          }
        },
        {
          "if": {
            "properties": {"source": {"const": "tushare.trade_cal+fund_daily"}},
            "required": ["source"]
          },
          "then": {
            "required": ["independent_source", "independent_trade_dates", "independent_trade_dates_sha256"],
            "properties": {
              "status": {"const": "available"},
              "independent_trade_dates": {"minItems": 1},
              "independent_trade_dates_sha256": {"pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trade_date", "iv_value", "iv_percentile_252d", "hv_value"],
        "properties": {
          "trade_date": {"type": "string", "pattern": "^[0-9]{8}$"},
          "iv_value": {"type": "number", "exclusiveMinimum": 0},
          "iv_percentile_252d": {
            "anyOf": [
              {"type": "number", "minimum": 0, "maximum": 100},
              {"type": "null"}
            ]
          },
          "hv_value": {
            "anyOf": [
              {"type": "number", "minimum": 0},
              {"type": "null"}
            ]
          },
          "iv_change_abs_1d_pctpt": {
            "anyOf": [
              {"type": "number", "minimum": 0},
              {"type": "null"}
            ]
          },
          "rule3_status": {
            "enum": ["normal", "reduce_new_position_50pct", "no_trade", "unknown"]
          },
          "awakening_status": {
            "enum": ["inactive", "active", "cooldown", "unknown"]
          },
          "cash_reclaim_pct": {
            "anyOf": [
              {"type": "number", "minimum": 0, "maximum": 100},
              {"type": "null"}
            ]
          },
          "awakening_baseline_iv": {
            "anyOf": [
              {"type": "number", "exclusiveMinimum": 0},
              {"type": "null"}
            ]
          },
          "awakening_trigger_date": {
            "anyOf": [
              {"type": "string", "pattern": "^[0-9]{8}$"},
              {"type": "null"}
            ]
          },
          "awakening_release_date": {
            "anyOf": [
              {"type": "string", "pattern": "^[0-9]{8}$"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "awakening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_date", "iv_change_abs_1d_pctpt", "rule3_status", "status",
                    "cash_reclaim_pct", "baseline_iv", "trigger_date", "release_date",
                    "production_effect_enabled", "source"],
      "properties": {
        "trade_date": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{8}$"},
            {"type": "null"}
          ]
        },
        "iv_change_abs_1d_pctpt": {
          "anyOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "rule3_status": {
          "enum": ["normal", "reduce_new_position_50pct", "no_trade", "unknown"]
        },
        "status": {
          "enum": ["inactive", "active", "cooldown", "unknown"]
        },
        "cash_reclaim_pct": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 100},
            {"type": "null"}
          ]
        },
        "baseline_iv": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "trigger_date": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{8}$"},
            {"type": "null"}
          ]
        },
        "release_date": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9]{8}$"},
            {"type": "null"}
          ]
        },
        "production_effect_enabled": {"const": false},
        "source": {"const": "iv_series_state_machine_v1"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "real_money", "satisfies_ship_gate", "iv_method"],
      "properties": {
        "production": {"const": false},
        "real_money": {"const": false},
        "satisfies_ship_gate": {"const": false},
        "iv_method": {"const": "bs_atm_constant_maturity_feasibility_grade"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.2.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["awakening", "calendar"],
        "properties": {
          "series": {
            "items": {
              "required": ["iv_change_abs_1d_pctpt", "rule3_status", "awakening_status",
                            "cash_reclaim_pct", "awakening_baseline_iv", "awakening_trigger_date",
                            "awakening_release_date"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1.0"}},
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["calendar"]},
            {"required": ["awakening"]}
          ]
        },
        "properties": {
          "series": {
            "items": {
              "not": {
                "anyOf": [
                  {"required": ["iv_change_abs_1d_pctpt"]},
                  {"required": ["rule3_status"]},
                  {"required": ["awakening_status"]},
                  {"required": ["cash_reclaim_pct"]},
                  {"required": ["awakening_baseline_iv"]},
                  {"required": ["awakening_trigger_date"]},
                  {"required": ["awakening_release_date"]}
                ]
              }
            }
          }
        }
      }
    }
  ]
}
