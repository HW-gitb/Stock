{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "us_short_symbol_cooldown_state",
  "title": "US-short private symbol cooldown state",
  "description": "Private, gitignored state carrying only reconciled filled-failure cooldown facts. It is not a broker/order interface and is consumed solely to produce manual recommendations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "as_of", "records"],
  "properties": {
    "schema_name": {"const": "us_short_symbol_cooldown_state"},
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "records": {"type": "array", "items": {"$ref": "#/definitions/record"}}
  },
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "trigger", "triggered_at", "cooldown_until", "source_reconciliation_ref"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
        "trigger": {"enum": ["filled_then_stop_loss", "filled_then_breakout_failure"]},
        "triggered_at": {"type": "string", "pattern": "^[0-9]{8}$"},
        "cooldown_until": {"type": "string", "pattern": "^[0-9]{8}$"},
        "source_reconciliation_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
