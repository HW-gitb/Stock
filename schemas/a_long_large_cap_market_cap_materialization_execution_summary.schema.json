      "properties": {
        "call_id": {"type": "string", "pattern": "^daily_basic_market_cap_[0-9]{8}$"},
        "table_id": {"const": "daily_basic_market_cap_monthly"},
        "api_family": {"const": "daily_basic"},
        "request_shape_without_token": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trade_date", "fields"],
          "properties": {
            "trade_date": {"$ref": "#/$defs/date8"},
            "fields": {"const": "ts_code,trade_date,circ_mv"}
          }
        },
        "call_status": {"enum": ["success", "empty", "error"]},
        "trade_date": {"$ref": "#/$defs/date8"},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "columns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "minimum_fields_present": {
          "type": "array",
          "items": {"enum": ["ts_code", "trade_date", "circ_mv"]},
          "uniqueItems": true
        },
        "minimum_fields_missing": {
          "type": "array",
          "items": {"enum": ["ts_code", "trade_date", "circ_mv"]},
          "uniqueItems": true
        },
        "top500_main_board_stats": {"$ref": "#/$defs/top500MainBoardStats"},
        "raw_payload_ref": {"$ref": "#/$defs/nullableString"},
        "checkpoint_status": {"enum": ["written_new_raw", "reused_existing_raw"]},
        "tracked_summary_excludes_raw_rows": {"const": true},
        "tracked_summary_excludes_top500_symbols": {"const": true},
        "error_class": {"$ref": "#/$defs/nullableString"},
        "error_message_redacted": {"$ref": "#/$defs/nullableString"}
      }
