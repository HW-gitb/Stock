      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_board_row_count",
        "main_board_positive_selected_field_count",
        "selected_top500_count",
        "selected_top500_complete",
        "selected_market_cap_field",
        "top500_min_market_cap",
        "top500_max_market_cap",
        "top500_symbols_written_to_tracked_summary"
      ],
      "properties": {
        "main_board_row_count": {"type": "integer", "minimum": 0},
        "main_board_positive_selected_field_count": {"type": "integer", "minimum": 0},
        "selected_top500_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "selected_top500_complete": {"type": "boolean"},
        "selected_market_cap_field": {"const": "circ_mv"},
        "top500_min_market_cap": {"$ref": "#/$defs/nullableNumber"},
        "top500_max_market_cap": {"$ref": "#/$defs/nullableNumber"},
