      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "raw_output_root",
        "raw_output_root_is_gitignored",
        "max_total_endpoint_calls",
        "planned_total_endpoint_calls",
        "endpoint_results_count",
        "new_network_call_count",
        "reused_raw_payload_count",
        "budget_exceeded",
        "network_call_attempted",
        "environment_precheck_passed",
        "independent_review_confirmed",
        "post_review_execute_confirmed",
        "token_logged",
        "request_url_logged"
      ],
      "properties": {
        "summary_path": {"const": "docs/a_long_large_cap_market_cap_materialization_execution_summary_20260607.json"},
        "raw_output_root": {"const": "data/a_long/raw/tushare/large_cap_market_cap_materialization_20260607/"},
