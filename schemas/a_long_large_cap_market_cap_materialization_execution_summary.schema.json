    "generated_at",
    "artifact_id",
    "packet_ref",
    "preregistration_ref",
    "ledger_ref",
    "field_probe_summary_ref",
    "scope",
    "execution",
    "materialization_boundary",
    "coverage_rollup",
    "endpoint_results",
    "decision",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_large_cap_market_cap_materialization_execution_summary"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_large_cap_market_cap_materialization_execution_summary_20260607"},
    "packet_ref": {"const": "docs/a_long_large_cap_market_cap_materialization_packet_20260607.json"},
    "preregistration_ref": {"const": "research/preregistrations/a_long_large_cap_pure_quality_20260607.json"},
