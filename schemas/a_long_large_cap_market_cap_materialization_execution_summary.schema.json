        "max_total_endpoint_calls": {"const": 96},
        "planned_total_endpoint_calls": {"const": 96},
        "endpoint_results_count": {"type": "integer", "minimum": 0, "maximum": 96},
        "new_network_call_count": {"type": "integer", "minimum": 0, "maximum": 96},
        "reused_raw_payload_count": {"type": "integer", "minimum": 0, "maximum": 96},
        "budget_exceeded": {"const": false},
        "network_call_attempted": {"type": "boolean"},
        "environment_precheck_passed": {"type": "boolean"},
        "independent_review_confirmed": {"type": "boolean"},
        "post_review_execute_confirmed": {"type": "boolean"},
        "token_logged": {"const": false},
        "request_url_logged": {"const": false}
      }
