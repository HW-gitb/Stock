    "endpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "table_id",
        "api_family",
        "request_shape_without_token",
        "call_status",
        "trade_date",
        "row_count",
        "columns",
        "minimum_fields_present",
        "minimum_fields_missing",
        "top500_main_board_stats",
        "raw_payload_ref",
        "checkpoint_status",
        "tracked_summary_excludes_raw_rows",
