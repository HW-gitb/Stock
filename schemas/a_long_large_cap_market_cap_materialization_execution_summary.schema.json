    "execution": {"$ref": "#/$defs/execution"},
    "materialization_boundary": {"$ref": "#/$defs/materializationBoundary"},
    "coverage_rollup": {"$ref": "#/$defs/coverageRollup"},
    "endpoint_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/endpointResult"},
      "maxItems": 96
    },
    "decision": {"$ref": "#/$defs/decision"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "limitations": {"$ref": "#/$defs/stringList"}
  },
