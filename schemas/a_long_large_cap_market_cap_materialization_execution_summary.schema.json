      "properties": {
        "months_with_success": {"type": "integer", "minimum": 0, "maximum": 96},
        "months_with_complete_top500": {"type": "integer", "minimum": 0, "maximum": 96},
        "min_main_board_row_count": {"type": ["integer", "null"], "minimum": 0},
        "min_selected_top500_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 500},
        "selected_market_cap_field": {"const": "circ_mv"}
      }
