        "board_scope": {"const": "main_board_only"},
        "top_500_selection_written_to_tracked_summary": {"const": false},
        "not_signal_search": {"const": true}
      }
    },
    "coverageRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "months_with_success",
        "months_with_complete_top500",
        "min_main_board_row_count",
        "min_selected_top500_count",
        "selected_market_cap_field"
