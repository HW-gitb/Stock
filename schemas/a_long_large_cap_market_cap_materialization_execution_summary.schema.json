        "tracked_summary_contains_secret": {"const": false},
        "market_cap_field_freeze_already_reviewed": {"const": true},
        "market_cap_materialization_executed": {"type": "boolean"},
        "audit_rerun_executed": {"const": false},
        "signal_search_executed": {"const": false},
        "alpha_backtest_executed": {"const": false},
        "datahub_allowed": {"const": false},
        "production_use_allowed": {"const": false},
