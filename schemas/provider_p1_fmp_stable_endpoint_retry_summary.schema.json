{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/provider_p1_fmp_stable_endpoint_retry_summary/1.0.0/schema.json",
  "title": "Provider P1 FMP Stable Endpoint Retry Summary",
  "description": "Tracked no-secret summary for the narrow 2026-06-02 AAPL/MSFT FMP stable-endpoint retry. Raw FMP payloads must stay under gitignored provider_samples/. This summary does not select a provider, authorize yfinance, permit full-market downloads, implement adapters or DataHub tables, authorize Phase 7c, relax ship gates, or claim production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "approval_ref",
    "mapping_review_ref",
    "schema_ref",
    "scope",
    "environment",
    "storage",
    "sample_universe",
    "endpoint_call_budget",
    "mapping_basis",
    "endpoint_results",
    "symbol_results",
    "prohibited_claims",
    "limitations",
    "next_steps"
  ],
  "properties": {
    "schema_name": {
      "const": "provider_p1_fmp_stable_endpoint_retry_summary"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string"
    },
    "approval_ref": {
      "const": "docs/provider_evidence_p1_us_sample_validation_access_approval_20260602.json"
    },
    "mapping_review_ref": {
      "const": "docs/provider_evidence_p1_us_fmp_current_endpoint_mapping_review_20260602.json"
    },
    "schema_ref": {
      "const": "schemas/provider_p1_fmp_stable_endpoint_retry_summary.schema.json"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "purpose",
        "validation_status",
        "fmp_endpoint_mode",
        "data_fetch_performed",
        "fmp_live_retry_performed",
        "manual_order_only",
        "ship_gate_relaxed",
        "provider_selection_allowed",
        "paid_access_allowed",
        "yfinance_allowed",
        "full_market_download_allowed",
        "provider_adapter_allowed",
        "datahub_table_implementation_allowed",
        "production_runner_consumption_allowed",
        "phase7c_authorized_by_this_summary",
        "production_ready_claim_allowed"
      ],
      "properties": {
        "phase": {
          "const": "7b-2"
        },
        "purpose": {
          "const": "fmp_stable_endpoint_retry_summary"
        },
        "validation_status": {
          "enum": [
            "completed",
            "completed_with_endpoint_errors"
          ]
        },
        "fmp_endpoint_mode": {
          "const": "stable"
        },
        "data_fetch_performed": {
          "const": true
        },
        "fmp_live_retry_performed": {
          "const": true
        },
        "manual_order_only": {
          "const": true
        },
        "ship_gate_relaxed": {
          "const": false
        },
        "provider_selection_allowed": {
          "const": false
        },
        "paid_access_allowed": {
          "const": false
        },
        "yfinance_allowed": {
          "const": false
        },
        "full_market_download_allowed": {
          "const": false
        },
        "provider_adapter_allowed": {
          "const": false
        },
        "datahub_table_implementation_allowed": {
          "const": false
        },
        "production_runner_consumption_allowed": {
          "const": false
        },
        "phase7c_authorized_by_this_summary": {
          "const": false
        },
        "production_ready_claim_allowed": {
          "const": false
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fmp_api_key_present",
        "fmp_api_key_source",
        "secrets_logged"
      ],
      "properties": {
        "fmp_api_key_present": {
          "const": true
        },
        "fmp_api_key_source": {
          "enum": [
            "process",
            "windows_environment"
          ]
        },
        "secrets_logged": {
          "const": false
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sample_storage_path",
        "raw_samples_gitignored",
        "tracked_summary_contains_raw_rows",
        "secrets_in_summary",
        "request_urls_in_summary"
      ],
      "properties": {
        "raw_sample_storage_path": {
          "const": "provider_samples/us_egs_sample_validation_20260602/fmp_stable_retry/"
        },
        "raw_samples_gitignored": {
          "const": true
        },
        "tracked_summary_contains_raw_rows": {
          "const": false
        },
        "secrets_in_summary": {
          "const": false
        },
        "request_urls_in_summary": {
          "const": false
        }
      }
    },
    "sample_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbols",
        "max_symbols"
      ],
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "enum": [
              "AAPL",
              "MSFT"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "max_symbols": {
          "const": 2
        }
      }
    },
    "endpoint_call_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_endpoint_calls",
        "actual_total_endpoint_calls",
        "within_budget"
      ],
      "properties": {
        "max_total_endpoint_calls": {
          "type": "integer",
          "maximum": 40
        },
        "actual_total_endpoint_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "within_budget": {
          "const": true
        }
      }
    },
    "mapping_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_verdict",
        "stable_base_url",
        "stable_endpoint_candidates_count"
      ],
      "properties": {
        "mapping_verdict": {
          "const": "stable_endpoint_candidates_identified_not_live_validated"
        },
        "stable_base_url": {
          "const": "https://financialmodelingprep.com/stable/"
        },
        "stable_endpoint_candidates_count": {
          "const": 6
        }
      }
    },
    "endpoint_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/endpointResult"
      }
    },
    "symbol_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbolResult"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selected",
        "full_market_download_performed",
        "yfinance_used",
        "paid_access_used",
        "phase7c_authorized",
        "ship_gate_evidence_claimed"
      ],
      "properties": {
        "provider_selected": {
          "const": false
        },
        "full_market_download_performed": {
          "const": false
        },
        "yfinance_used": {
          "const": false
        },
        "paid_access_used": {
          "const": false
        },
        "phase7c_authorized": {
          "const": false
        },
        "ship_gate_evidence_claimed": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "endpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_family",
        "symbol",
        "status",
        "http_status",
        "error_type",
        "raw_sample_ref",
        "raw_sample_ref_gitignored",
        "fmp_endpoint_mode",
        "payload_shape",
        "field_presence"
      ],
      "properties": {
        "provider_id": {
          "const": "financial_modeling_prep"
        },
        "endpoint_family": {
          "enum": [
            "profile_or_company_metadata",
            "income_statement",
            "balance_sheet_statement",
            "cash_flow_statement",
            "financial_ratios_or_key_metrics",
            "historical_eod_price_volume"
          ]
        },
        "symbol": {
          "enum": [
            "AAPL",
            "MSFT"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "error_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_sample_ref": {
          "type": "string",
          "pattern": "^provider_samples/us_egs_sample_validation_20260602/fmp_stable_retry/raw/"
        },
        "raw_sample_ref_gitignored": {
          "const": true
        },
        "fmp_endpoint_mode": {
          "const": "stable"
        },
        "payload_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_type",
            "top_level_key_count",
            "row_count"
          ],
          "properties": {
            "payload_type": {
              "type": "string"
            },
            "top_level_key_count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "row_count": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "field_presence": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "symbolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "fmp",
        "validation_observations"
      ],
      "properties": {
        "symbol": {
          "enum": [
            "AAPL",
            "MSFT"
          ]
        },
        "fmp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoints_ok",
            "endpoints_error",
            "statement_observed_date_fields_present",
            "price_volume_fields_present"
          ],
          "properties": {
            "endpoints_ok": {
              "type": "integer",
              "minimum": 0
            },
            "endpoints_error": {
              "type": "integer",
              "minimum": 0
            },
            "statement_observed_date_fields_present": {
              "type": "boolean"
            },
            "price_volume_fields_present": {
              "type": "boolean"
            }
          }
        },
        "validation_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
