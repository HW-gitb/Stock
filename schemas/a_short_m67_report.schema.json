{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_m67_report",
  "description": "A-short Phase 5 engine output. m67 = the ONLY user-facing section (精简结论区 + 执行清单 table); machine = hidden traceability (indicators / risk_families / layer / consumption). Non-production, edge UNVALIDATED — boundary all false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "as_of", "ts_code", "name",
               "m67", "machine", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_m67_report"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "ts_code": {"type": "string"},
    "name": {"type": "string"},
    "row_source": {"enum": ["egs_candidate", "egs_candidate_with_position",
                            "account_position_egs_full", "account_position_only"],
                   "description": "持仓恒列入 S1: 该行来源。egs_candidate=本周 top-N 候选; egs_candidate_with_position=top-N 候选且账户持有; account_position_egs_full=账户持仓(非 top-N,复用 egs_full 本轮评分,Tier-2); account_position_only=账户持仓(非 top-N 且非 egs_full,粗筛未覆盖,Tier-3)。可选(缺省视为 egs_candidate,向后兼容)。"},
    "coverage_status": {"enum": ["full", "partial"],
                        "description": "持仓恒列入 S1: 本周自动核查覆盖度。full=完整核查,**仅 top-N 候选行**(含已持仓的 top-N,走候选全链含语义)。partial=**每只非 top-N 注入持仓**——S1 对持仓**不跑语义/新闻** → 任何注入持仓都不标 full;Tier-2(row_source=account_position_egs_full,EGS 复用、语义未跑)与 Tier-3(account_position_only,EGS+语义均未跑)的区别在 `row_source`,不在 coverage;EGS『未核查』渲染覆盖只对 Tier-3。可选(缺省视为 full=候选)。"},
    "consistency_warning": {"type": ["string", "null"],
                            "description": "持仓恒列入 S1: 该持仓的 4.3-D trades↔positions 对账警告(取自转换器 lineage 旁产物),advisory,渲染到该持仓行。可选/缺省 null。"},
    "m67": {
      "type": "object",
      "additionalProperties": false,
      "required": ["精简结论区", "table"],
      "properties": {
        "精简结论区": {
          "type": "object",
          "additionalProperties": false,
          "required": ["当前环境", "波动率状态", "现价与成本", "否决审查触发",
                       "板块资金事件", "风控触发", "操作建议"],
          "properties": {
            "当前环境": {"type": "string"},
            "波动率状态": {"type": "string"},
            "现价与成本": {"type": "string"},
            "否决审查触发": {"type": "string"},
            "板块资金事件": {"type": "string"},
            "风控触发": {"type": "string"},
            "操作建议": {"type": "string"}
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["操作", "股数", "入", "盈一", "盈二", "损", "类型", "EGS分", "优先级", "触发条件"],
          "properties": {
            "操作": {"enum": ["建仓", "观察", "否决", "持有"]},
            "股数": {"type": ["integer", "null"]},
            "入": {"type": ["number", "null"]},
            "盈一": {"type": ["number", "null"]},
            "盈二": {"type": ["number", "null"]},
            "损": {"type": ["number", "null"]},
            "类型": {"type": "string"},
            "EGS分": {"type": ["number", "null"]},
            "优先级": {"type": "string"},
            "触发条件": {"type": "string"},
            "持仓处置": {"enum": ["持有", "持有警戒", "建议减仓复核", "建议清仓复核", "立即人工复核"],
                        "description": "S3b R1+R2: 持仓处置结构化列(决策1:操作 enum 不扩,持仓处置是独立列)。**仅 held 行**(操作=持有);候选行省略=向后兼容。由 severity 合并引擎从各 holding_row_impact 的 holding_effect 合成(machine.holding_management_signal 映射)。advisory 复核建议、**不自动卖出**;减仓价/清仓价 = R3(待单独批准)。"},
            "禁止加仓": {"type": "boolean",
                        "description": "S3b R1+R2: 禁止加仓独立布尔列(== machine.blocked_add_required,各 holding 信号 blocked_add_required 的 OR 合并)。**仅 held 行**;候选行省略。"}
          }
        }
      }
    },
    "machine": {
      "type": "object",
      "required": ["indicators", "risk_families", "layer", "entry_exit_size_star", "iv_gate", "consumption"],
      "properties": {
        "indicators": {"type": "object"},
        "risk_families": {"type": "object"},
        "layer": {"type": "object"},
        "entry_exit_size_star": {"type": "object"},
        "iv_gate": {"type": "object"},
        "consumption": {"type": "object"},
        "holding_management_signal": {"enum": ["hold", "hold_watch", "reduce_review", "clear_review", "manual_review", "none"],
          "description": "S3b R1+R2: 合并引擎从各 holding_row_impact 的 holding_effect 取 severity-max(clear_review>reduce_review>manual_review>hold_watch>hold>none;anti-rescue:正面不降级)。映射到 table.持仓处置。仅 held 报告;非生产/不自动卖出。"},
        "blocked_add_required": {"type": "boolean",
          "description": "S3b R1+R2: 各 holding 信号 blocked_add_required 的 OR 合并。映射到 table.禁止加仓。"},
        "operation_impact": {
          "type": "array",
          "description": "4.2 第1轮: 逐字段 operation_impact 记录(仍有 M6.7 候选/持仓行的字段). schema 层焊死 m67_landing_surface/terminal_surface_target 非空; 跨字段不变式(production_hard_veto⟹操作=否决 / production_effect_enabled=false 不得升格 / 只落文本须挂后继 slice)由 validate_operation_impact_no_dangling 守. 可选(缺省=无, 向后兼容; Tier-3 持仓粗覆盖不发).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_field", "field_class", "visibility_shape", "new_entry_effect", "holding_effect",
                         "blocked_add_required", "veto_class", "evidence_ref", "m67_landing_surface", "terminal_surface_target",
                         "pending_successor_slice", "production_effect_enabled", "implementation_status"],
            "properties": {
              "source_field": {"type": "string", "minLength": 1},
              "field_class": {"enum": ["structured", "semantic_advisory", "cadence_excluded"]},
              "visibility_shape": {"enum": ["candidate_row_impact", "holding_row_impact"],
                "description": "row-level operation_impact 只允许逐票形态; 上游过滤 batch_exclusion/summary_only/out_of_scope 走周报 exclusion_summary(第2轮)"},
              "impact_scope": {"enum": ["new_entry", "existing_holding", "both", "none"]},
              "new_entry_effect": {"enum": ["hard_veto", "observe_required", "sizing_down", "priority_down", "manual_review", "informational", "none"]},
              "holding_effect": {"enum": ["clear_review", "reduce_review", "manual_review", "hold_watch", "hold", "none"]},
              "blocked_add_required": {"type": "boolean"},
              "veto_class": {"enum": ["none", "production_hard_veto", "m67_advisory_veto"]},
              "reason": {"type": "string"},
              "evidence_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value", "as_of"],
                "properties": {
                  "kind": {"enum": ["artifact_path", "lineage_key", "source_id"]},
                  "value": {"type": "string", "minLength": 1},
                  "as_of": {"type": "string", "pattern": "^[0-9]{8}$", "description": "证据 PIT 日期; 运行时 guard 另绑 == 报告 as_of"}
                }
              },
              "confidence": {"enum": ["high", "medium", "low"]},
              "pit_basis": {"enum": ["disclosure_date", "trade_date_window", "observed_date", "live_only", "manual_review_only"]},
              "production_effect_enabled": {"type": "boolean"},
              "implementation_status": {"enum": ["implemented", "design_only_current_text_landing", "future_s3b_schema_render_required", "pending_slice_not_yet_landed", "out_of_scope_no_landing"]},
              "m67_landing_surface": {"type": "string", "minLength": 1},
              "terminal_surface_target": {"type": "string", "minLength": 1},
              "pending_successor_slice": {"type": ["string", "null"]},
              "privacy_class": {"enum": ["public_tracked", "private_account", "secret_or_raw_provider"]}
            }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "real_money", "is_validated_alpha", "satisfies_ship_gate"],
      "properties": {
        "production": {"const": false},
        "real_money": {"const": false},
        "is_validated_alpha": {"const": false},
        "satisfies_ship_gate": {"const": false}
      }
    }
  }
}
