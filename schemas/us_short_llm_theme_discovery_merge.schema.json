{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_llm_theme_discovery_merge.schema.json",
  "title": "US-short web/X discovery merge manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "generated_at", "decision_clock", "merge_contract", "input_artifact_sha256", "source_refs", "themes", "drop_ledger", "summary"],
  "properties": {
    "schema_name": {"const": "us_short_llm_theme_discovery_merge"}, "schema_version": {"const": "1.0.0"}, "generated_at": {"type": "string", "format": "date-time"},
    "decision_clock": {"type": "object", "additionalProperties": false, "required": ["expected_decision_date", "cutoff_policy", "pit_enforced"], "properties": {"expected_decision_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "cutoff_policy": {"const": "before_decision_open_et"}, "pit_enforced": {"const": true}}},
    "merge_contract": {"type": "object", "additionalProperties": false, "required": ["producer_kind", "execution_mode", "scoring_eligible", "top15_effect_enabled", "operation_advice_effect_enabled", "dynamic_seats_enabled", "theme_probe_enabled", "lifecycle_actions_enabled"], "properties": {"producer_kind": {"const": "web_x_discovery_merge"}, "execution_mode": {"const": "offline_local_receipts"}, "scoring_eligible": {"const": false}, "top15_effect_enabled": {"const": false}, "operation_advice_effect_enabled": {"const": false}, "dynamic_seats_enabled": {"const": false}, "theme_probe_enabled": {"const": false}, "lifecycle_actions_enabled": {"const": false}}},
    "input_artifact_sha256": {"type": "object", "additionalProperties": false, "required": ["web", "x"], "properties": {"web": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "x": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/source_ref"}},
    "themes": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["theme_id", "discovery_sources", "members"], "properties": {"theme_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"}, "discovery_sources": {"enum": ["web", "x", "both", "none"]}, "members": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["ticker", "discovery_sources", "evidence_tier", "source_ref_ids", "redundant_source_ref_ids", "model_transcribed_x_evidence"], "properties": {"ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"}, "discovery_sources": {"enum": ["web", "x", "both", "none"]}, "evidence_tier": {"enum": ["both", "single", null]}, "source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "redundant_source_ref_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "model_transcribed_x_evidence": {"type": "boolean"}}}}}}},
    "drop_ledger": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "theme_id", "reason", "detail"], "properties": {"stage": {"const": "theme"}, "theme_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "detail": {"type": "string"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["web_theme_count", "x_theme_count", "merged_theme_count", "dropped_theme_count", "member_evidence_demotion_count", "both_member_count", "single_member_count", "zero_member_count", "redundant_member_count", "model_transcribed_x_member_count"], "properties": {"web_theme_count": {"type": "integer", "minimum": 0}, "x_theme_count": {"type": "integer", "minimum": 0}, "merged_theme_count": {"type": "integer", "minimum": 0}, "dropped_theme_count": {"type": "integer", "minimum": 0}, "member_evidence_demotion_count": {"type": "integer", "minimum": 0}, "both_member_count": {"type": "integer", "minimum": 0}, "single_member_count": {"type": "integer", "minimum": 0}, "zero_member_count": {"type": "integer", "minimum": 0}, "redundant_member_count": {"type": "integer", "minimum": 0}, "model_transcribed_x_member_count": {"type": "integer", "minimum": 0}}}
  },
  "definitions": {"source_ref": {"type": "object", "additionalProperties": false, "required": ["source_id", "source_type", "canonical_locator", "observed_at", "fetched_at", "content_sha256", "raw_receipt_ref", "raw_receipt_gitignored", "evidence_attestation"], "properties": {"source_id": {"type": "string", "pattern": "^(web|x):[0-9a-f]{64}$"}, "source_type": {"enum": ["web", "x"]}, "canonical_locator": {"type": "string", "pattern": "^https?://[^\\s]+$"}, "observed_at": {"type": "string", "format": "date-time"}, "fetched_at": {"type": "string", "format": "date-time"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "raw_receipt_ref": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^provider_samples/[A-Za-z0-9._/-]+$", "not": {"pattern": "(^|/)\\.\\.(/|$)"}}]}, "raw_receipt_gitignored": {"type": "boolean"}, "evidence_attestation": {"enum": ["provider_attested", "model_transcribed"]}}}}
}
