{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_weekly_sidecar_outcomes",
  "description": "De-identified per-run outcome manifest written by the launcher or weekly pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "as_of", "expected_sidecars", "sidecars"],
  "properties": {
    "schema_name": {"const": "a_short_weekly_sidecar_outcomes"},
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "run_revision_id": {"type": ["string", "null"], "pattern": "^([0-9a-f]{32})?$"},
    "run_id": {"type": ["string", "null"]},
    "candidate_digest": {"type": ["string", "null"]},
    "expected_sidecars": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expected", "attempted", "execution_status", "progress_status"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "expected": {"type": "boolean"},
          "attempted": {"type": "boolean"},
          "attempted_before_egs": {"type": "boolean"},
          "iv_feed_status": {"enum": ["not_requested", "build_failed", "digest_failed", "clock_mismatch", "ready"]},
          "feed_ref": {"type": "string", "minLength": 1},
          "feed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "execution_status": {"enum": ["succeeded", "failed", "skipped", "not_due", "not_configured"]},
          "progress_status": {"enum": ["advanced", "already_current", "stalled", "not_applicable", "unavailable"]},
          "expected_data_through": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "observed_decision_as_of": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "observed_data_through": {"type": ["string", "null"], "pattern": "^([0-9]{8})?$"},
          "error_code": {"type": ["string", "null"], "pattern": "^([a-z0-9_]+)?$"},
          "error_detail": {"type": ["string", "null"], "maxLength": 512, "pattern": "^[^\\r\\n]*$"},
          "skip_reason": {"type": ["string", "null"], "pattern": "^([a-z0-9_]+)?$"}
        }
      }
    }
  }
}
