    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "purpose",
        "lane_id",
        "market",
        "research_only",
        "provider_family",
        "provider_call_executed",
        "tushare_call_executed",
        "data_fetch_executed",
        "raw_payload_written_to_gitignored_path",
        "tracked_summary_contains_raw_rows",
        "tracked_summary_contains_secret",
        "full_market_materialization_executed",
        "full_universe_signal_search_executed",
        "signal_search_executed",
        "alpha_backtest_executed",
