        "candidate_universe_ready_for_signal_search": {"type": "boolean"},
        "data_can_be_used_for_alpha_now": {"const": false},
        "signal_search_authorized_by_this_summary": {"const": false},
        "full_alpha_run_executed": {"const": false},
        "plain_result": {"$ref": "#/$defs/nonEmptyString"},
        "next_action": {"$ref": "#/$defs/nonEmptyString"}
      }
