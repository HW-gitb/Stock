  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "artifact_id",
    "preregistration_ref",
    "scope",
    "execution",
    "candidate_universe",
    "probe_interpretation",
    "endpoint_results",
    "decision",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_main_board_candidate_universe_preflight_execution_summary"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_main_board_candidate_universe_preflight_execution_summary_20260604"},
