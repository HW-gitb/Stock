    "prohibitedClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_long_alpha_found",
        "candidate_universe_ready",
        "full_universe_ready",
        "signal_search_authorized",
        "production_ready",
        "ship_gate_evidence",
        "full_size_allowed",
        "datahub_authorized",
        "broker_or_order_automation_authorized"
      ],
      "properties": {
        "a_long_alpha_found": {"const": false},
        "candidate_universe_ready": {"const": false},
        "full_universe_ready": {"const": false},
        "signal_search_authorized": {"const": false},
        "production_ready": {"const": false},
        "ship_gate_evidence": {"const": false},
        "full_size_allowed": {"const": false},
        "datahub_authorized": {"const": false},
        "broker_or_order_automation_authorized": {"const": false}
      }
