    "endpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "api_family",
        "probe_kind",
        "request_shape_without_token",
        "call_status",
        "row_count",
        "columns",
        "target_symbol",
        "target_match_count",
        "raw_payload_ref",
        "tracked_summary_excludes_raw_rows",
        "error_class",
        "error_message_redacted"
      ],
      "properties": {
        "call_id": {
          "enum": [
            "index_member_all_l2_index_code_probe",
            "index_member_all_missing_active_ts_code_probe",
            "index_member_all_present_active_ts_code_probe",
            "stock_basic_active_industry_area_probe"
          ]
        },
        "api_family": {"enum": ["index_member_all", "stock_basic"]},
        "probe_kind": {
          "enum": [
            "l2_index_code_filter",
            "missing_active_ts_code_filter",
            "present_active_ts_code_filter",
            "stock_basic_active_industry_area_fields"
          ]
        },
