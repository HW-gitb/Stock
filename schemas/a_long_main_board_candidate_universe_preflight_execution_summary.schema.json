        "call_status": {"enum": ["success", "empty", "error"]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "target_symbol": {"type": ["string", "null"]},
        "target_match_count": {"$ref": "#/$defs/nonNegativeInteger"},
        "raw_payload_ref": {"$ref": "#/$defs/nonEmptyString"},
        "tracked_summary_excludes_raw_rows": {"const": true},
        "error_class": {"type": ["string", "null"]},
        "error_message_redacted": {"type": ["string", "null"]}
      }
    },
    "probeInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_ts_code_filter_can_supplement_missing_sw",
        "stock_basic_active_industry_area_available",
        "l2_index_code_filter_not_sufficient_for_pagination",
        "delisted_sw_membership_still_unresolved"
      ],
      "properties": {
