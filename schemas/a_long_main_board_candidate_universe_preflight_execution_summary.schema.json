    "candidate_universe": {"$ref": "#/$defs/candidateUniverse"},
    "probe_interpretation": {"$ref": "#/$defs/probeInterpretation"},
    "endpoint_results": {"type": "array", "items": {"$ref": "#/$defs/endpointResult"}, "maxItems": 4},
    "decision": {"$ref": "#/$defs/decision"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "limitations": {"$ref": "#/$defs/stringList"}
  },
  "$defs": {
