        "candidate_universe_ready_for_signal_search",
        "data_can_be_used_for_alpha_now",
        "signal_search_authorized_by_this_summary",
        "full_alpha_run_executed",
        "plain_result",
        "next_action"
      ],
      "properties": {
        "preflight_status": {
          "enum": [
            "dry_run_environment_ready",
            "not_executed_environment_missing",
            "candidate_universe_preflight_passed",
            "blocked_sw_industry_coverage_for_full_universe_signal_search",
            "partial_or_failed_candidate_universe_preflight"
          ]
