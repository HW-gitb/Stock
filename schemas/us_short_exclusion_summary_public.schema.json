{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "us_short_exclusion_summary_public",
  "description": "De-identified, TRACKABLE weekly exclusion summary (docs/us_short_system_design.md §11.4): public-universe per-category exclusion counts + hot_excluded heat and unevaluable counts ONLY. It carries NO tickers / holdings / $ — real-holding exclusions live on the PRIVATE path (§11.6, §18.0 guard). The de-identification GATE is this schema itself: additionalProperties:false at the top level + integer-only counts mean no ticker / holding / cost field can ever land on a tracked path.",
  "type": "object",
  "properties": {
    "schema_name": {"const": "us_short_exclusion_summary_public"},
    "schema_version": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "category_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "stage_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass1_eligibility", "pass2_audit_gate", "top15_selection"],
      "properties": {
        "pass1_eligibility": {"type": "integer", "minimum": 0},
        "pass2_audit_gate": {"type": "integer", "minimum": 0},
        "top15_selection": {"type": "integer", "minimum": 0}
      }
    },
    "total_excluded": {"type": "integer", "minimum": 0},
    "catalyst_recall_rejected_count": {"type": "integer", "minimum": 0},
    "hot_excluded_public_heat_count": {"type": "integer", "minimum": 0},
    "hot_excluded_unevaluable_count": {"type": "integer", "minimum": 0}
  },
  "required": [
    "schema_name",
    "schema_version",
    "as_of",
    "category_counts",
    "stage_counts",
    "total_excluded",
    "catalyst_recall_rejected_count",
    "hot_excluded_public_heat_count",
    "hot_excluded_unevaluable_count"
  ],
  "additionalProperties": false
}
