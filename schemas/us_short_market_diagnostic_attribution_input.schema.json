{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_market_diagnostic_attribution_input.schema.json",
  "title": "US-short v1.1 attribution input",
  "description": "Source-bound, point-in-time inputs for the diagnostic-only v1.1 attribution layer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "attribution_epoch",
    "diagnostic_epoch",
    "window_id",
    "weeks",
    "source_refs",
    "boundary"
  ],
  "properties": {
    "schema_name": {
      "const": "us_short_market_diagnostic_attribution_input"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "attribution_epoch": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_epoch": {
      "type": "string",
      "minLength": 1
    },
    "window_id": {
      "type": "string",
      "pattern": "^26w-[1-9][0-9]*-[1-9][0-9]*$"
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 26,
      "items": {
        "$ref": "#/definitions/week"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sha256"
      },
      "minItems": 1,
      "maxItems": 26,
      "uniqueItems": true,
      "description": "One pointer per week: the weekly_record_sha256 of every week this packet summarises. Deliberately NOT the union of every week's provenance — that flat rollup blew its own ceiling around week 24 with real per-ETF dividend digests, making the 26-week window this module exists for unreachable. Each week's own source_refs stays complete, so an auditor walks root -> week -> observation."
    },
    "boundary": {
      "$ref": "#/definitions/boundary"
    }
  },
  "definitions": {
    "date8": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "number_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "date_time_or_null": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sha256"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_week_index",
        "decision_date",
        "valuation_date",
        "decision_time_reproducible",
        "strategy",
        "vti",
        "cash_return",
        "target_exposure",
        "source_refs"
      ],
      "properties": {
        "calendar_week_index": {
          "type": "integer",
          "minimum": 1
        },
        "decision_date": {
          "$ref": "#/definitions/date8"
        },
        "valuation_date": {
          "$ref": "#/definitions/date8"
        },
        "decision_time_reproducible": {
          "type": "boolean",
          "description": "Whether this week's decision instant can be reproduced. Design 12.7 makes an irreproducible decision time an UNAVAILABLE week, not a rejected packet; pinning it const:true meant no producer could ever report the honest answer and the design branch did not exist."
        },
        "strategy": {
          "$ref": "#/definitions/strategy"
        },
        "vti": {
          "$ref": "#/definitions/vti"
        },
        "cash_return": {
          "$ref": "#/definitions/cash_return"
        },
        "target_exposure": {
          "$ref": "#/definitions/target_exposure"
        },
        "source_refs": {
          "$ref": "#/definitions/source_refs"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_evaluable",
        "strategy_evaluable",
        "weekly_return",
        "weekly_record_sha256",
        "data_quality_reasons"
      ],
      "properties": {
        "paper_evaluable": {
          "type": "boolean"
        },
        "strategy_evaluable": {
          "type": "boolean"
        },
        "weekly_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "weekly_record_sha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_quality_reasons": {
          "$ref": "#/definitions/reasons"
        }
      }
    },
    "vti": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "return_quality",
        "weekly_return",
        "sidecar_observation_sha256",
        "source_refs",
        "data_quality_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "evaluable",
            "unavailable"
          ]
        },
        "return_quality": {
          "enum": [
            "total_return_evaluable",
            "unavailable"
          ]
        },
        "weekly_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "sidecar_observation_sha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "$ref": "#/definitions/source_refs"
        },
        "data_quality_reasons": {
          "$ref": "#/definitions/reasons"
        }
      }
    },
    "cash_return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "instrument",
        "weekly_return",
        "effective_start_date",
        "effective_end_date",
        "as_of_date",
        "available_at",
        "source_sha256",
        "source_refs",
        "data_quality_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "evaluable",
            "unavailable"
          ]
        },
        "instrument": {
          "const": "pit_3m_tbill"
        },
        "weekly_return": {
          "$ref": "#/definitions/number_or_null"
        },
        "effective_start_date": {
          "anyOf": [
            {
              "$ref": "#/definitions/date8"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_end_date": {
          "anyOf": [
            {
              "$ref": "#/definitions/date8"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of_date": {
          "anyOf": [
            {
              "$ref": "#/definitions/date8"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at": {
          "$ref": "#/definitions/date_time_or_null"
        },
        "source_sha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "$ref": "#/definitions/source_refs"
        },
        "data_quality_reasons": {
          "$ref": "#/definitions/reasons"
        }
      }
    },
    "target_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "as_of_date",
        "carried_holdings_exposure",
        "new_order_exposure",
        "cash_capacity_exposure",
        "environment_position_cap",
        "long_only_cap",
        "source_refs",
        "data_quality_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "evaluable",
            "unavailable"
          ]
        },
        "as_of_date": {
          "anyOf": [
            {
              "$ref": "#/definitions/date8"
            },
            {
              "type": "null"
            }
          ],
          "description": "The decision date this target exposure was taken at. Required so the observation names the week it decides instead of relying on the caller's dictionary key."
        },
        "carried_holdings_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "new_order_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "cash_capacity_exposure": {
          "$ref": "#/definitions/number_or_null"
        },
        "environment_position_cap": {
          "$ref": "#/definitions/number_or_null"
        },
        "long_only_cap": {
          "$ref": "#/definitions/number_or_null"
        },
        "source_refs": {
          "$ref": "#/definitions/source_refs"
        },
        "data_quality_reasons": {
          "$ref": "#/definitions/reasons"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "comparison_only",
        "counts_ship_gate",
        "changes_selection_or_action",
        "automatic_policy_switch",
        "broker_or_order_automation",
        "v1_record_mutated",
        "historical_backfill_performed",
        "provider_fetch_performed",
        "account_write_performed"
      ],
      "properties": {
        "diagnostic_only": {
          "const": true
        },
        "comparison_only": {
          "const": true
        },
        "counts_ship_gate": {
          "const": false
        },
        "changes_selection_or_action": {
          "const": false
        },
        "automatic_policy_switch": {
          "const": false
        },
        "broker_or_order_automation": {
          "const": false
        },
        "v1_record_mutated": {
          "const": false
        },
        "historical_backfill_performed": {
          "const": false
        },
        "provider_fetch_performed": {
          "const": false
        },
        "account_write_performed": {
          "const": false
        }
      }
    }
  }
}
