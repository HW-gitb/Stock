{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/rank_backtest_report/1.11.0/schema.json",
  "title": "Rank Backtest Report",
  "description": "Machine-readable manifest emitted by runners/backtest_rank.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "preset",
    "mode",
    "engineering_smoke",
    "evidence_role",
    "includes_backtest_only_tier2_filler",
    "includes_full_m67_operation_chain",
    "production_or_live_historical_replay",
    "full_size_allowed",
    "settings",
    "windows",
    "sample_count",
    "selected_dates",
    "date_warnings",
    "immature_included_dates",
    "immature_skipped_dates",
    "trade_dates",
    "candidate_source_root",
    "forward_daily",
    "outputs",
    "strategy_variants",
    "return_variants",
    "limitations",
    "data_lineage"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "rank_backtest_report"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "preset": {
      "type": "string",
      "enum": ["a_short"]
    },
    "mode": {
      "type": "string",
      "enum": ["smoke", "production"]
    },
    "engineering_smoke": {
      "type": "boolean"
    },
    "evidence_role": {
      "const": "engineering_rank_replay"
    },
    "includes_backtest_only_tier2_filler": {
      "const": true
    },
    "includes_full_m67_operation_chain": {
      "const": false
    },
    "production_or_live_historical_replay": {
      "const": false
    },
    "full_size_allowed": {
      "const": false
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reuse_l3_cache",
        "include_immature",
        "cost_pct",
        "dedup_mode",
        "windows",
        "freq",
        "periods",
        "start_date",
        "end_date",
        "l3_mode",
        "l3_pit_strict",
        "primary_subset",
        "split_date",
        "analyzer_veto",
        "veto_rules"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["smoke", "production"]
        },
        "reuse_l3_cache": {
          "type": "boolean"
        },
        "include_immature": {
          "type": "boolean"
        },
        "cost_pct": {
          "type": "number",
          "minimum": 0
        },
        "dedup_mode": {
          "type": "string",
          "enum": ["none", "by_ts_code", "by_ts_and_date"]
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "freq": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly"]
        },
        "periods": {
          "type": "integer",
          "minimum": 0
        },
        "start_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{8}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "l3_mode": {
          "type": "string",
          "enum": ["pit", "today", "neutralize"],
          "description": "L3 cat_score source passed to egs_main."
        },
        "l3_pit_strict": {
          "type": "boolean",
          "description": "With l3_mode=pit, fail-fast if no snapshot <= as_of (otherwise warn + cat_score=50)."
        },
        "primary_subset": {
          "type": "string",
          "enum": ["all", "tier1_only", "tier1_veto_passed"],
          "description": "Recommended reporting subset. Stats CSVs include a 'subset' column with both 'all' and 'tier1_only' rows; this field declares which one is the headline. Default 'tier1_only' since 24p evidence (t=-2.27) shows Tier2 filler dilutes the real signal."
        },
        "split_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{8}$",
          "description": "YYYYMMDD boundary for the period_split dimension. When set, stats CSVs include 'discovery' (trade_date < split_date) and 'validation' (>=) rows alongside the default 'all' rows, enabling in-sample/out-of-sample separation to avoid data-mining overfit. Null means only 'all' is emitted."
        },
        "analyzer_veto": {
          "type": "boolean",
          "description": "Whether Phase 3 analyzer hard-veto replay was applied to emit the tier1_veto_passed subset. Baseline all/tier1_only samples remain unchanged."
        },
        "veto_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["chasing_high", "overheat", "l2_unknown", "esp_non_positive"]
          },
          "description": "Enabled Phase 3 hard-veto rule codes used for tier1_veto_passed replay."
        }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{8}$"
      }
    },
    "date_warnings": {
      "type": "array",
      "description": "Date-level sample health warnings. Added in v1.9.0 so low Tier1-count dates are visible in the machine-readable report instead of only in findings notes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trade_date",
          "warning_type",
          "severity",
          "threshold",
          "sample_count",
          "tier1_count",
          "tier2_count",
          "message"
        ],
        "properties": {
          "trade_date": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "warning_type": {
            "type": "string",
            "enum": ["low_tier1_count", "low_tier1_veto_passed_count", "no_samples"]
          },
          "severity": {
            "type": "string",
            "enum": ["warning", "critical"]
          },
          "threshold": {
            "type": "integer",
            "minimum": 0
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0
          },
          "tier1_count": {
            "type": "integer",
            "minimum": 0
          },
          "tier2_count": {
            "type": "integer",
            "minimum": 0
          },
          "tier1_veto_passed_count": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "immature_included_dates": {
      "type": "array",
      "description": "Immature as-of dates that WERE selected (only when --include-immature is on).",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{8}$"
      }
    },
    "immature_skipped_dates": {
      "type": "array",
      "description": "Immature as-of dates that were NOT selected.",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{8}$"
      }
    },
    "trade_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{8}$"
      }
    },
    "candidate_source_root": {
      "type": "string",
      "minLength": 1
    },
    "forward_daily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_date", "end_date", "adj", "benchmarks", "fetched_at", "stock_rows", "stock_codes", "limit_rows"],
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "end_date": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "adj": {
              "type": "string",
              "enum": ["qfq_via_adj_factor", "none"]
            },
            "benchmarks": {
              "type": "array",
              "items": {"type": "string"}
            },
            "fetched_at": {
              "type": "string"
            },
            "stock_rows": {
              "type": "integer",
              "minimum": 0
            },
            "stock_codes": {
              "type": "integer",
              "minimum": 0
            },
            "limit_rows": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["skipped_no_samples"]
            }
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank_samples",
        "summary_by_window",
        "factor_group_stats",
        "rule6_stats",
        "monthly_stats",
        "eligible_benchmark",
        "strategy_variant_stats",
        "strategy_variant_monthly",
        "portfolio_period_returns",
        "portfolio_stats"
      ],
      "properties": {
        "rank_samples": {"type": "string"},
        "summary_by_window": {"type": "string"},
        "factor_group_stats": {"type": "string"},
        "rule6_stats": {"type": "string"},
        "monthly_stats": {
          "type": "string",
          "description": "Long-format CSV with per (trade_date, variant, window) aggregates. Added in v1.5.0 to support time-series stability inspection without re-grouping rank_samples."
        },
        "eligible_benchmark": {"type": "string"},
        "strategy_variant_stats": {"type": "string"},
        "strategy_variant_monthly": {"type": "string"},
        "portfolio_period_returns": {"type": "string"},
        "portfolio_stats": {"type": "string"}
      }
    },
    "strategy_variants": {
      "type": "array",
      "description": "Post-hoc and rerank validation variants emitted by backtest_rank.py.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy_variant", "sample_count"],
        "properties": {
          "strategy_variant": {"type": "string"},
          "sample_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "return_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["close", "t1", "t1_net", "excess_csi300", "excess_csi1000", "excess_eligible"],
      "properties": {
        "close": {"type": "string"},
        "t1": {"type": "string"},
        "t1_net": {"type": "string"},
        "excess_csi300": {"type": "string"},
        "excess_csi1000": {"type": "string"},
        "excess_eligible": {"type": "string"}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "data_lineage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phase 2.6 lineage object. Centralizes data provider identity, API surface, forward-return adjustment mode, benchmark sources, and PIT limitations so downstream readers do not have to derive them from scattered fields. Added in v1.10.0.",
      "required": [
        "data_provider",
        "api_families",
        "forward_return_adjustment_mode",
        "benchmark_sources",
        "pit_limitations"
      ],
      "properties": {
        "data_provider": {
          "type": "string",
          "description": "Primary upstream data provider. Currently always 'tushare'."
        },
        "api_families": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_generation", "forward_evaluation"],
          "properties": {
            "candidate_generation": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Tushare API endpoint names consumed by A-EGS/egs_main.py when building each as-of candidate pool."
            },
            "forward_evaluation": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Tushare API endpoint names consumed by runners/backtest_rank.py when fetching forward returns, benchmark prices, and limit-up state."
            }
          }
        },
        "forward_return_adjustment_mode": {
          "type": "string",
          "enum": ["qfq_via_adj_factor", "none"],
          "description": "Adjustment applied to forward close prices before computing window returns. Must match forward_daily.adj."
        },
        "benchmark_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["csi300", "csi1000", "eligible"],
          "properties": {
            "csi300": {"type": "string"},
            "csi1000": {"type": "string"},
            "eligible": {"type": "string"}
          },
          "description": "Concrete source identifiers for the three benchmarks referenced in return_variants.excess_*."
        },
        "pit_limitations": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "Point-in-time limitations centralized for Phase 2.6. The dynamic l3_mode-specific note remains in the top-level 'limitations' array."
        }
      }
    }
  }
}
