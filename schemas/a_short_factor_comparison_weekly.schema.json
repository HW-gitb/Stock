{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_factor_comparison_weekly",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "decision_date", "policy_id", "baseline_policy_id", "factor_id", "forward_eligible", "candidate_universe_digest", "selection", "outcome", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_factor_comparison_weekly"},
    "schema_version": {"const": "1.0.0"},
    "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "policy_id": {"type": "string"},
    "baseline_policy_id": {"const": "v14_2_frozen"},
    "factor_id": {"enum": ["baseline", "entry_ma_pullback", "entry_range_pullback", "iv_step_down", "iv_joint_stress"]},
    "forward_eligible": {"type": "boolean"},
    "candidate_universe_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "eligible_symbols", "selected_symbols", "decisions"],
      "properties": {
        "slots": {"type": "integer", "minimum": 1},
        "eligible_symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selected_symbols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decisions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "outcome": {"type": "object"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "automatic_policy_switch", "historical_replay_counts_as_forward"],
      "properties": {
        "production": {"const": false},
        "automatic_policy_switch": {"const": false},
        "historical_replay_counts_as_forward": {"const": false}
      }
    }
  }
}
