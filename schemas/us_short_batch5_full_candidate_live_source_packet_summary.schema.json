{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_candidate_live_source_packet_summary.schema.json",
  "title": "US-short Batch5 full-candidate live source-packet summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "schema_ref",
    "authorization_ref",
    "generated_at",
    "scope",
    "decision_clock",
    "environment",
    "preflight_gate",
    "candidate_universe",
    "pass2_target_universe",
    "endpoint_call_budget",
    "endpoint_results",
    "raw_capture_manifest",
    "storage",
    "source_artifacts",
    "source_packet",
    "replay_source_capture",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_full_candidate_live_source_packet_summary" },
    "schema_version": { "const": "1.0.0" },
    "schema_ref": { "const": "schemas/us_short_batch5_full_candidate_live_source_packet_summary.schema.json" },
    "authorization_ref": {
      "enum": [
        "user_chat_20260706_us_short_full_candidate_live_source_packet",
        "offline_replay_from_bound_source_capture"
      ]
    },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "route",
        "batch",
        "execution_mode",
        "purpose",
        "status",
        "network_access_performed",
        "provider_calls_performed",
        "raw_payload_storage_performed",
        "offline_replay_non_emittable",
        "resolved_source_artifacts_written",
        "corporate_action_capture_written",
        "source_packet_written",
        "data_context_written",
        "context_components_written",
        "corporate_action_reconciliation_performed",
        "return_calculation_performed",
        "datahub_consumption_performed",
        "production_storage_performed",
        "full_market_call_performed",
        "yfinance_consumption_performed",
        "broker_or_order_execution_performed",
        "ship_gate_or_live_normalized_evidence_claimed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "market": { "const": "US" },
        "route": { "const": "US-short" },
        "batch": { "const": "batch5" },
        "execution_mode": { "enum": ["live_provider_fetch", "offline_replay"] },
        "purpose": {
          "enum": [
            "full_candidate_live_pass2_resolved_source_packet",
            "full_candidate_offline_replay_source_packet"
          ]
        },
        "status": {
          "enum": [
            "source_packet_built_preflight_only",
            "source_packet_built_and_data_context_written",
            "offline_replay_source_packet_built_preflight_only"
          ]
        },
        "network_access_performed": { "type": "boolean" },
        "provider_calls_performed": { "type": "boolean" },
        "raw_payload_storage_performed": { "const": true },
        "offline_replay_non_emittable": { "type": "boolean" },
        "resolved_source_artifacts_written": { "const": true },
        "corporate_action_capture_written": { "const": true },
        "source_packet_written": { "const": true },
        "data_context_written": { "type": "boolean" },
        "context_components_written": { "type": "boolean" },
        "corporate_action_reconciliation_performed": { "const": false },
        "return_calculation_performed": { "const": false },
        "datahub_consumption_performed": { "const": false },
        "production_storage_performed": { "const": false },
        "full_market_call_performed": { "const": false },
        "yfinance_consumption_performed": { "type": "boolean" },
        "broker_or_order_execution_performed": { "const": false },
        "ship_gate_or_live_normalized_evidence_claimed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "source_as_of", "observed_at"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "observed_at": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fmp_api_key_present",
        "fmp_api_key_source",
        "sec_user_agent_present",
        "sec_user_agent_source",
        "massive_api_key_present",
        "massive_api_key_source",
        "environment_values_logged",
        "secrets_logged"
      ],
      "properties": {
        "fmp_api_key_present": { "type": "boolean" },
        "fmp_api_key_source": { "type": "string", "minLength": 1 },
        "sec_user_agent_present": { "const": true },
        "sec_user_agent_source": { "type": "string", "minLength": 1 },
        "massive_api_key_present": { "const": true },
        "massive_api_key_source": { "type": "string", "minLength": 1 },
        "environment_values_logged": { "const": false },
        "secrets_logged": { "const": false }
      }
    },
    "preflight_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_summary_path",
        "preflight_status",
        "local_inputs_ready",
        "expected_total_call_budget",
        "preflight_total_call_forecast",
        "call_budget_matches_preflight"
      ],
      "properties": {
        "preflight_summary_path": {
          "type": "string",
          "pattern": "^(docs/us_short_batch5_full_candidate_pass2_preflight_summary_20260706\\.json|provider_samples/us_short_batch5_full_candidate_pass2_preflight_20260706/.+\\.json)$",
          "not": { "pattern": "\\.\\." }
        },
        "preflight_status": { "const": "ready_for_reviewed_live_execution" },
        "local_inputs_ready": { "const": true },
        "expected_total_call_budget": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "preflight_total_call_forecast": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "call_budget_matches_preflight": { "const": true }
      }
    },
    "candidate_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_artifact_path",
        "candidate_artifact_path_gitignored",
        "row_count",
        "eligible_count",
        "eligible_symbol_sample",
        "symbol_scope",
        "source_full_candidate_eligible_count",
        "full_market_sample"
      ],
      "properties": {
        "candidate_artifact_path": {
          "type": "string",
          "pattern": "^state/us_short/.+\\.json$",
          "not": { "pattern": "\\.\\." }
        },
        "candidate_artifact_path_gitignored": { "const": true },
        "row_count": { "type": "integer", "minimum": 1 },
        "eligible_count": { "type": "integer", "minimum": 1 },
        "eligible_symbol_sample": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
        },
        "symbol_scope": { "const": "pass2_target_universe" },
        "source_full_candidate_eligible_count": { "type": "integer", "minimum": 1 },
        "full_market_sample": { "const": false }
      }
    },
    "pass2_target_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_mode",
        "momentum_top_k",
        "target_count",
        "target_symbols",
        "target_symbol_sample",
        "fmp_grade_call_cap",
        "fmp_grade_calls_within_free_daily_cap",
        "neutral_fill_tickers_excluded_from_expensive_pass2"
      ],
      "properties": {
        "selection_mode": {
          "enum": [
            "momentum_theme_top_k_plus_catalyst_recall_plus_forced_holdings"
          ]
        },
        "momentum_top_k": { "type": "integer", "minimum": 1, "maximum": 250 },
        "target_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "target_symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
        },
        "target_symbol_sample": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" }
        },
        "fmp_grade_call_cap": { "const": 250 },
        "fmp_grade_calls_within_free_daily_cap": { "const": true },
        "neutral_fill_tickers_excluded_from_expensive_pass2": { "const": true }
      }
    },
    "endpoint_call_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_endpoint_calls",
        "actual_total_endpoint_calls",
        "max_total_http_attempts",
        "actual_total_http_attempts",
        "sec_ticker_reference_calls",
        "fmp_grades_calls",
        "sec_submissions_calls",
        "massive_reference_news_calls",
        "massive_stock_split_calls",
        "massive_dividend_calls",
        "endpoint_error_count",
        "sec_cik_missing_count",
        "retry_count_allowed",
        "retry_count_used",
        "within_budget"
      ],
      "properties": {
        "max_total_endpoint_calls": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "actual_total_endpoint_calls": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "max_total_http_attempts": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "actual_total_http_attempts": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "sec_ticker_reference_calls": { "const": 1 },
        "fmp_grades_calls": { "type": "integer", "minimum": 0 },
        "sec_submissions_calls": { "type": "integer", "minimum": 0 },
        "massive_reference_news_calls": { "type": "integer", "minimum": 1 },
        "massive_stock_split_calls": { "type": "integer", "minimum": 1 },
        "massive_dividend_calls": { "type": "integer", "minimum": 1 },
        "endpoint_error_count": { "type": "integer", "minimum": 0 },
        "sec_cik_missing_count": { "type": "integer", "minimum": 0 },
        "retry_count_allowed": { "type": "integer", "minimum": 0, "maximum": 2 },
        "retry_count_used": { "type": "integer", "minimum": 0 },
        "massive_429_retry_wait_seconds": { "enum": [0, 65] },
        "within_budget": { "const": true }
      }
    },
    "endpoint_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/endpointResult" }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_root",
        "raw_payload_root_gitignored",
        "tracked_summary_path",
        "tracked_summary_contains_raw_rows",
        "tracked_summary_contains_raw_payload",
        "tracked_summary_contains_request_urls",
        "tracked_summary_contains_secrets"
      ],
      "properties": {
        "raw_payload_root": {
          "type": "string",
          "pattern": "^provider_samples/us_short_batch5_full_candidate_live_source_packet_20260706/"
        },
        "raw_payload_root_gitignored": { "const": true },
        "tracked_summary_path": {
          "type": "string",
          "pattern": "^(docs/us_short_batch5_full_candidate_live_source_packet_summary_20260706\\.json|provider_samples/us_short_batch5_full_candidate_live_source_packet_20260706/.+\\.json)$",
          "not": { "pattern": "\\.\\." }
        },
        "tracked_summary_contains_raw_rows": { "const": false },
        "tracked_summary_contains_raw_payload": { "const": false },
        "tracked_summary_contains_request_urls": { "const": false },
        "tracked_summary_contains_secrets": { "const": false }
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_subset_path",
        "offering_audit_source_path",
        "analyst_grade_actions_path",
        "massive_news_events_path",
        "corporate_action_capture_path",
        "momentum_projection_path",
        "theme_projection_path",
        "artifacts_gitignored"
      ],
      "properties": {
        "candidate_subset_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "offering_audit_source_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "analyst_grade_actions_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "yfinance_grade_actions_path": {
          "anyOf": [
            { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
            { "type": "null" }
          ]
        },
        "analyst_grade_actions_consumed_from": {
          "enum": ["fmp_analyst_grade_actions", "yfinance_grade_actions"]
        },
        "analyst_grade_actions_exclusion": {
          "anyOf": [
            { "const": "not_called_replaced_by_yfinance" },
            { "type": "null" }
          ]
        },
        "massive_news_events_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "corporate_action_capture_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "momentum_projection_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "theme_projection_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "artifacts_gitignored": { "const": true }
      }
    },
    "source_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "preflight_status",
        "run_data_context_requested",
        "data_context_output_path",
        "context_components_output_path"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "preflight_status": { "const": "offline_preflight_passed" },
        "run_data_context_requested": { "type": "boolean" },
        "data_context_output_path": {
          "anyOf": [
            { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
            { "type": "null" }
          ]
        },
        "context_components_output_path": {
          "anyOf": [
            { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
            { "type": "null" }
          ]
        }
      }
    },
    "replay_source_capture": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_summary_path",
            "source_summary_sha256",
            "source_raw_root",
            "source_observed_at",
            "source_expected_decision_date",
            "source_as_of",
            "raw_wrapper_count",
            "source_capture_manifest_sha256",
            "non_emittable"
          ],
          "properties": {
            "source_summary_path": { "type": "string", "minLength": 1, "not": { "pattern": "\\.\\." } },
            "source_summary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_raw_root": { "type": "string", "pattern": "^provider_samples/", "not": { "pattern": "\\.\\." } },
            "source_observed_at": { "type": "string", "minLength": 1 },
            "source_expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
            "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "raw_wrapper_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
            "source_capture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "non_emittable": { "const": true }
          }
        }
      ]
    },
    "raw_capture_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_wrapper_sha256", "manifest_sha256"],
      "properties": {
        "endpoint_wrapper_sha256": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_id", "endpoint_family", "symbol", "sha256"],
            "properties": {
              "provider_id": { "enum": ["sec_edgar", "financial_modeling_prep", "massive"] },
              "endpoint_family": {
                "enum": ["company_tickers_mapping", "submissions", "grades", "reference_news", "stock_splits", "dividends"]
              },
              "symbol": {
                "anyOf": [
                  { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" },
                  { "type": "null" }
                ]
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selected",
        "full_market_download_performed",
        "yfinance_used",
        "paid_access_used",
        "datahub_consumed",
        "production_readiness_claimed",
        "corporate_action_reconciliation_claimed",
        "return_calculation_performed",
        "ship_gate_evidence_claimed",
        "live_normalized_evidence_claimed",
        "broker_or_order_execution_performed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "provider_selected": { "const": false },
        "full_market_download_performed": { "const": false },
        "yfinance_used": { "type": "boolean" },
        "paid_access_used": { "const": false },
        "datahub_consumed": { "const": false },
        "production_readiness_claimed": { "const": false },
        "corporate_action_reconciliation_claimed": { "const": false },
        "return_calculation_performed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "live_normalized_evidence_claimed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "endpointResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_family",
        "symbol",
        "status",
        "http_status",
        "error_type",
        "raw_sample_ref",
        "raw_sample_ref_gitignored",
        "payload_shape"
      ],
      "properties": {
        "provider_id": {
          "enum": ["sec_edgar", "financial_modeling_prep", "massive"]
        },
        "endpoint_family": {
          "enum": [
            "company_tickers_mapping",
            "submissions",
            "grades",
            "reference_news",
            "stock_splits",
            "dividends"
          ]
        },
        "symbol": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Z][A-Z0-9.:-]*$" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["success", "error"] },
        "http_status": {
          "anyOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "null" }
          ]
        },
        "error_type": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "raw_sample_ref": {
          "type": "string",
          "pattern": "^provider_samples/us_short_batch5_full_candidate_live_source_packet_20260706/.+\\.json$",
          "not": { "pattern": "\\.\\." }
        },
        "raw_sample_ref_gitignored": { "const": true },
        "payload_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "row_count"],
          "properties": {
            "kind": {
              "enum": ["list", "object_results", "sec_submissions", "object", "null", "scalar"]
            },
            "row_count": {
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scope": { "properties": { "execution_mode": { "const": "live_provider_fetch" } } } }
      },
      "then": {
        "properties": {
          "authorization_ref": { "const": "user_chat_20260706_us_short_full_candidate_live_source_packet" },
          "scope": {
            "properties": {
              "purpose": { "const": "full_candidate_live_pass2_resolved_source_packet" },
              "network_access_performed": { "const": true },
              "provider_calls_performed": { "const": true },
              "offline_replay_non_emittable": { "const": false }
            }
          },
          "replay_source_capture": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "scope": { "properties": { "execution_mode": { "const": "offline_replay" } } } }
      },
      "then": {
        "properties": {
          "authorization_ref": { "const": "offline_replay_from_bound_source_capture" },
          "scope": {
            "properties": {
              "purpose": { "const": "full_candidate_offline_replay_source_packet" },
              "status": { "const": "offline_replay_source_packet_built_preflight_only" },
              "network_access_performed": { "const": false },
              "provider_calls_performed": { "const": false },
              "offline_replay_non_emittable": { "const": true },
              "data_context_written": { "const": false },
              "context_components_written": { "const": false }
            }
          },
          "replay_source_capture": { "type": "object" }
        }
      }
    }
  ]
}
