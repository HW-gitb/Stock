{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/execution_backtest_report/1.4.0/schema.json",
  "title": "Execution Backtest Report",
  "description": "Phase 5 machine-readable contract for execution-level backtest reports. Version 1.3.0 adds explicit L3 provider and completeness lineage on top of the v1.2.0 ship-gate and capital-context outputs. Version 1.4.0 requires a machine-readable legacy Rule6 candidate-gate marker so the report cannot be mistaken for an M6.7 recommendation-performance or production proxy. The v1.x execution report contract remains unfrozen while there is no production consumer; required field additions may use v1.x minor bumps until the first production consumer is frozen, after which breaking changes require v2.0.0. event_log.event_codes is grow-only within v1.x; consumers should handle unknown event codes gracefully.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "preset",
    "mode",
    "settings",
    "inputs",
    "capital_context",
    "execution_assumptions",
    "data_lineage",
    "outputs",
    "metrics",
    "ship_gate_evaluation",
    "date_warnings",
    "limitations"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "execution_backtest_report"
    },
    "schema_version": {
      "type": "string",
      "const": "1.4.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "preset": {
      "type": "string",
      "enum": ["a_short", "us_short", "a_long", "us_long"]
    },
    "mode": {
      "type": "string",
      "enum": ["smoke", "production"]
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "capital_context": {
      "$ref": "#/$defs/capitalContext"
    },
    "execution_assumptions": {
      "$ref": "#/$defs/executionAssumptions"
    },
    "data_lineage": {
      "$ref": "#/$defs/dataLineage"
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "ship_gate_evaluation": {
      "$ref": "#/$defs/shipGateEvaluation"
    },
    "date_warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dateWarning"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "start_date",
        "end_date",
        "initial_capital",
        "primary_input",
        "deterministic_report_required"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["smoke", "production"]
        },
        "start_date": {
          "$ref": "#/$defs/date8Nullable"
        },
        "end_date": {
          "$ref": "#/$defs/date8"
        },
        "initial_capital": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Run-level starting capital. In schema v1.2.0 and later this must represent the selected bucket capital, not total account capital; capital_context is the authoritative source."
        },
        "primary_input": {
          "type": "string",
          "const": "analysis_input"
        },
        "deterministic_report_required": {
          "type": "boolean",
          "description": "Phase 5 v1 is expected to use analysis_input directly. If true, deterministic reports are additional guarded inputs, not Markdown-derived trading signals."
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_root",
        "analysis_inputs",
        "deterministic_reports",
        "state_refs",
        "price_data"
      ],
      "properties": {
        "candidate_root": {
          "$ref": "#/$defs/pathRef"
        },
        "analysis_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisInputRef"
          },
          "minItems": 1
        },
        "deterministic_reports": {
          "type": "array",
          "description": "Optional Phase 4 report references. Execution v1 must not read Markdown and must version-guard JSON reports before use.",
          "items": {
            "$ref": "#/$defs/deterministicReportRef"
          }
        },
        "state_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateRef"
          }
        },
        "price_data": {
          "$ref": "#/$defs/priceDataRef"
        }
      }
    },
    "executionAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_timing",
        "limit_up_unbuyable",
        "price_adjustment",
        "transaction_cost",
        "stop_loss",
        "take_profit",
        "time_stop",
        "position_sizing",
        "portfolio_circuit_breaker",
        "cooldown",
        "candidate_semantics",
        "event_log"
      ],
      "properties": {
        "entry_timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "price_field"],
          "properties": {
            "rule": {
              "type": "string",
              "enum": ["t1_open"]
            },
            "price_field": {
              "type": "string",
              "enum": ["open_qfq"]
            }
          }
        },
        "limit_up_unbuyable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "event_code"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "event_code": {
              "type": "string",
              "const": "entry_unbuyable"
            }
          }
        },
        "price_adjustment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["qfq_via_adj_factor", "none"]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "transaction_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost_pct", "applies_to"],
          "properties": {
            "cost_pct": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "applies_to": {
              "type": "string",
              "enum": ["entry_and_exit"]
            }
          }
        },
        "stop_loss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "missing_stop_action", "trigger_price_field"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "missing_stop_action": {
              "type": "string",
              "enum": ["skip_trade", "mark_missing_stop"]
            },
            "trigger_price_field": {
              "type": "string",
              "enum": ["low_qfq", "close_qfq"]
            }
          }
        },
        "take_profit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "trigger_order", "trigger_price_field"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "trigger_order": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["stop_loss", "take_profit", "time_stop"]
              },
              "minItems": 1
            },
            "trigger_price_field": {
              "type": "string",
              "enum": ["high_qfq", "close_qfq"]
            }
          }
        },
        "time_stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "days", "exit_price_field"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": 1
            },
            "exit_price_field": {
              "type": "string",
              "enum": ["close_qfq", "next_open_qfq"]
            }
          }
        },
        "position_sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "capital_basis",
            "max_position_pct",
            "bucket_ceiling_pct",
            "max_positions",
            "cash_constrained"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["equal_weight", "risk_budget", "fixed_pct"]
            },
            "capital_basis": {
              "type": "string",
              "enum": ["bucket_capital"]
            },
            "max_position_pct": {
              "$ref": "#/$defs/ratio"
            },
            "bucket_ceiling_pct": {
              "$ref": "#/$defs/ratio"
            },
            "max_positions": {
              "type": "integer",
              "minimum": 1
            },
            "cash_constrained": {
              "type": "boolean"
            }
          }
        },
        "portfolio_circuit_breaker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "new_entries_blocked", "existing_positions_action"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "new_entries_blocked": {
              "type": "boolean"
            },
            "existing_positions_action": {
              "type": "string",
              "enum": ["hold_until_exit_rule", "force_exit_next_open", "not_implemented"]
            }
          }
        },
        "cooldown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "event_code"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "event_code": {
              "type": "string",
              "const": "cooldown_block"
            }
          }
        },
        "candidate_semantics": {
          "type": "object",
          "description": "Required interpretation boundary for the legacy Rule6 execution candidate universe. It is not an M6.7 recommendation-performance or production proxy.",
          "additionalProperties": false,
          "required": [
            "candidate_gate",
            "m67_semantics_aligned",
            "production_proxy",
            "differing_rules"
          ],
          "properties": {
            "candidate_gate": {
              "type": "string",
              "const": "legacy_rule6_hard_veto"
            },
            "m67_semantics_aligned": {
              "type": "boolean",
              "const": false
            },
            "production_proxy": {
              "type": "boolean",
              "const": false
            },
            "differing_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["overheat", "chasing_high"]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "overheat"
                  }
                },
                {
                  "contains": {
                    "const": "chasing_high"
                  }
                }
              ]
            }
          }
        },
        "event_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "event_codes"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "event_codes": {
              "type": "array",
              "description": "Required row-level event code coverage. At minimum every execution report must declare entry and exit event rows. This enum is grow-only within v1.x; consumers should handle unknown event codes gracefully.",
              "allOf": [
                {
                  "contains": {
                    "const": "entry"
                  }
                },
                {
                  "contains": {
                    "const": "exit"
                  }
                }
              ],
              "items": {
                "type": "string",
                "enum": [
                  "candidate_seen",
                  "entry",
                  "entry_unbuyable",
                  "missing_price_data",
                  "missing_stop",
                  "stop_loss",
                  "take_profit",
                  "time_stop",
                  "exit_delayed",
                  "cash_constrained",
                  "circuit_breaker",
                  "cooldown_block",
                  "exit"
                ]
              },
              "minItems": 2,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "capitalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_allocation_ref",
        "cash_buffer_state_ref",
        "preset",
        "market",
        "horizon",
        "bucket",
        "currency",
        "capital_basis",
        "total_portfolio_capital",
        "market_allocation_pct",
        "market_capital",
        "bucket_target_pct",
        "bucket_ceiling_pct",
        "bucket_capital",
        "liquidity_reserve_pct",
        "liquidity_floor_policy",
        "cross_market_cash_fungible",
        "manual_execution_only",
        "ship_gate"
      ],
      "properties": {
        "portfolio_allocation_ref": {
          "$ref": "#/$defs/portfolioAllocationRef"
        },
        "cash_buffer_state_ref": {
          "$ref": "#/$defs/cashBufferStateRef"
        },
        "preset": {
          "type": "string",
          "enum": ["a_short", "us_short", "a_long", "us_long"]
        },
        "market": {
          "type": "string",
          "enum": ["A", "US"]
        },
        "horizon": {
          "type": "string",
          "enum": ["short", "long"]
        },
        "bucket": {
          "type": "string",
          "enum": ["short", "long"]
        },
        "currency": {
          "type": "string",
          "enum": ["CNY", "USD"]
        },
        "capital_basis": {
          "type": "string",
          "enum": ["bucket_capital"]
        },
        "total_portfolio_capital": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "market_allocation_pct": {
          "$ref": "#/$defs/ratio"
        },
        "market_capital": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "bucket_target_pct": {
          "$ref": "#/$defs/ratio"
        },
        "bucket_ceiling_pct": {
          "$ref": "#/$defs/ratio"
        },
        "bucket_capital": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "liquidity_reserve_pct": {
          "$ref": "#/$defs/ratio"
        },
        "liquidity_floor_policy": {
          "type": "string",
          "enum": ["hard_floor_with_explicit_exceptions"]
        },
        "cross_market_cash_fungible": {
          "type": "boolean",
          "const": false
        },
        "manual_execution_only": {
          "type": "boolean",
          "const": true
        },
        "ship_gate": {
          "$ref": "#/$defs/shipGateSnapshot"
        }
      }
    },
    "dataLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_provider",
        "api_families",
        "forward_return_adjustment_mode",
        "benchmark_sources",
        "pit_limitations",
        "analysis_input_schema_version",
        "deterministic_report_schema_version",
        "analyzer_rules",
        "l3_mode"
      ],
      "properties": {
        "data_provider": {
          "type": "string",
          "enum": ["tushare", "mixed", "us_provider"]
        },
        "api_families": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_generation", "execution_price", "state_replay"],
          "properties": {
            "candidate_generation": {
              "$ref": "#/$defs/stringList"
            },
            "execution_price": {
              "$ref": "#/$defs/stringList"
            },
            "state_replay": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "forward_return_adjustment_mode": {
          "type": "string",
          "enum": ["qfq_via_adj_factor", "none"]
        },
        "benchmark_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["csi300", "csi1000"],
          "properties": {
            "csi300": {
              "type": "string",
              "minLength": 1
            },
            "csi1000": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pit_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "analysis_input_schema_version": {
          "$ref": "#/$defs/semver"
        },
        "deterministic_report_schema_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Null when deterministic_report_required=false and no deterministic report JSON is consumed."
        },
        "analyzer_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analyzerRuleRef"
          }
        },
        "l3_mode": {
          "type": "string",
          "enum": ["pit", "today", "neutralize"]
        },
        "l3_provider": {
          "type": ["string", "null"],
          "enum": ["hithink_finance", "legacy_tushare_snapshot", "neutralized", null]
        },
        "l3_snapshot_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{8}$"
        },
        "l3_catalog_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "l3_catalog_board_count": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "l3_scoring_universe": {
          "type": ["string", "null"],
          "enum": ["a_share_main_board", null]
        },
        "l3_coverage_complete": {
          "type": ["boolean", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"analysis_input_schema_version": {"const": "1.2.0"}},
            "required": ["analysis_input_schema_version"]
          },
          "then": {
            "required": [
              "l3_provider",
              "l3_snapshot_date",
              "l3_catalog_digest",
              "l3_catalog_board_count",
              "l3_scoring_universe",
              "l3_coverage_complete"
            ]
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_report",
        "trades",
        "daily_equity",
        "order_events",
        "skipped_candidates"
      ],
      "properties": {
        "execution_report": {
          "$ref": "#/$defs/pathRef"
        },
        "trades": {
          "$ref": "#/$defs/pathRef"
        },
        "daily_equity": {
          "$ref": "#/$defs/pathRef"
        },
        "order_events": {
          "$ref": "#/$defs/pathRef"
        },
        "skipped_candidates": {
          "$ref": "#/$defs/pathRef"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "candidate_count",
        "trade_count",
        "skipped_count",
        "entry_unbuyable_count",
        "missing_stop_count",
        "win_rate",
        "total_return",
        "annualized_return",
        "max_drawdown",
        "avg_holding_days",
        "ending_equity"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "trade_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_unbuyable_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_stop_count": {
          "type": "integer",
          "minimum": 0
        },
        "win_rate": {
          "$ref": "#/$defs/ratioNullable"
        },
        "total_return": {
          "$ref": "#/$defs/numberNullable"
        },
        "annualized_return": {
          "$ref": "#/$defs/numberNullable"
        },
        "max_drawdown": {
          "$ref": "#/$defs/numberNullable"
        },
        "avg_holding_days": {
          "$ref": "#/$defs/nonNegativeNumberNullable"
        },
        "ending_equity": {
          "$ref": "#/$defs/nonNegativeNumberNullable"
        }
      }
    },
    "shipGateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_logic",
        "status",
        "full_size_allowed",
        "failure_mode",
        "manual_execution_only",
        "metric_results",
        "limitations"
      ],
      "properties": {
        "policy_logic": {
          "type": "string",
          "enum": ["and"]
        },
        "status": {
          "type": "string",
          "enum": ["not_evaluable", "pass", "fail"],
          "description": "not_evaluable means one or more required gate metrics are not available from this report."
        },
        "full_size_allowed": {
          "type": "boolean",
          "description": "True only when every AND-gate metric is evaluable and passes. This is a manual-use gate, not broker automation permission."
        },
        "failure_mode": {
          "type": "string",
          "const": "paper_or_minimal_size_or_risk_filter_only"
        },
        "manual_execution_only": {
          "type": "boolean",
          "const": true
        },
        "metric_results": {
          "$ref": "#/$defs/shipGateMetricResults"
        },
        "limitations": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "shipGateMetricResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_alpha_t_stat",
        "sharpe",
        "max_drawdown",
        "forward_live_months"
      ],
      "properties": {
        "monthly_alpha_t_stat": {
          "$ref": "#/$defs/shipGateMetricResult"
        },
        "sharpe": {
          "$ref": "#/$defs/shipGateMetricResult"
        },
        "max_drawdown": {
          "$ref": "#/$defs/shipGateMetricResult"
        },
        "forward_live_months": {
          "$ref": "#/$defs/shipGateMetricResult"
        }
      }
    },
    "shipGateMetricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "threshold", "passed", "reason"],
      "properties": {
        "value": {
          "$ref": "#/$defs/numberNullable"
        },
        "threshold": {
          "type": "number"
        },
        "passed": {
          "type": ["boolean", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dateWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_date", "warning_type", "severity", "message"],
      "properties": {
        "trade_date": {
          "$ref": "#/$defs/date8"
        },
        "warning_type": {
          "type": "string",
          "enum": [
            "low_candidate_count",
            "no_executable_candidates",
            "missing_price_data",
            "state_replay_gap"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["warning", "critical"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysisInputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "path", "schema_version", "candidate_count"],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/date8"
        },
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "schema_version": {
          "$ref": "#/$defs/semver"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deterministicReportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "ts_code", "path", "schema_version", "used"],
      "properties": {
        "as_of": {
          "$ref": "#/$defs/date8"
        },
        "ts_code": {
          "$ref": "#/$defs/tsCode"
        },
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "schema_version": {
          "$ref": "#/$defs/semver"
        },
        "used": {
          "type": "boolean"
        }
      }
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["positions", "veto_log", "circuit_breaker", "execution_log"]
        },
        "path": {
          "$ref": "#/$defs/pathRef"
        }
      }
    },
    "portfolioAllocationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "policy_id"],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cashBufferStateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "state_id", "as_of"],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "$ref": "#/$defs/date8"
        }
      }
    },
    "shipGateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_logic",
        "monthly_alpha_t_stat_min",
        "sharpe_min",
        "max_drawdown_max",
        "forward_live_months_min",
        "failure_mode",
        "status",
        "full_size_allowed",
        "reason"
      ],
      "properties": {
        "policy_logic": {
          "type": "string",
          "enum": ["and"]
        },
        "monthly_alpha_t_stat_min": {
          "type": "number",
          "const": 2.0
        },
        "sharpe_min": {
          "type": "number",
          "const": 1.0
        },
        "max_drawdown_max": {
          "type": "number",
          "const": 0.15
        },
        "forward_live_months_min": {
          "type": "integer",
          "const": 12
        },
        "failure_mode": {
          "type": "string",
          "const": "paper_or_minimal_size_or_risk_filter_only"
        },
        "status": {
          "type": "string",
          "enum": ["not_evaluated", "pass", "fail"]
        },
        "full_size_allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priceDataRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "adj", "path"],
      "properties": {
        "start_date": {
          "$ref": "#/$defs/date8"
        },
        "end_date": {
          "$ref": "#/$defs/date8"
        },
        "adj": {
          "type": "string",
          "enum": ["qfq_via_adj_factor", "none"]
        },
        "path": {
          "$ref": "#/$defs/pathRef"
        }
      }
    },
    "analyzerRuleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "version"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["chasing_high", "overheat", "l2_unknown", "esp_non_positive"]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pathRef": {
      "type": "string",
      "minLength": 1
    },
    "tsCode": {
      "type": "string",
      "pattern": "^[0-9]{6}\\.(SH|SZ)$"
    },
    "date8": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "date8Nullable": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{8}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ratioNullable": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "numberNullable": {
      "type": ["number", "null"]
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "nonNegativeNumberNullable": {
      "type": ["number", "null"],
      "minimum": 0
    }
  }
}
