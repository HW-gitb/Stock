{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_soft_boost_maturity_receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "decision_date", "maturity_as_of", "consumption_receipt_sha256", "shadow_receipt_sha256", "maturity_ohlcv_packet_sha256", "vix_regime_summary_sha256", "market_risk_regime", "status", "reason_code", "window", "on", "off"],
  "properties": {
    "schema_name": {"const": "us_short_soft_boost_maturity_receipt"}, "schema_version": {"const": "1.0.0"},
    "decision_date": {"type": "string", "pattern": "^[0-9]{8}$"}, "maturity_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "consumption_receipt_sha256": {"$ref": "#/definitions/digest"}, "shadow_receipt_sha256": {"$ref": "#/definitions/digest"}, "maturity_ohlcv_packet_sha256": {"$ref": "#/definitions/digest"},
    "vix_regime_summary_sha256": {"anyOf": [{"$ref": "#/definitions/digest"}, {"type": "null"}]}, "market_risk_regime": {"type": ["string", "null"]},
    "status": {"enum": ["matured", "whole_week_no_count"]}, "reason_code": {"type": ["string", "null"]},
    "window": {"type": ["object", "null"], "additionalProperties": false, "properties": {"window_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "h10_session_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}, "required": ["window_start", "h10_session_date"]},
    "on": {"$ref": "#/definitions/metrics_or_null"}, "off": {"$ref": "#/definitions/metrics_or_null"}
  },
  "definitions": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "metrics_or_null": {"type": ["object", "null"], "additionalProperties": false, "properties": {"net_return": {"type": "number"}, "max_drawdown": {"type": "number", "minimum": 0}, "bad_pick_rate": {"type": "number", "minimum": 0, "maximum": 1}, "tail_loss": {"type": "number", "minimum": 0}, "turnover": {"type": "number", "minimum": 0}, "fill_fraction": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["net_return", "max_drawdown", "bad_pick_rate", "tail_loss", "turnover", "fill_fraction"]}}
}
