        "api_family": {"$ref": "#/$defs/nonEmptyString"},
        "planned_calls": {"type": "integer", "minimum": 1, "maximum": 12},
        "grain": {"$ref": "#/$defs/nonEmptyString"},
        "minimum_fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
