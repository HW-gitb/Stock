{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/a_long_tushare_incremental_materialization_packet/1.0.0/schema.json",
  "title": "A-Long Tushare Incremental Materialization Packet",
  "description": "Reviewed execution packet for a bounded A-long Tushare thin-slice materialization. This packet records the exact slice, tables, call budget, raw storage, checkpoint/resume rules, and pre-execution gates. It does not itself run Tushare calls, materialize data, rerun the data-integrity audit, search signals, authorize DataHub, support production readiness, provide ship-gate evidence, allow full-size use, or automate orders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "artifact_id",
    "scope",
    "source_artifact_refs",
    "thin_slice_boundary",
    "materialization_tables",
    "call_budget",
    "storage_and_checkpoint_boundary",
    "pre_execution_gates",
    "prohibited_claims",
    "next_steps",
    "limitations"
  ],
  "properties": {
    "schema_name": {"const": "a_long_tushare_incremental_materialization_packet"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_id": {"const": "a_long_tushare_incremental_materialization_packet_20260604"},
    "scope": {"$ref": "#/$defs/scope"},
    "source_artifact_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceArtifactRef"},
      "minItems": 5,
      "allOf": [
        {"contains": {"type": "object", "properties": {"artifact_id": {"const": "a_long_tushare_route_gap_repair_execution_summary_20260604"}}, "required": ["artifact_id"]}},
        {"contains": {"type": "object", "properties": {"artifact_id": {"const": "a_long_data_integrity_audit_report_20260603"}}, "required": ["artifact_id"]}},
        {"contains": {"type": "object", "properties": {"artifact_id": {"const": "sr_along_data_001"}}, "required": ["artifact_id"]}}
      ]
    },
    "thin_slice_boundary": {"$ref": "#/$defs/thinSliceBoundary"},
    "materialization_tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/materializationTable"},
      "minItems": 11,
      "maxItems": 11
    },
    "call_budget": {"$ref": "#/$defs/callBudget"},
    "storage_and_checkpoint_boundary": {"$ref": "#/$defs/storageBoundary"},
    "pre_execution_gates": {"$ref": "#/$defs/preExecutionGates"},
    "prohibited_claims": {"$ref": "#/$defs/prohibitedClaims"},
    "next_steps": {"$ref": "#/$defs/stringList"},
    "limitations": {"$ref": "#/$defs/stringList"}
