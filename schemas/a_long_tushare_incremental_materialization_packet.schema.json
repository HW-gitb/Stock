        "environment_precheck_required": {"const": true},
        "tushare_token_presence_required": {"const": true},
        "environment_values_must_not_be_logged": {"const": true},
        "raw_root_gitignore_check_required": {"const": true},
        "exact_slice_boundary_required": {"const": true},
        "budget_precheck_required": {"const": true},
        "abort_on_budget_or_scope_violation": {"const": true},
