{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stock.local/schemas/us_short_security_identity_record/1.0.0/schema.json",
  "title": "US-short Security Identity Record",
  "description": "Pure/offline, source-bound identity record. CIK plus security class defines the stable security identity; the ticker is only the current label. It does not claim a complete security master, call a provider, read raw payloads or accounts, automate orders, or change selection/ranking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "security_id", "issuer_cik", "security_class", "current_ticker", "issuer_name", "primary_exchange", "observed_as_of", "source_binding", "boundary"],
  "properties": {
    "schema_name": {"const": "us_short_security_identity_record"},
    "schema_version": {"const": "1.0.0"},
    "security_id": {"type": "string", "pattern": "^US-CIK-[0-9]{10}-(COMMON|CLASS_[A-Z]{1,3}|ADR|PREFERRED)$"},
    "issuer_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "security_class": {"type": "string", "pattern": "^(COMMON|CLASS_[A-Z]{1,3}|ADR|PREFERRED)$"},
    "current_ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}([.\\-][A-Z]{1,3})?$"},
    "issuer_name": {"type": "string", "minLength": 1},
    "primary_exchange": {"enum": ["NYSE", "NASDAQ"]},
    "observed_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "boundary": {"$ref": "#/$defs/boundary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_ref_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "source_ref_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_call_performed", "raw_payload_read", "security_master_completeness_claimed", "selection_or_ranking_changed", "account_state_read", "broker_or_order_automation_allowed"],
      "properties": {
        "provider_call_performed": {"const": false},
        "raw_payload_read": {"const": false},
        "security_master_completeness_claimed": {"const": false},
        "selection_or_ranking_changed": {"const": false},
        "account_state_read": {"const": false},
        "broker_or_order_automation_allowed": {"const": false}
      }
    }
  }
}
