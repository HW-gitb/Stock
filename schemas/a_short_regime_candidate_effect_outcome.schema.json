{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_regime_candidate_effect_outcome",
  "description": "De-identified current-run outcome for the comparison-only A-short regime candidate-effect sidecar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "as_of", "status", "reason_code", "observed_as_of"],
  "properties": {
    "schema_name": {"const": "a_short_regime_candidate_effect_outcome"},
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "status": {
      "enum": ["updated", "skipped_source_mismatch", "skipped_immutable_mature_week"]
    },
    "reason_code": {
      "enum": ["updated", "run_identity_mismatch", "tracker_rows_missing", "m67_digest_drift", "immutable_mature_week"]
    },
    "observed_as_of": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "updated"}}},
      "then": {"properties": {"reason_code": {"const": "updated"}}}
    },
    {
      "if": {"properties": {"status": {"const": "skipped_source_mismatch"}}},
      "then": {"properties": {"reason_code": {"enum": ["run_identity_mismatch", "tracker_rows_missing", "m67_digest_drift"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "skipped_immutable_mature_week"}}},
      "then": {"properties": {"reason_code": {"const": "immutable_mature_week"}}}
    }
  ]
}
