{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_universe_sector_classification_packet.schema.json",
  "title": "US-short Batch5 full-universe per-ticker sector classification packet",
  "description": "Maps each eligible ticker to a sector/industry label (GICS or a labelled free proxy such as SEC SIC) so the offline full-universe theme producer can compute industry heat over the FULL peer pool. Written by the gated classification fetch (SR-PROVIDER-001). The label charset is permissive (sectors carry spaces / '&'); labels stay in the gitignored packet, never the tracked summary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "generated_at",
    "scope",
    "decision_clock",
    "classification_contract",
    "provenance",
    "sector_by_ticker"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_full_universe_sector_classification_packet" },
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "lane",
        "batch",
        "packet_status",
        "network_access_performed_by_packet_producer",
        "provider_calls_performed_by_packet_producer",
        "raw_payload_refs_gitignored",
        "datahub_consumption_allowed",
        "production_storage_allowed",
        "ship_gate_evidence_claimed",
        "broker_or_order_automation_allowed",
        "a_share_crossing_allowed"
      ],
      "properties": {
        "market": { "const": "US" },
        "lane": { "const": "us_short" },
        "batch": { "const": "batch5_provider_live" },
        "packet_status": { "const": "full_universe_sector_classification_ready_for_local_theme_projection" },
        "network_access_performed_by_packet_producer": { "type": "boolean" },
        "provider_calls_performed_by_packet_producer": { "type": "boolean" },
        "raw_payload_refs_gitignored": { "const": true },
        "datahub_consumption_allowed": { "const": false },
        "production_storage_allowed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "broker_or_order_automation_allowed": { "const": false },
        "a_share_crossing_allowed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "candidate_price_basis_date", "price_basis_date", "source_as_of"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "candidate_price_basis_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "price_basis_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "classification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_source", "as_of"],
      "properties": {
        "classification_source": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_or_family",
        "source_as_of",
        "observed_at",
        "coverage_status",
        "parser_status"
      ],
      "properties": {
        "provider_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "maxLength": 64 },
        "endpoint_or_family": { "type": "string", "minLength": 1 },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "observed_at": { "type": "string", "minLength": 1 },
        "coverage_status": { "enum": ["full", "partial", "missing"] },
        "parser_status": { "enum": ["ok", "partial", "failed"] }
      }
    },
    "sector_by_ticker": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
