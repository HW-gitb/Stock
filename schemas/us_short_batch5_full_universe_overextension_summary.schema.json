{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_universe_overextension_summary.schema.json",
  "title": "US-short Batch5 full-universe overextension producer summary",
  "description": "Counts-only tracked summary (no ticker lists, no price rows, no raw payloads, no secrets). Records how many of the full Pass1-eligible candidate set were overextension-scored vs insufficient_data, and the honest §4.3 tier tally (none / warning / chasing_extreme). Written by the offline overextension producer runner from a local OHLCV series packet; the gated grouped-window fetch that builds the packet stays SR-PROVIDER-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "schema_ref",
    "generated_at",
    "scope",
    "decision_clock",
    "candidate_universe",
    "series_source",
    "projection_contract",
    "paths",
    "storage",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_full_universe_overextension_summary" },
    "schema_version": { "const": "1.0.0" },
    "schema_ref": { "const": "schemas/us_short_batch5_full_universe_overextension_summary.schema.json" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "route",
        "batch",
        "purpose",
        "status",
        "network_access_performed_by_runner",
        "provider_calls_performed_by_runner",
        "raw_payload_storage_performed_by_runner",
        "series_packet_consumed",
        "overextension_projection_written",
        "datahub_consumption_performed",
        "production_storage_performed",
        "full_market_call_performed",
        "yfinance_consumption_performed",
        "broker_or_order_execution_performed",
        "ship_gate_or_live_normalized_evidence_claimed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "market": { "const": "US" },
        "route": { "const": "US-short" },
        "batch": { "const": "batch5" },
        "purpose": { "const": "full_universe_ohlcv_series_packet_to_overextension_projection" },
        "status": { "const": "full_universe_overextension_projection_written" },
        "network_access_performed_by_runner": { "const": false },
        "provider_calls_performed_by_runner": { "const": false },
        "raw_payload_storage_performed_by_runner": { "const": false },
        "series_packet_consumed": { "const": true },
        "overextension_projection_written": { "const": true },
        "datahub_consumption_performed": { "const": false },
        "production_storage_performed": { "const": false },
        "full_market_call_performed": { "const": false },
        "yfinance_consumption_performed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "ship_gate_or_live_normalized_evidence_claimed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "candidate_price_basis_date", "price_basis_date", "source_as_of"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "candidate_price_basis_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "price_basis_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "candidate_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "eligible_count", "symbol_scope", "full_market_sample"],
      "properties": {
        "row_count": { "type": "integer", "minimum": 1 },
        "eligible_count": { "type": "integer", "minimum": 1 },
        "symbol_scope": { "const": "full_pass1_eligible_candidate_set" },
        "full_market_sample": { "const": false }
      }
    },
    "series_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_count",
        "eligible_with_series_count",
        "provider_ids",
        "session",
        "adjustment_mode",
        "grouped_session_count"
      ],
      "properties": {
        "series_count": { "type": "integer", "minimum": 0 },
        "eligible_with_series_count": { "type": "integer", "minimum": 0 },
        "provider_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "maxLength": 64 }
        },
        "session": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "adjustment_mode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "grouped_session_count": { "type": "integer", "minimum": 1, "maximum": 3000 }
      }
    },
    "projection_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "overextension_scored_count",
        "disposition_counts",
        "state_counts",
        "coverage_exactly_matches_full_candidate_set",
        "real_ohlcv_source_consumed"
      ],
      "properties": {
        "target_count": { "type": "integer", "minimum": 0 },
        "overextension_scored_count": { "type": "integer", "minimum": 0 },
        "disposition_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scored", "insufficient_data"],
          "properties": {
            "scored": { "type": "integer", "minimum": 0 },
            "insufficient_data": { "type": "integer", "minimum": 0 }
          }
        },
        "state_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["none", "warning", "chasing_extreme"],
          "properties": {
            "none": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "chasing_extreme": { "type": "integer", "minimum": 0 }
          }
        },
        "coverage_exactly_matches_full_candidate_set": { "const": true },
        "real_ohlcv_source_consumed": { "type": "boolean" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_artifact_path", "series_packet_path", "output_projection_path", "summary_path"],
      "properties": {
        "candidate_artifact_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "series_packet_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "output_projection_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "summary_path": {
          "type": "string",
          "pattern": "^(docs/us_short_batch5_full_universe_overextension_summary_20260709\\.json|provider_samples/us_short_batch5_full_universe_overextension/[0-9]{8}/.+\\.json|provider_samples/us_short_batch5_full_universe_overextension_20260709/.+\\.json)$",
          "not": { "pattern": "\\.\\." }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_packet_path_gitignored",
        "output_projection_path_gitignored",
        "summary_path_gitignored",
        "summary_contains_ticker_lists",
        "summary_contains_price_rows",
        "summary_contains_raw_payload",
        "summary_contains_request_urls",
        "summary_contains_secrets"
      ],
      "properties": {
        "series_packet_path_gitignored": { "const": true },
        "output_projection_path_gitignored": { "const": true },
        "summary_path_gitignored": { "type": "boolean" },
        "summary_contains_ticker_lists": { "const": false },
        "summary_contains_price_rows": { "const": false },
        "summary_contains_raw_payload": { "const": false },
        "summary_contains_request_urls": { "const": false },
        "summary_contains_secrets": { "const": false }
      }
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selected",
        "full_market_download_performed",
        "yfinance_used",
        "paid_access_used",
        "datahub_consumed",
        "production_readiness_claimed",
        "ship_gate_evidence_claimed",
        "live_normalized_evidence_claimed",
        "broker_or_order_execution_performed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "provider_selected": { "const": false },
        "full_market_download_performed": { "const": false },
        "yfinance_used": { "const": false },
        "paid_access_used": { "const": false },
        "datahub_consumed": { "const": false },
        "production_readiness_claimed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "live_normalized_evidence_claimed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
