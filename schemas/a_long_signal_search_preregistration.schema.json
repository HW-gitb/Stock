        {
          "contains": {
            "type": "object",
            "properties": {"path": {"const": "docs/long_alpha_spec.md"}},
            "required": ["path"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {"path": {"const": "docs/ALPHA_VALIDATION_ACTION_GUIDE.md"}},
            "required": ["path"]
          }
        }
      ]
    },
