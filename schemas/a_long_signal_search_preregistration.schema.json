    "schema_version",
    "generated_at",
    "artifact_id",
    "scope",
    "source_doc_refs",
    "data_gate",
    "search_design",
    "decision_policy",
    "planned_test_budget",
    "prohibited_claims",
    "next_steps",
    "limitations"
  ],
