          "maxItems": 2,
          "allOf": [
            {"contains": {"type": "object",
              "required": ["source_id", "endpoint_family", "flags", "provider_role", "provider_candidates"],
              "properties": {"source_id": {"const": "ticker_reference"},
                             "endpoint_family": {"const": "active_listing_and_primary_exchange_reference"},
                             "flags": {"const": ["delisted", "otc"]},
                             "provider_role": {"const": "One bulk reference observation supplies delisted (active-listing membership) and otc (primary-exchange venue vs the NYSE/NASDAQ whitelist). Whole-market application of the bulk feed is a separate later packet; this packet validates the response shape on the 3 sample symbols only."},
                             "provider_candidates": {"const": [
                               "SEC company_tickers_exchange.json (already used in round-1 for ticker+exchange+CIK; supplies primary exchange, partial active/delisted signal)",
                               "a dedicated active-listing reference dataset to be confirmed at preflight if the SEC list is insufficient for the active/delisted determination"]}}}},
            {"contains": {"type": "object",
              "required": ["source_id", "endpoint_family", "flags", "provider_role", "provider_candidates"],
              "properties": {"source_id": {"const": "exchange_halt_feed"},
                             "endpoint_family": {"const": "public_trading_halt_feed"},
                             "flags": {"const": ["halted"]},
                             "provider_role": {"const": "One observation of the complete current trading-halt list at the decision PIT; membership sets halted=True, observed absence sets halted=False."},
