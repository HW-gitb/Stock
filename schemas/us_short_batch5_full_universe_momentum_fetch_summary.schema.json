{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/us_short_batch5_full_universe_momentum_fetch_summary.schema.json",
  "title": "US-short Batch5 full-universe momentum gated grouped-window fetch summary",
  "description": "Counts/shape-only tracked summary for the SR-PROVIDER-001 gated grouped-window fetch. No ticker lists, price rows, request URLs, or secrets. Prohibited claims are const-false invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "schema_ref",
    "generated_at",
    "scope",
    "decision_clock",
    "fetch_stats",
    "coverage",
    "paths",
    "storage",
    "prohibited_claims",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "us_short_batch5_full_universe_momentum_fetch_summary" },
    "schema_version": { "const": "1.0.0" },
    "schema_ref": { "const": "schemas/us_short_batch5_full_universe_momentum_fetch_summary.schema.json" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "route",
        "batch",
        "purpose",
        "status",
        "network_access_performed",
        "provider_calls_performed",
        "grouped_whole_market_calls_performed",
        "raw_grouped_window_persisted",
        "datahub_consumption_performed",
        "production_storage_performed",
        "yfinance_consumption_performed",
        "paid_access_performed",
        "broker_or_order_execution_performed",
        "ship_gate_or_live_normalized_evidence_claimed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "market": { "const": "US" },
        "route": { "const": "US-short" },
        "batch": { "const": "batch5" },
        "purpose": { "const": "full_universe_momentum_grouped_window_fetch" },
        "status": { "const": "series_packet_written" },
        "network_access_performed": { "type": "boolean" },
        "provider_calls_performed": { "type": "boolean" },
        "grouped_whole_market_calls_performed": { "type": "boolean" },
        "raw_grouped_window_persisted": { "const": false },
        "datahub_consumption_performed": { "const": false },
        "production_storage_performed": { "const": false },
        "yfinance_consumption_performed": { "const": false },
        "paid_access_performed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "ship_gate_or_live_normalized_evidence_claimed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "decision_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_decision_date", "candidate_price_basis_date", "price_basis_date", "source_as_of"],
      "properties": {
        "expected_decision_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "candidate_price_basis_date": { "type": "string", "pattern": "^[0-9]{8}$" },
        "price_basis_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "fetch_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions_requested",
        "sessions_with_data",
        "grouped_calls_made",
        "rate_limit_retries",
        "duplicate_ticker_rows_collapsed",
        "session_window_target",
        "min_sessions_required"
      ],
      "properties": {
        "sessions_requested": { "type": "integer", "minimum": 0 },
        "sessions_with_data": { "type": "integer", "minimum": 0 },
        "grouped_calls_made": { "type": "integer", "minimum": 0 },
        "rate_limit_retries": { "type": "integer", "minimum": 0 },
        "duplicate_ticker_rows_collapsed": { "type": "integer", "minimum": 0 },
        "session_window_target": { "type": "integer", "minimum": 1 },
        "min_sessions_required": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_count",
        "benchmark_symbols",
        "benchmarks_present",
        "series_ticker_count",
        "grouped_session_count",
        "points_per_series_min",
        "points_per_series_median",
        "points_per_series_max"
      ],
      "properties": {
        "eligible_count": { "type": "integer", "minimum": 0 },
        "benchmark_symbols": { "const": ["SPY", "QQQ"] },
        "benchmarks_present": { "type": "boolean" },
        "series_ticker_count": { "type": "integer", "minimum": 0 },
        "grouped_session_count": { "type": "integer", "minimum": 0 },
        "points_per_series_min": { "type": "integer", "minimum": 0 },
        "points_per_series_median": { "type": "integer", "minimum": 0 },
        "points_per_series_max": { "type": "integer", "minimum": 0 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_artifact_path", "series_packet_path", "summary_path"],
      "properties": {
        "candidate_artifact_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "series_packet_path": { "type": "string", "pattern": "^state/us_short/.+\\.json$" },
        "summary_path": {
          "type": "string",
          "pattern": "^(docs/us_short_batch5_full_universe_momentum_fetch_summary_[0-9]{8}\\.json|provider_samples/us_short_batch5_full_universe_momentum_fetch/.+\\.json)$",
          "not": { "pattern": "\\.\\." }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_packet_path_gitignored",
        "raw_grouped_window_persisted",
        "summary_contains_ticker_lists",
        "summary_contains_price_rows",
        "summary_contains_request_urls",
        "summary_contains_secrets"
      ],
      "properties": {
        "series_packet_path_gitignored": { "const": true },
        "raw_grouped_window_persisted": { "const": false },
        "summary_contains_ticker_lists": { "const": false },
        "summary_contains_price_rows": { "const": false },
        "summary_contains_request_urls": { "const": false },
        "summary_contains_secrets": { "const": false }
      }
    },
    "prohibited_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_selected",
        "full_market_raw_download_persisted",
        "yfinance_used",
        "paid_access_used",
        "datahub_consumed",
        "production_readiness_claimed",
        "ship_gate_evidence_claimed",
        "live_normalized_evidence_claimed",
        "corporate_action_reconciliation_performed",
        "broker_or_order_execution_performed",
        "a_share_crossing_performed"
      ],
      "properties": {
        "provider_selected": { "const": false },
        "full_market_raw_download_persisted": { "const": false },
        "yfinance_used": { "const": false },
        "paid_access_used": { "const": false },
        "datahub_consumed": { "const": false },
        "production_readiness_claimed": { "const": false },
        "ship_gate_evidence_claimed": { "const": false },
        "live_normalized_evidence_claimed": { "const": false },
        "corporate_action_reconciliation_performed": { "const": false },
        "broker_or_order_execution_performed": { "const": false },
        "a_share_crossing_performed": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
