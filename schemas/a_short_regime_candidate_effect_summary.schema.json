{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_regime_candidate_effect_summary",
  "description": "P1 V14.3 per-stock candidate-effect aggregate. It is comparison-only evidence: the baseline is the current build without regime-driven candidate action; defense/contraction cash 0% is a simplified proxy, not a final production defense policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "latest_evidence_as_of", "policy", "admission", "evidence_progress", "data_quality", "operation_effect", "selection_accuracy", "verdict", "boundary"],
  "properties": {
    "schema_name": {"const": "a_short_regime_candidate_effect_summary"},
    "schema_version": {"const": "1.1.0"},
    "latest_evidence_as_of": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_epoch", "policy_fingerprint", "h20_mature_weeks_min", "baseline_description", "candidate_proxy_description"],
      "properties": {
        "policy_id": {"const": "v14_3_candidate_effect_proxy_v1"},
        "policy_epoch": {"const": "20260719_p1_cut1_v1"},
        "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "h20_mature_weeks_min": {"const": 8},
        "baseline_description": {"const": "current production build without regime-driven candidate action"},
        "candidate_proxy_description": {"const": "comparison-only simplified proxy: defense and contraction forbid a new build and use cash return 0%; this is not a final production V14.3 defense policy"}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["p1_regime_action_proxy"],
      "properties": {
        "p1_regime_action_proxy": {"$ref": "#/definitions/admission_snapshot"}
      }
    },
    "evidence_progress": {
      "type": "object", "additionalProperties": false,
      "required": ["forward_live_weeks", "valid_divergence_weeks", "valid_divergence_stocks", "h20_mature_weeks", "h20_pending_weeks", "historical_not_counted", "immature_or_missing_not_counted", "ready_for_verdict"],
      "properties": {
        "forward_live_weeks": {"type": "integer", "minimum": 0},
        "valid_divergence_weeks": {"type": "integer", "minimum": 0, "description": "Divergent weeks counted into every reported statistic. Since 1.1.0 that is the closed H20-mature cohort, so this is ALWAYS equal to h20_mature_weeks; it is NOT an H10-only count."},
        "valid_divergence_stocks": {"type": "integer", "minimum": 0},
        "h20_mature_weeks": {"type": "integer", "minimum": 0, "description": "The same closed cohort as valid_divergence_weeks, exposed separately so 'how many weeks are still pending' reads next to h20_pending_weeks. policy.h20_mature_weeks_min therefore only binds once it is raised above divergence_weeks_min."},
        "h20_pending_weeks": {"type": "integer", "minimum": 0},
        "historical_not_counted": {"type": "integer", "minimum": 0},
        "immature_or_missing_not_counted": {"type": "integer", "minimum": 0},
        "ready_for_verdict": {"type": "boolean"}
      }
    },
    "data_quality": {"type": "object", "additionalProperties": false, "required": ["policy_groups", "same_week_equal_weighting"], "properties": {"policy_groups": {"type": "integer", "minimum": 0}, "same_week_equal_weighting": {"const": true}}},
    "operation_effect": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_horizon_days", "weekly_mean_improvement_pp", "weekly_median_improvement_pp", "favorable_week_ratio", "auxiliary_h20_mean_improvement_pp"],
      "properties": {
        "primary_horizon_days": {"const": 10},
        "weekly_mean_improvement_pp": {"type": ["number", "null"]},
        "weekly_median_improvement_pp": {"type": ["number", "null"]},
        "favorable_week_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "auxiliary_h20_mean_improvement_pp": {"type": ["number", "null"]}
      }
    },
    "selection_accuracy": {"type": "object", "additionalProperties": false, "required": ["forbidden_stock_count", "forbidden_stock_underperformed_csi1000_count", "status"], "properties": {"forbidden_stock_count": {"type": "integer", "minimum": 0}, "forbidden_stock_underperformed_csi1000_count": {"type": "integer", "minimum": 0}, "status": {"enum": ["not_evaluable", "supportive", "not_supportive", "mixed"]}}},
    "verdict": {"enum": ["candidate_better", "baseline_better", "no_material_difference", "insufficient_data"]},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["comparison_only", "automatic_production_switch"], "properties": {"comparison_only": {"const": true}, "automatic_production_switch": {"const": false}}}
  },
  "definitions": {
    "admission_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_id", "component_id", "track_mode", "identity_sha256", "statistical_contract_sha256", "pit_forward_contract_sha256", "dependency_components"],
      "properties": {
        "experiment_id": {"const": "a_short_p1_regime_action_proxy"},
        "component_id": {"const": "regime_action_proxy_policy"},
        "track_mode": {"const": "diagnostic_only"},
        "identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "statistical_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pit_forward_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dependency_components": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["component_id", "baseline_definition_sha256"],
            "properties": {
              "component_id": {"type": "string", "minLength": 1},
              "baseline_definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }}
        }
      }
    }
  }
}
