{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "a_short_theme_overlay_comparison",
  "description": "A-short 赛道热度 overlay comparison-track artifact (Slice A). Non-production, comparison-track. Frozen design values (weights/thresholds/boundary/track) are const-pinned so post-review drift cannot validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "generated_at", "as_of", "preset", "track",
    "weights", "thresholds", "pit_source", "candidate_count", "candidates",
    "dropped_at_l0_l5", "boundary"
  ],
  "properties": {
    "schema_name": {"const": "a_short_theme_overlay_comparison"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
    "preset": {"const": "a_short"},
    "track": {"const": "comparison_non_production"},
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["esp", "l4", "theme", "industry"],
      "properties": {
        "esp": {"const": 0.15},
        "l4": {"const": 0.45},
        "theme": {"const": 0.25},
        "industry": {"const": 0.15}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_window_blend", "pass_percentile", "breadth_up_frac_min", "breadth_vol_frac_min",
        "persistence_top_quantile", "persistence_window_days", "fit_floor",
        "eligibility_min_pass"
      ],
      "properties": {
        "theme_window_blend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["d5", "d20"],
          "properties": {"d5": {"const": 0.5}, "d20": {"const": 0.5}}
        },
        "pass_percentile": {"const": 70.0},
        "breadth_up_frac_min": {"const": 0.5},
        "breadth_vol_frac_min": {"const": 0.4},
        "persistence_top_quantile": {"const": 0.3},
        "persistence_window_days": {"const": 5},
        "fit_floor": {"const": 0.4},
        "eligibility_min_pass": {"const": 2}
      }
    },
    "pit_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_membership", "sw_mapping"],
      "properties": {
        "concept_membership": {"enum": ["pit", "forward", "unavailable"]},
        "sw_mapping": {"enum": ["pit", "forward", "unavailable"]}
      }
    },
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ts_code", "baseline_rank", "overlay_rank", "overlay_score",
          "esp_score", "l4_score", "theme_heat_score", "industry_heat_score",
          "industry_heat_norm_ortho", "breadth_pass", "persistence_mult",
          "fit_score", "fit_unknown", "fit_pass", "theme_pass", "industry_pass",
          "theme_eff", "eligible", "crowding_hit"
        ],
        "properties": {
          "ts_code": {"type": "string"},
          "baseline_rank": {"type": ["integer", "null"]},
          "overlay_rank": {"type": ["integer", "null"]},
          "overlay_score": {"type": ["number", "null"]},
          "esp_score": {"type": ["number", "null"]},
          "l4_score": {"type": ["number", "null"]},
          "theme_heat_score": {"type": ["number", "null"]},
          "industry_heat_score": {"type": ["number", "null"]},
          "industry_heat_norm_ortho": {"type": ["number", "null"], "minimum": 0.0, "maximum": 100.0},
          "breadth_pass": {"type": "boolean"},
          "persistence_mult": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
          "fit_score": {"type": ["number", "null"]},
          "fit_unknown": {"type": "boolean"},
          "fit_pass": {"type": "boolean"},
          "theme_pass": {"type": "boolean"},
          "industry_pass": {"type": "boolean"},
          "theme_eff": {"type": ["number", "null"]},
          "eligible": {"type": "boolean"},
          "crowding_hit": {"type": "boolean"},
          "theme_taxonomy": {"$ref": "#/$defs/themeTaxonomy"}
        }
      }
    },
    "dropped_at_l0_l5": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts_code", "theme_heat_score", "drop_stage"],
        "properties": {
          "ts_code": {"type": "string"},
          "theme_heat_score": {"type": ["number", "null"]},
          "drop_stage": {"type": "string"}
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "changes_final_score_or_tier", "is_buy_advice", "satisfies_ship_gate"],
      "properties": {
        "production": {"const": false},
        "changes_final_score_or_tier": {"const": false},
        "is_buy_advice": {"const": false},
        "satisfies_ship_gate": {"const": false},
        "production_effect_enabled": {"const": false},
        "automatic_promotion": {"const": false}
      }
    }
  },
  "$defs": {
    "rawConcept": {
      "type": "object", "additionalProperties": false,
      "required": ["concept_id", "concept_name", "source_id", "source_as_of", "source_snapshot_date", "coverage_digest", "membership_source"],
      "properties": {
        "concept_id": {"type": "string"}, "concept_name": {"type": "string"}, "source_id": {"type": "string"},
        "source_as_of": {"type": "string", "pattern": "^[0-9]{8}$"}, "source_snapshot_date": {"type": "string", "pattern": "^[0-9]{8}$"},
        "coverage_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "membership_source": {"enum": ["hithink_complete_concept_members", "legacy_snapshot_concept_members"]}
      }
    },
    "canonicalTheme": {
      "type": "object", "additionalProperties": false,
      "required": ["theme_id", "name_cn", "name_en", "status", "matched_raw_concepts", "matched_subthemes", "role", "role_confidence", "classification_basis", "business_evidence", "coverage_status", "unknown_reason", "production_effect_enabled", "automatic_promotion"],
      "properties": {
        "theme_id": {"type": "string"}, "name_cn": {"type": "string"}, "name_en": {"type": "string"},
        "status": {"enum": ["comparison_only", "approved", "retired"]}, "matched_raw_concepts": {"type": "array", "items": {"$ref": "#/$defs/rawConcept"}},
        "matched_subthemes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["subtheme_id", "name", "matched_raw_concept_ids"], "properties": {"subtheme_id": {"type": "string"}, "name": {"type": "string"}, "matched_raw_concept_ids": {"type": "array", "items": {"type": "string"}}}}},
        "role": {"enum": ["core", "key_supplier", "adjacent", "weak_link", "unknown"]}, "role_confidence": {"enum": ["high", "medium", "unknown"]},
        "classification_basis": {"enum": ["registry_membership_and_structured_business_evidence", "registry_membership_proxy_only"]}, "business_evidence": {"type": "array", "items": {"type": "object"}},
        "coverage_status": {"enum": ["checked", "unknown_or_unavailable"]}, "unknown_reason": {"type": ["string", "null"]},
        "production_effect_enabled": {"const": false}, "automatic_promotion": {"const": false}
      }
    },
    "themeTaxonomy": {
      "type": "object", "additionalProperties": false,
      "required": ["taxonomy_schema_name", "taxonomy_schema_version", "taxonomy_configuration_fingerprint", "source_as_of", "l3_provenance", "raw_concepts", "canonical_themes", "primary_canonical_theme_id", "production_effect_enabled", "automatic_promotion"],
      "properties": {
        "taxonomy_schema_name": {"const": "a_short_theme_taxonomy"}, "taxonomy_schema_version": {"const": "1.2.0"},
        "taxonomy_configuration_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_as_of": {"type": "string", "pattern": "^[0-9]{8}$"},
        "l3_provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "snapshot_date", "coverage_digest", "coverage_complete", "scoring_universe", "raw_membership_source", "validation_status"],
          "properties": {
            "provider": {"enum": ["hithink_finance", "legacy_tushare_snapshot", "neutralized", null]},
            "snapshot_date": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
            "coverage_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "coverage_complete": {"type": ["boolean", "null"]},
            "scoring_universe": {"type": ["string", "null"]},
            "raw_membership_source": {"enum": ["hithink_complete_concept_members", "legacy_snapshot_concept_members", "unavailable"]},
            "validation_status": {"enum": ["verified_complete", "legacy_snapshot", "unavailable"]}
          }
        },
        "raw_concepts": {"type": "array", "items": {"$ref": "#/$defs/rawConcept"}}, "canonical_themes": {"type": "array", "items": {"$ref": "#/$defs/canonicalTheme"}},
        "primary_canonical_theme_id": {"type": ["string", "null"]}, "production_effect_enabled": {"const": false}, "automatic_promotion": {"const": false},
        "comparison_status": {"const": "unknown_or_unavailable"}, "unavailable_reason": {"type": "string"},
        "comparison_metrics": {"$ref": "#/$defs/comparisonMetrics"}
      }
    },
    "comparisonMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["theme_heat_score", "breadth_pass", "persistence_mult", "fit_score", "fit_pass", "comparison_status"],
      "properties": {
        "theme_heat_score": {"type": ["number", "null"]}, "breadth_pass": {"type": "boolean"},
        "persistence_mult": {"type": ["number", "null"]}, "fit_score": {"type": ["number", "null"]},
        "fit_pass": {"type": "boolean"}, "comparison_status": {"const": "available"}
      }
    }
  }
}
